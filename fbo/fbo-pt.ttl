fbo-pt:EscapeRoute a owl:DatatypeProperty ;
    rdfs:label "Internal escape route"@en,
        "Via de evacuação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 14 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Horizontal or vertical communication within a building which, under the terms of this regulation, provides safe conditions for the evacuation of its occupants. Horizontal evacuation routes may be corridors, antechambers, atriums, galleries or, in large spaces, walkways explicitly marked on the floor for this purpose, which comply with the conditions of this regulation. Vertical evacuation routes may be stairs, ramps, or inclined stairs and escalators, which comply with the conditions of this regulation. Evacuation routes may be protected or unprotected. Protected evacuation routes may be enclosed (interior) or exterior. Unprotected evacuation routes are those that do not fully or partially meet the regulatory conditions for protected routes, although they may be authorised under the conditions set out in this regulation."@en,
        "Comunicação horizontal ou vertical de um edifício que, nos temos do presente regulamento, apresenta condições de segurança para a evacuação dos seus ocupantes. As vias de evacuação horizontais podem ser corredores, antecâmaras, átrios, galerias ou, em espaços amplos, passadeiras explicitamente marcadas no pavimento para esse efeito, que respeitem as condições do presente regulamento. As vias de evacuação verticais podem ser escadas, rampas, ou escadas e tapetes rolantes inclinados, que respeitem as condições do presente regulamento. As vias de evacuação podem ser protegidas ou não. As vias de evacuação protegidas podem ser enclausuradas (interiores) ou exteriores. As vias de evacuação não protegidas são as que não garantem, total ou parcialmente, as condições regulamentares das vias protegidas, embora possam ser autorizadas nas condições expressas neste regulamento"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:EscapeRoute ;
    fbo:hasLastEdition "2026-05-08T09:24:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "354" ;
    fbo:hasNotionURL <https://www.notion.so/EscapeRoute-24ef8487e6e780728589ebfde86e80ed> .

fbo-pt:Evacuation a owl:Class ;
    rdfs:label "Evacuation"@en,
        "Evacuação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 6 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Movement of occupants from a building to a safe area in the event of a fire or other accident, which must be orderly, timely and safe."@en,
        "Movimento de ocupantes de um edifício para uma zona de segurança, em caso de incêndio ou de outros acidentes, que deve ser disciplinado, atempado e seguro"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:24:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "350" ;
    fbo:hasNotionURL <https://www.notion.so/Evacuation-24ef8487e6e78043be31c288c7063075> .

fbo-pt:EvacuationPath a owl:Class ;
    rdfs:label "Evacuation Path"@en,
        "Caminho de evacuação ou caminho de fuga"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 2 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Route between any point susceptible to occupation within an enclosure or building and an external safety zone, generally comprising an initial route within the place of stay and another along the evacuation routes."@en,
        "Percurso entre qualquer ponto, suscetível de ocupação, num recinto ou num edifício até uma zona de segurança exterior, compreendendo, em geral, um percurso inicial no local de permanência e outro nas vias de evacuação"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:24:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "362" ;
    fbo:hasNotionURL <https://www.notion.so/EvacuationPath-24ef8487e6e780eda8f2f56efce0d8f1> .

fbo-pt:EvacuationRoute a owl:Class ;
    rdfs:label "EvacuationRoute"@en,
        "Caminho de evacuação ou caminho de fuga horizontal"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "n.º 2 do art.º 4º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Route between any point, susceptible to occupation, in an enclosure or building to an external safety zone, generally comprising an initial route at the place of stay and another on the evacuation routes."@en,
        "Percurso entre qualquer ponto, suscetível de ocupação, num recinto ou num edifício até uma zona de segurança exterior, compreendendo, em geral, um percurso inicial no local de permanência e outro nas vias de evacuação."@pt-PT ;
