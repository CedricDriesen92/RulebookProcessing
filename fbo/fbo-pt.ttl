fbo-pt:AdjacentStoreysArea a owl:DatatypeProperty ;
    rdfs:label "Adjacent Storeys Area"@en,
        "Área do piso adjacente"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "The sum of the floor areas of the floors immediately adjacent to the floor in question, located above and/or below it, within the same building."@en,
        "Soma das áreas de construção dos pisos imediatamente contíguos ao piso considerado, situados acima e/ou abaixo deste, no mesmo edifício."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:27:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "613" ;
    fbo:hasNotionURL <https://www.notion.so/AdjacentStoreysArea-355f8487e6e7800c9695d03b207bc124> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-pt:AggregateRoomType a owl:ObjectProperty ;
    rdfs:label "Aggregate Room"@en,
        "Agregação de locais"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Conjunto de locais com a mesma classificação (A, D ou E) possuindo circulações exclusivas"@en,
        "Group of rooms with the same classification (type A, D or E) with exclusive circulation."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:18:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "495" ;
    fbo:hasNotionURL <https://www.notion.so/AggregateRoomType-2abf8487e6e7803282f8e6722bf6dccf> .

fbo-pt:AreaCompartmentCompliance a owl:ObjectProperty ;
    rdfs:label "AreaCompartmentCompliance"@en,
        "Conformidade da área de compartimentação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "The compliance of the compartmentalization area is verified when the area of each fire compartment of the building does not exceed the maximum values established in the regulation according to the type of use, risk category, and characteristics of the building."@en,
        "A conformidade da área de compartimentação verifica-se quando a área de cada compartimento corta-fogo do edifício não excede os valores máximos estabelecidos no regulamento em função da utilização-tipo, categoria de risco e características do edifício."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "554" ;
    fbo:hasNotionURL <https://www.notion.so/AreaCompartmentCompliance-302f8487e6e7801b9431c61a309a7c9a> .

fbo-pt:AreaCompartmentException a owl:ObjectProperty ;
    rdfs:label "Area Compartmentation Exception"@en,
        "Área de compartimentação - excepção"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "The exception to the compartmentation area allows, under certain specific conditions set out in the regulation, buildings to have fire compartmentation areas exceeding the maximum limits established, in specific cases or through the adoption of additional safety measures."@en,
        "A exceção à área de compartimentação permite que, em determinadas condições específicas previstas no regulamento, os edifícios possam ter áreas de compartimentação corta-fogo superiores aos limites máximos estabelecidos, em casos específicos ou mediante a adoção de medidas suplementares de segurança."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "553" ;
    fbo:hasNotionURL <https://www.notion.so/AreaCompartmentException-302f8487e6e780729d1eda12acb58255> .

fbo-pt:AreaFireCompartment a owl:DatatypeProperty ;
    rdfs:label "Area of a fire compartment"@en,
        "Área do compartimento corta-fogo"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    rdfs:subPropertyOf fbo:AreaFireCompartment ;
    fbo:hasAdoptedDefinitionType "Expert Definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire sector" ;
    fbo:hasExpertDefinition "Total gross surface area of a given fire compartment, delimited by the outer perimeter of the exterior walls and the axes of the interior walls separating that fire sector from the others"@en,
        "Superfície bruta total de um dado compartimento de fogo, delimitada pelo perímetro exterior das paredes exteriores e eixos das paredes interiores separadoras desse sector de fogo, relativamente aos restantes"@pt-PT ;
    fbo:hasFireExpertEntity "Fire Expert" ;
    fbo:hasFireExpertGuidance "Definition omitted from Portuguese regulations, so a measurement criterion is presented" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:AreaFireCompartment2a ;
    fbo:hasLastEdition "2026-02-26T10:41:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "67" ;
    fbo:hasNotionURL <https://www.notion.so/AreaFireCompartment-151f8487e6e7800881fafc9ba05ffb66> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-pt:AreaMaximumCompartment a owl:ObjectProperty ;
    rdfs:label "Área Máxima de Compartimento Corta-Fogo"@en,
        "Área Máxima de Compartimento Corta-Fogo"@pt-PT ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
