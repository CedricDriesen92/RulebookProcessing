fbo-pt:SafeZone a owl:DatatypeProperty ;
    rdfs:label "Safe Zone"@en,
        "Zona de segurança"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 19 do art.º 4º do Anexo I do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Assembly point located outside the building, where occupants can safely gather, protected from the direct effects of a fire within the building."@en,
