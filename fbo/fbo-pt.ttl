fbo-pt:CommonArea a owl:ObjectProperty ;
    rdfs:label "CommonArea"@en,
        "Área comum"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "It is a space in a building for collective use, intended for circulation and shared use by the occupants of different independent units, such as corridors, staircases, lobbies, and accesses, not assigned for the exclusive use of any particular unit."@en,
        "É um espaço de um edifício de utilização coletiva destinado à circulação e uso partilhado pelos ocupantes de diferentes frações autónomas, como corredores, escadas, átrios e acessos, não afeto a utilização exclusiva de nenhuma fração em particular."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:FunctionSpace ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "555" ;
    fbo:hasNotionURL <https://www.notion.so/CommonArea-302f8487e6e780c5b6f4c2db6062f47a> .

fbo-pt:CommonCirculationSpaces a owl:Class ;
    rdfs:label "Common circulation spaces (in a building)"@en,
        "Circulações comuns (de um edifício)"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Conjunto de espaços destinados ao movimento de pessoas que são partilhados por todos os utilizadores do edifício, independentemente do piso ou da unidade (fogo, loja, escritório, etc.)."@en,
        "Set of spaces intended for the movement of people that are shared by all users of the building, regardless of the floor or unit (fire, shop, office, etc.)."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:20:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "498" ;
    fbo:hasNotionURL <https://www.notion.so/CommonCirculationSpaces-2aef8487e6e78026ac4ae404243b1a28> .

fbo-pt:Compartment a owl:Class ;
    rdfs:label "Compartment"@en,
        "Compartimento"@pt-PT ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Each of the enclosed interior spaces within a building, defined by walls, a floor, and a ceiling, with a specific intended use."@en,
