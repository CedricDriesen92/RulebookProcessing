    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "Choice" .

fbo-pt:OccupancyTypeXII a owl:DatatypeProperty ;
    rdfs:label "OccupancyType XII- Industrial Facility, Workshops and Warehouses"@en,
        "Utilização-Tipo XII - Industriais, oficinas e armazéns"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    rdfs:subPropertyOf fbo-pt:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
