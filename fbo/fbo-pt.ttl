fbo-pt:EvacuationTime a owl:DatatypeProperty ;
    rdfs:label "Evacuation time"@en,
        "Tempo de evacuação"@pt-PT ;
    rdfs:subPropertyOf fbo:EvacuationTime ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
