fbo-pt:BuildingInformation a owl:ObjectProperty ;
    rdfs:label "Building Information"@en,
        "Informação do edifício"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "É o conjunto de dados alfanuméricos e geométricos associados aos elementos do edifício, incluindo propriedades técnicas, características físicas, especificações de materiais e informações de desempenho que o descrevem ao longo do seu ciclo de vida."@pt-PT ;
    fbo:hasFireExpertEntity "It is the set of alphanumeric and geometric data associated with building elements, including technical properties, physical characteristics, material specifications, and performance information that describes it throughout its life cycle." ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "552" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingInformation-302f8487e6e780ce9960d178c27d6b9f> .

fbo-pt:BuildingStorey a owl:Class ;
    rdfs:label "BuildingStorey"@en,
        "Piso de um edifício"@pt-PT ;
    rdfs:subClassOf fbo:BuildingStorey ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "A floor of a building corresponds to a horizontal level of the building, defined and limited by slabs or floor elements, located above or below ground level, and may include, in particular, spaces for use, circulation areas, and/or technical installations."@en,
        "Piso de um edifício corresponde a um nível horizontal do mesmo, definido e limitado por lajes ou elementos de pavimento, situado acima ou abaixo do solo, podendo integrar designadamente espaços de utilização, circulações e / ou instalações técnicas."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:BuildingStorey ;
    fbo:hasLastEdition "2026-02-23T14:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "558" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingStorey-302f8487e6e780afba00d8408a061af7> .

fbo-pt:BuildingUsers a owl:ObjectProperty ;
    rdfs:label "Building Users"@en,
        "Utilizadores de um determinado espaço (condição física, condição cognitiva, idade, …)"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasExpertDefinition "Condition of occupants of a given room who may be bedridden, limited in mobility or in their ability to perceive and react to an alarm, or who are under 3 years of age."@en,
        "Condição dos ocupantes de um determinado local que podem estar acamados, limitados na mobilidade ou nas capacidades de perceção e reação a um alarme ou possuir idade não superior a 3 anos."@pt-PT ;
    fbo:hasFireExpertEntity "Fire Expert" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:BuildingUsers ;
    fbo:hasLastEdition "2026-05-08T09:19:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "427" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingUsers-268f8487e6e780f9aecce3ba9f56db1d> .

fbo-pt:CoexistenceOccupancyType a owl:ObjectProperty ;
    rdfs:label "Coexistence Occupancy Type"@en,
        "Coexistência de utilizações-tipo"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Existência num mesmo edifício de espaços ocupados por diferentes utilizações-tipo"@en,
        "Existence in the same building of spaces occupied by different types of occupancy"@pt-PT ;
    fbo:hasFireExpertGuidance "Coexistence between different occupancy types occurs when, in the same building or enclosure, there are spaces assigned to different types of use, each subject to its own specific fire safety requirements." ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:OccupancyTypeBuilding,
        fbo-ifc:OccupancyTypeCompartment ;
    fbo:hasLastEdition "2026-05-08T09:19:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "496" ;
