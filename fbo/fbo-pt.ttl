fbo-pt:ExternalEvacuationRoute a owl:Class ;
    rdfs:label "External evacuation route"@en,
        "Via de evacuação exterior"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 16 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Protected evacuation route, outdoors or wide and permanently ventilated, which is sufficiently separated from the rest of the building or neighbouring buildings, either by distance or by construction elements whose standard fire resistance complies with the provisions of this regulation. This route may be entirely outside a building or partially embedded in it, in which case it must have an opening along the construction elements in contact with the outside, covering the entire space above the respective guardrail."@en,
        "Via de evacuação protegida, ao ar livre ou ampla e permanentemente ventilada, que está suficientemente separada do resto do edifício ou de edifícios vizinhos, quer em afastamento quer por elementos de construção cuja resistência ao fogo padrão está de acordo com o explicitado no presente regulamento. Esta via pode estar totalmente no exterior de um edifício ou nele parcialmente encastrada, devendo, neste caso, dispor de uma abertura, ao longo dos elementos de construção em contacto com o exterior, abrangendo todo o espaço acima da respetiva guarda"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:24:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "358" ;
    fbo:hasNotionURL <https://www.notion.so/ExternalEvacuationRoute-24ef8487e6e7809fafb9ea1ae9ff6b7e> .

fbo-pt:FireDamper a owl:DatatypeProperty ;
    rdfs:label "Fire damper"@en,
        "Registo resistente ao fogo"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID """n.º 11 do art.º 3º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Automatically operated damper with a given fire resistance rating determined by a standardized fire resistance test, intended to prevent the spread of fire or its effects through a duct or opening for a certain period of time."@en,
        "Registo de accionamento automático com uma dada qualificação de resistência ao fogo determinada em ensaio normalizado de resistência ao fogo padrão, destinado a impedir a propagação de um incêndio ou dos seus efeitos através de uma conduta ou de uma abertura, durante um certo período de tempo"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "92" ;
    fbo:hasNotionURL <https://www.notion.so/FireDamper-151f8487e6e7803f96b7d87e9ace33fa> ;
    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "Choice" .

