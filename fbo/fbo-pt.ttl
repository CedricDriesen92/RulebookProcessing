fbo-pt:FireLoad a owl:DatatypeProperty ;
    rdfs:label "Fire load"@en,
        "Carga de incêndio"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    rdfs:subPropertyOf fbo:FireLoad ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.3.8" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The sum of the thermal energy released by the combustion of all combustible materials in a space (the building's contents and construction elements)."@en,
        "Soma da energia térmica libertada pela combustão de todos os materiais combustíveis existentes num espaço (o recheio do edifício e os elementos de construção)."@pt-PT ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "108" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoad-151f8487e6e7806ca29bd829af4a508a> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit "MJ" .

fbo-pt:FireLoadDensity a owl:DatatypeProperty ;
    rdfs:label "Fire load density"@en,
        "Densidade de carga de incêndio"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    rdfs:subPropertyOf fbo:FireLoadDensity ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.3.7" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Fire load per unit area of the floor surface (qf) or per unit area of the total envelope surface, including openings (qt)."@en,
        "Carga de incêndio por unidade de área da superfície do pavimento (qf), ou por unidade de área da superfície da envolvente total, incluindo as aberturas (qt)."@pt-PT ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "107" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoadDensity-151f8487e6e7806bbe83fac021aaea37> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit "MJ/m^2" .

fbo-pt:FireLoadDensityModified a owl:DatatypeProperty ;
    rdfs:label "Modified fire load density"@en,
        "Densidade da carga de incêndio modificada"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    rdfs:subPropertyOf fbo:FireLoadDensity ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Art. 2(h) do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The fire load density affected by coefficients relating to the degree of danger and the fuel activation index, determined on the basis of the criteria referred to in Article 12(4);"@en,
        "A densidade da carga de incêndio é afetada por coeficientes relativos ao grau de perigo e ao índice de ativação do combustível, determinados com base nos critérios referidos no nº 4 do artigo 12º;"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegimeJurdicodaSeguranaContraIncndioemEdifcios,
        fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "88" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoadDensityModified-151f8487e6e78037b8c7d97957453adc> ;
    fbo:hasRemarks "In Portugal, the fire load density is corrected by an activation risk and a combustibility coefficient and is called the modified load density." ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit "MJ/m^2" .

fbo-pt:FireResistance a owl:DatatypeProperty ;
    rdfs:label "Fire Resistance"@en,
        "Resistência ao fogo"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    rdfs:subPropertyOf fbo:FireResistance ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.4" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a structure, part of a structure or element to perform its intended functions (load-bearing function and/or compartmentalisation function) for a specific load level, when subjected to a specific fire situation and for a specified period of time."@en,
        "Capacidade de uma estrutura, de parte de uma estrutura ou de um elemento para desempenhar as funções pretendidas (função de suporte de cargas e/ou função de compartimentação) para um nível de carga específico, quando sujeita a uma situação de incêndio específica e durante um período de tempo especificado."@pt-PT ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:FireResistance ;
    fbo:hasLastEdition "2026-02-10T08:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "155" ;
    fbo:hasNotionURL <https://www.notion.so/FireResistance-151f8487e6e780dda0ecd4dd12ae95c8> ;
    fbo:hasRemarks "“3. GENERIC DEFINITION - WE ADD IT BECAUSE ITS A GENERIC DEFINITION AND ITS NOT RELATED DIRECTLY WITH THE BUILDING - NEED TO BE DISCUSTED" ;
    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "Choice" .

fbo-pt:FireResistanceStandard a owl:DatatypeProperty ;
    rdfs:label "Standard fire resistance"@en,
        "Resistência ao fogo padrão"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.16" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a structure or part of a structure (usually just the elements) to fulfil its intended functions (structural resistance function and/or compartmentation function) in relation to heat exposure, according to the standard fire curve for a specified combination of actions and over a specified period of time."@en,
        "Capacidade de uma estrutura ou de parte de uma estrutura (normalmente apenas os elementos) para desempenhar as funções pretendidas (função de resistência estrutural e/ou função de compartimentação) relativamente à exposição ao calor, de acordo com a curva de incêndio padrão para uma combinação de acções especificada e durante um período de tempo específico."@pt-PT ;
    fbo:hasFireExpertEntity "European standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "70" ;
    fbo:hasNotionURL <https://www.notion.so/FireResistanceStandard-151f8487e6e780138a5ac6a9e0020080> ;
    fbo:hasRemarks "“3. GENERIC DEFINITION - WE ADD IT BECAUSE ITS A GENERIC DEFINITION AND ITS NOT RELATED DIRECTLY WITH THE BUILDING - NEED TO BE DISCUSTED" ;
    qudt:hasApplicableUnit "-" .

fbo-pt:FireScenario a owl:DatatypeProperty ;
    rdfs:label "Fire scenario"@en,
        "Cenário de incêndio"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.3.9" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Qualitative description of the evolution of a fire over time, identifying the main events that characterise the fire and differentiate it from other possible fires. It typically defines the ignition and growth process of the fire, the fully developed fire phase, the cooling phase, as well as the ambient conditions and building systems that will have an impact on the evolution of the fire."@en,
        "Descrição qualitativa da evolução de um incêndio com o tempo, identificando os principais acontecimentos que caracterizam o incêndio e o diferenciam de outros incêndios possíveis. Define, tipicamente, a ignição e o processo de crescimento do incêndio, a fase do incêndio totalmente desenvolvido, a fase de arrefecimento, assim como as condições ambientes e os sistemas do edifício que terão impacto na evolução do incêndio."@pt-PT ;
    fbo:hasFireExpertEntity "European standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "78" ;
    fbo:hasNotionURL <https://www.notion.so/FireScenario-151f8487e6e78027b0e5d10a364e3629> ;
    fbo:hasRemarks "“3. GENERIC DEFINITION - WE ADD IT BECAUSE ITS A GENERIC DEFINITION AND ITS NOT RELATED DIRECTLY WITH THE BUILDING - NEED TO BE DISCUSTED" ;
    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "Choice" .

fbo-pt:FireStability a owl:DatatypeProperty ;
    rdfs:label "Fire Stability"@en,
        "Estabilidade ao fogo"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    rdfs:subPropertyOf fbo:FireStability ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.10" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Capacidade de uma estrutura ou de um elemento para resistir a acções específicas durante o incêndio relevante, de acordo com um critério definido."@pt-PT ;
    fbo:hasDesignator "R" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "146" ;
    fbo:hasNotionURL <https://www.notion.so/FireStability-151f8487e6e780c2813ad1929fdb8ea4> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit "Minutes" .

fbo-pt:FireTightness a owl:DatatypeProperty ;
    rdfs:label "Fire tightness > Integrity"@en,
        "Estanquidade ao fogo"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.8" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a separating element of building construction, when exposed to fire on one side, to prevent the passage through it of flames and hot gases and to prevent the occurrence of flames on the unexposed side"@en,
        "Capacidade de um elemento de compartimentação de um edifício, quando exposto ao fogo de um lado, para impedir a passagem de chamas e de gases quentes através de si e para impedir a ocorrência de chamas no lado não exposto."@pt-PT ;
    fbo:hasDesignator "E" ;
    fbo:hasEquivalentTerm "Integrity" ;
    fbo:hasFireExpertEntity "European standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:21:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "98" ;
    fbo:hasNotionURL <https://www.notion.so/FireTightness-151f8487e6e7804cbd3ecce8684626ee> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit "Minutes" .

fbo-pt:FloorSpaceFactor a owl:ObjectProperty ;
    rdfs:label "Floor Space Factor"@en,
        "Índice de Ocupação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Implicit definition" ;
    fbo:hasArticleID "n.º 1 do art.º 51º do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Number of occupants per unit area depending on the use of the spaces"@en,
        "Número de ocupantes por unidade de área em função do uso dos espaços."@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:25:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "429" ;
    fbo:hasNotionURL <https://www.notion.so/FloorSpaceFactor-269f8487e6e780619bf1d56d38af3662> .

fbo-pt:FunctionCompartmentation a owl:DatatypeProperty ;
    rdfs:label "Compartmentation function"@en,
        "Função de compartimentação"@pt-PT ;
    schema1:rangeIncludes xsd:boolean ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.14" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a partitioning element to prevent the spread of fire (for example, by the passage of flames or hot gases - see airtightness) or by ignition beyond the exposed surface (see thermal insulation) during the relevant fire situation."@en,
        "Capacidade de um elemento de compartimentação para impedir a propagação do fogo (por exemplo, pela passagem de chamas ou de gases quentes – ver estanquidade) ou por ignição para além da superfície exposta (ver isolamento térmico) durante a situação de incêndio relevante."@pt-PT ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X12FireCompartmentBoundary ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:21:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "90" ;
    fbo:hasNotionURL <https://www.notion.so/FunctionCompartmentation-151f8487e6e7803c8034d6b0d2d77ba5> ;
    fbo:hasValueType "Boolean (yes/no)" ;
    qudt:hasApplicableUnit "-" .

fbo-pt:FunctionSpace a owl:ObjectProperty ;
    rdfs:label "Function space"@en,
        "Uso de um espaço / local"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasExpertDefinition "Designação de um dado espaço de um piso de um edifício em termos de uso, podendo ser uma via horizontal (corredor), uma via vertical (escada), um ducto, uma câmara corta-fogo, uma fração autónoma, uma zona de refúgio ou um local (do tipo A, B, C, D, E ou F)."@en,
        "Designation of a given space on a floor of a building in terms of use, which may be a horizontal route (corridor), a vertical route (staircase), a shaft, a fire compartment, an autonomous fraction, a refuge area or a room (type A, B, C, D, E or F)."@pt-PT ;
    fbo:hasFireExpertEntity "Fire Expert" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:FunctionSpace ;
    fbo:hasLastEdition "2026-05-08T09:25:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "426" ;
    fbo:hasNotionURL <https://www.notion.so/FunctionSpace-268f8487e6e780e5b759e717b8ed22ba> .

fbo-pt:GableWall a owl:Class ;
    rdfs:label "Gable wall"@en,
        "Parede de empena"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "n.º 40 do art.º 1º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Side wall of a building, without openings, with the function of insulation from adjacent buildings, whether existing or to be built."@en,
        "Parede lateral de um edifício, sem aberturas, com a função de isolamento relativamente a edifícios contíguos, já existentes ou a construir"@pt-PT ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:25:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "501" ;
    fbo:hasNotionURL <https://www.notion.so/GableWall-2aef8487e6e7805b843ee45ec68107a5> .

fbo-pt:GrossArea a owl:DatatypeProperty ;
    rdfs:label "Gross area of a floor or fraction"@en,
        "Área bruta de um piso ou fracção"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 4 do art.º 1º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Total surface area of a given floor or fraction, delimited by the outer perimeter of the exterior walls and the axes of the interior walls separating that fraction from the others"@en,
        "Superfície total de um dado piso ou fração, delimitada pelo perímetro exterior das paredes exteriores e eixos das paredes interiores separadoras dessa fração, relativamente às restantes"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:GrossArea ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "300" ;
    fbo:hasNotionURL <https://www.notion.so/GrossArea-231f8487e6e780abb314c59f13936936> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-pt:HeightOccupancy a owl:DatatypeProperty ;
    rdfs:label "Height of an occupancy"@en,
        "Altura da utilização-tipo"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 2 do art.º 1º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Difference in elevation between the reference plane and the floor of the last floor above ground that can be occupied by that occupancy, in accordance with the following conditions"@en,
        "Diferença de cota entre o plano de referência e o pavimento do último piso acima do solo, suscetível de ocupação por essa utilização-tipo, de acordo com as seguintes condições"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "173" ;
    fbo:hasNotionURL <https://www.notion.so/HeightOccupancy-198f8487e6e780e994d4e26cbcc0094b> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M .

fbo-pt:HorizontalRoute a owl:Class ;
    rdfs:label "HorizontalRoute"@en,
        "Via de evacuação horizontal"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 14 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Horizontal communication in a building that provides safe conditions for the evacuation of its occupants. Horizontal evacuation routes may be corridors, antechambers, atriums, galleries, or, in large spaces, walkways explicitly marked on the floor for this purpose, which comply with the conditions of the Technical Regulations. Evacuation routes may be protected or unprotected. Protected evacuation routes may be enclosed (interior) or exterior."@en,
        "Comunicação horizontal de um edifício que , apresenta condições de segurança para a evacuação dos seus ocupantes. As vias de evacuação horizontais podem ser corredores, antecâmaras, átrios, galerias ou, em espaços amplos, passadeiras explicitamente marcadas no pavimento para esse efeito, que respeitem as condições do Regulamento Técnico. As vias de evacuação podem ser protegidas ou não. As vias de evacuação protegidas podem ser enclausuradas (interiores) ou exteriores."@pt-PT ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:FunctionSpace ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "563" ;
    fbo:hasNotionURL <https://www.notion.so/HorizontalRoute-302f8487e6e780cd9133eec30572843e> .

fbo-pt:IndependentBuilding a owl:DatatypeProperty ;
    rdfs:label "Independent building"@en,
        "Edifícios independente"@pt-PT ;
    schema1:rangeIncludes xsd:boolean ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID """n.º 19 do art.º 1º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings with independent structures, with no internal communication between them or, when there is one, it is exclusively through a fire chamber, and which comply with the provisions of Fire Safety in Buildings Regulation, regarding the fire resistance of the construction elements that isolate them from each other, as well as parts of the same building with a common structure, with no internal communication between them or, where there is one, it is carried out exclusively through a fire chamber and they comply with the provisions of Fire Safety in Buildings Regulation in relation to the fire resistance of the construction elements that isolate them from each other and neither part depends on the other to comply with the regulatory evacuation conditions."@en,
        "Edifícios dotados de estruturas independentes, sem comunicação interior entre eles ou, quando exista, a mesma seja efetuada exclusivamente através de câmara corta-fogo, e que cumpram as disposições de SCIE, relativamente à resistência ao fogo dos elementos de construção que os isolam entre si, bem como as partes de um mesmo edifício com estrutura comum, sem comunicação interior entre elas ou, quando exista, a mesma seja efetuada exclusivamente através de câmara corta-fogo e cumpram as disposições de SCIE, relativamente à resistência ao fogo dos elementos de construção que as isolam entre si e nenhuma das partes dependa da outra para cumprir as condições regulamentares de evacuação"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "136" ;
    fbo:hasNotionURL <https://www.notion.so/IndependentBuilding-151f8487e6e780ab85ddea02b31afcfd> ;
    fbo:hasValueType "Boolean (yes/no)" ;
    qudt:hasApplicableUnit "-" .

fbo-pt:IndependentFireCompartiment a owl:DatatypeProperty ;
    rdfs:label "Independent Fire Compartiment"@en,
        "Compartimentos Corta-Fogo independentes"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 3 do art.º 14º do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Different occupancies in the same building must constitute independent fire compartments, with the exceptions provided for in the Technical Regulation"@en,
        "Utilizações-tipo diferentes, no mesmo edifício, devem constituir compartimentos corta -fogo independentes, com as exceções previstas no RT-SCIE"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X11CompartmentSize ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "118" ;
    fbo:hasNotionURL <https://www.notion.so/IndependentFireCompartiment-151f8487e6e780838592c8741c9e6127> ;
    fbo:hasRemarks "It essentially refers to Article 17 of the RT-SCIE" ;
    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "-" .

fbo-pt:IndependentUnit a owl:Class ;
    rdfs:label "IndependentUnit"@en,
        "Fracção autónoma"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Is an independent unit of a building, with its own exit to a common area or public road, consisting of one or more compartments intended for specific purposes, such as housing, commerce, or services."@en,
        "É uma unidade independente (fração autónoma) de um edifício, com saída própria para uma parte comum ou para a via pública, sendo constituída por um ou mais compartimentos destinados a fins específicos, como habitação, comércio ou serviços."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "559" ;
    fbo:hasNotionURL <https://www.notion.so/IndependentUnit-302f8487e6e780dbb72bcc0b3e6680d8> .

fbo-pt:IndividualCoveredCarPark a owl:Class ;
    rdfs:label "Individual covered car park"@en,
        "Estacionamento individual coberto"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 28 do art.º 1º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Covered space with an area equal to or less than 50 m2 intended for car parking"@en,
        "Espaço coberto com área igual ou inferior a 50 m2 destinado ao estacionamento automóvel"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
