    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:FireCompartment1 ;
    fbo:hasLastEdition "2026-05-08T09:28:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "582" ;
    fbo:hasNotionURL <https://www.notion.so/Compartment-32cf8487e6e7805f9369cfcc36665a19> .

