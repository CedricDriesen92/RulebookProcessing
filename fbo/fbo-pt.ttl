fbo-pt:SmokeControlSystem a owl:ObjectProperty ;
    rdfs:label "Smoke Control System"@en,
        "Sistema de controlo de fumo"@pt-PT ;
    fbo:hasArticleID "n.º 9 do art.º 7º do Anexo ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "A set of structural measures and devices installed in a building or enclosure to control the spread of smoke, heat, and combustion gases during a fire through a process of smoke control, relative pressurization, or a combination of both."@en,
        "Conjunto de meios e medidas construtivas, implantado num edifício ou num recinto, destinado a controlar a propagação do fumo, do calor e dos gases de combustão, durante um incêndio, através de um processo de varrimento, de pressurização relativa, ou misto."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:28:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "588" ;
    fbo:hasNotionURL <https://www.notion.so/SmokeControlSystem-341f8487e6e780a39e02fa964fe68a01> .

fbo-pt:SmokeFreeHeight a owl:DatatypeProperty ;
    rdfs:label "Smoke Free Height"@en,
        "Altura livre de fumo / Zona livre de fumo"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasArticleID "n.º 11 do art.º 7º do Anexo oa RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The space between the floor and the underside of the suspended ceiling panels or, if there are no such panels, the underside of the lintels of the wall openings."@en,
        "Espaço compreendido entre o pavimento e a face inferior dos painéis de cantonamento suspensos do teto ou, caso estes não existam, a face inferior dos lintéis dos vãos nas paredes."@pt-PT ;
    fbo:hasExpertDefinition "The vertical distance between the floor level and the lower edge of the smoke layer, which must remain smoke-free during a fire, ensuring acceptable conditions for the evacuation of people and the response of emergency services."@en,
        "A distância vertical entre o nível do piso e a interface inferior da camada de fumos acumulados, que deve permanecer livre de fumo durante um incêndio, garantindo condições aceitáveis para a evacuação das pessoas e a intervenção dos meios de socorro."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-04-15T08:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "580" ;
    fbo:hasNotionURL <https://www.notion.so/SmokeFreeHeight-32cf8487e6e7805185f5dc163e3c9984> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit "Unit" .

