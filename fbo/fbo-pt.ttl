    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M .

fbo-pt:RiskCategory a owl:DatatypeProperty ;
    rdfs:label "Risk category"@en,
        "Categoria de risco"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 12 do art.º 1º do Anexo I do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Classification into four levels of fire risk of any standard use of a building and premises, taking into account various risk factors, such as its height, the number of occupantes, the number of occupants in risk locations, the modified fire load density and the existence of floors below the reference plane, under the terms of article 12 of the RJ-SCIE"@en,
        """Classificação em quatro níveis de risco de incêndio de qualquer
utilização-tipo de um edifício e recinto, atendendo a diversos fatores de risco, como a sua altura, o efetivo, o efetivo em locais de risco, a densidade de carga de incêndio modificada e a existência de pisos abaixo do plano de referência, nos termos previstos no artigo 12.º do RJ-SCIE"""@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "175" ;
    fbo:hasNotionURL <https://www.notion.so/RiskCategory-199f8487e6e780858c39c57666e0a085> ;
    fbo:hasSubitem fbo-pt:RiskCategory1,
        fbo-pt:RiskCategory2,
        fbo-pt:RiskCategory3,
        fbo-pt:RiskCategory4 ;
    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "Choice" .

