fbo-pt:LifeCycleofaBuilding a owl:ObjectProperty ;
    rdfs:label "Life Cycle of a Building"@en,
        "Ciclo de vida de um edifício"@pt-PT ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "A series of sequential stages covering the entire life cycle of a building, from conception and design, through construction, use, maintenance, and renovation, to decommissioning, demolition, and the eventual reuse or recycling of materials."@en,
        "Conjunto de fases sequenciais que abrangem toda a existência de um edifício, desde a conceção e projeto, passando pela construção, utilização, manutenção e reabilitação, até à sua desativação, demolição e eventual reutilização ou reciclagem de materiais."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:27:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "615" ;
