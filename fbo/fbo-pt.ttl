fbo-pt:DeadEndCorridor a owl:ObjectProperty ;
    rdfs:label "Dead end of a corridor"@en,
        "Impasse para uma via horizontal"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 8 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Situation in which, from a given point on a horizontal evacuation route, evacuation is only possible in one direction. The dead end is total if it continues along the entire route to an exit to a protected vertical escape route, a safety zone or a refuge area. The distance of the total dead end, expressed in metres, is measured along the axis of the route from that point to the aforementioned exit. The dead end may also be partial if it only continues along a section of the route until it joins another route where there are at least two escape alternatives. The distance of the partial dead end, expressed in metres, is measured along the axis of the dead end section from that point to the axis of the horizontal route where it joins."@en,
        "Situação, segundo a qual, a partir de um ponto de um dada via de evacuação horizontal, a evacuação só é possível num único sentido. O impasse é total se se mantém em todo o percurso até uma saída para uma via de evacuação vertical protegida, uma zona de segurança ou uma zona de refúgio. A distância do impasse total, expressa em metros, é medida pelo eixo da via, desde esse ponto até à referida saída. O impasse pode também ser parcial se se mantém apenas num troço da via até entroncar numa outra onde existam, pelo menos, duas alternativas de fuga. A distância do impasse parcial, expressa em metros, é medida pelo eixo do troço em impasse desde esse ponto até ao eixo da via horizontal onde entronca"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X22TravelDistance,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:20:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "352" ;
    fbo:hasNotionURL <https://www.notion.so/DeadEndCorridor-24ef8487e6e78058a0f0d91fb4bbd5f0> .

fbo-pt:DeadEndSpace a owl:ObjectProperty ;
    rdfs:label "Dead end of a space"@en,
        "Impasse para um ponto de um espaço"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 7 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Situation in which, from a given point in a given space, evacuation is only possible through access to a single exit, either to the outside or to a protected evacuation route, or to exits considered non-distinct. The distance from the impasse, expressed in metres, is measured from that point to the only exit or to the nearest of the exits considered non-distinct, through the axis of the highlighted paths, when required by this Regulation, or taking into account the fixed equipment and furniture to be installed or in line, if the two previous situations are not applicable."@en,
        "Situação, segundo a qual a partir de um ponto de um dado espaço a evacuação só é possível através do acesso a uma única saída, para o exterior ou para uma via de evacuação protegida, ou a saídas consideradas não distintas. A distância do impasse, expressa em metros, é medida desse ponto à única saída ou à mais próxima das saídas consideradas não distintas, através do eixo dos caminhos evidenciados, quando este Regulamento os exigir, ou tendo em consideração os equipamentos e mobiliários fixos a instalar ou em linha, se as duas situações anteriores não forem aplicáveis"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X22TravelDistance,
        fbo:X2EVACUATION ;
