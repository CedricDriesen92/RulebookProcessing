  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Time required for all occupants of a building, or part of it, to reach a safe area after the evacuation signal is given."@en,
        "Tempo necessário para que todos os ocupantes de um edifício, ou de parte dele, atinjam uma zona de segurança, a partir da emissão do sinal de evacuação"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
