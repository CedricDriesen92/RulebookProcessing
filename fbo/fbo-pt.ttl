fbo-pt:EmergencyExit a owl:Class ;
    rdfs:label "Emergency exit"@en,
        "Saída de emergência"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 10 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Exit to a protected evacuation route or safety zone, which is not normally available for other use by the public."@en,
        "Saída para um caminho de evacuação protegido ou para uma zona de segurança, que não está normalmente disponível para outra utilização pelo público"@pt-PT ;
