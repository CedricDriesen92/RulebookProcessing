    fbo:hasValueType "Enumeration (choice)" ;
    qudt:hasApplicableUnit "Choice" .

fbo-pt:OccupancyTypeII a owl:DatatypeProperty ;
    rdfs:label "OccupancyType II - Garages and Car Parks"@en,
        "Utilização-Tipo II - Estacionamentos"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    rdfs:subPropertyOf fbo-pt:OccupancyType ;
