fbo-pt:InitialCompartment a owl:Class ;
    rdfs:label "InitialCompartment"@en,
        "Compartimento inicial"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert defintions" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "It is the base space or functional unit of the building (such as a floor or compartment) whose dimensions and area are automatically modeled and calculated in the three-dimensional model to verify compliance with design requirements, functional programs, or applicable standards."@en,
        "É o espaço base ou unidade funcional do edifício (como um exemplo um piso ou compartimento) cujas dimensões e área são modeladas e calculadas automaticamente no modelo tridimensional para verificação de conformidade com requisitos de projeto, programas funcionais ou normas aplicáveis."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "560" ;
    fbo:hasNotionURL <https://www.notion.so/InitialCompartment-302f8487e6e780d68a7afd155d2b5292> .

