fbo-pt:OccupancyTypeI a owl:DatatypeProperty ;
    rdfs:label "OccupancyType I - Residential Building"@en,
        "Utilização-Tipo I - Habitacionais"@pt-PT ;
    schema1:rangeIncludes xsd:string ;
    rdfs:subPropertyOf fbo-pt:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
