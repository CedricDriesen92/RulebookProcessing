fbo-pt:VerticalRoute a owl:Class ;
    rdfs:label "VerticalRoute"@en,
        "Via de evacuação vertical"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 14 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Vertical communication in a building that provides safe conditions for the evacuation of its occupants. Vertical evacuation routes may be stairs, ramps, or stairs and inclined escalators, which comply with the conditions of the Technical Regulations. Evacuation routes may be protected or unprotected. Protected evacuation routes may be enclosed (interior) or exterior."@en,
        "Comunicação vertical de um edifício que , apresenta condições de segurança para a evacuação dos seus ocupantes. As vias de evacuação verticais podem ser escadas, rampas, ou escadas e tapetes rolantes inclinados, que respeitem as condições do Regulamento Técnico. As vias de evacuação podem ser protegidas ou não. As vias de evacuação protegidas podem ser enclausuradas (interiores) ou exteriores."@pt-PT ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:FunctionSpace ;
    fbo:hasLastEdition "2026-05-08T09:29:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "564" ;
    fbo:hasNotionURL <https://www.notion.so/VerticalRoute-302f8487e6e780b7abedc5084b0e4311> .

