fbo-pt:AreaRefugeSpace a owl:DatatypeProperty ;
    rdfs:label "Area of refuge space"@en,
        "Área da zona de refúgio"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasAdoptedDefinitionType "Explicit Definitin" ;
    fbo:hasArticleID "n.º 3 do art.º 68º do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "A refuge area must have a value, in m2, of no less than the effective area of the sites it serves, multiplied by the index 0.2."@en,
        "Uma zona de refúgio deve possuir uma área de valor, em m2, não inferior ao efetivo dos locais que serve, multiplicado pelo índice 0,2."@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X11CompartmentSize,
        fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:AreaRefugeSpace ;
    fbo:hasLastEdition "2026-02-24T08:46:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "277" ;
    fbo:hasNotionURL <https://www.notion.so/AreaRefugeSpace-223f8487e6e7800c8291d8207ac7df62> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-pt:AutomaticWaterFireSuppressionSystem a owl:ObjectProperty ;
    rdfs:label "Automatic Water Fire Suppression System"@en,
        "Sistema Automático de Extinção de Incêndio"@pt-PT ;
    fbo:hasAdoptedDefinitionType "A fixed system consisting of an adequate supply of extinguishing agent permanently connected to one or more fixed nozzles, through which the extinguishing agent is automatically discharged to extinguish a fire" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "A fixed system consisting of an adequate supply of extinguishing agent permanently connected to one or more fixed nozzles, through which the extinguishing agent is automatically discharged to extinguish a fire"@en,
        "Sistema fixo constituído por uma reserva adequada de agente extintor ligada permanentemente a um ou mais difusores fixos, pelos quais é projetado automaticamente o agente extintor para a extinção de um incêndio"@pt-PT ;
    fbo:hasFireExpertGuidance "It is usually a sprinkler system consisting of either pop-up sprinklers or deluge sprinklers" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:28:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "589" ;
    fbo:hasNotionURL <https://www.notion.so/AutomaticWaterFireSuppressionSystem-341f8487e6e78095bec6c88b1f160b93> .

fbo-pt:AutonomousRegion a owl:Class ;
    rdfs:label "Autonomous Region"@en,
        "Região Autónoma"@pt-PT ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "A subnational political and administrative entity with its own governing bodies and its own legislative, regulatory, and administrative powers, characterized by political, administrative, and financial autonomy."@pt-PT ;
    fbo:hasFireExpertEntity "Entidade político-administrativa de nível subnacional, dotada de órgãos de governo próprio e de poderes legislativos, regulamentares e administrativos próprios, caracterizada por autonomia política, administrativa e financeira." ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-05-08T09:27:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "620" ;
    fbo:hasNotionURL <https://www.notion.so/AutonomousRegion-355f8487e6e780b181a2e6abe8e7310d> .

fbo-pt:Building a owl:Class ;
    rdfs:label "Building"@en,
        "Edifício"@pt-PT ;
    rdfs:subClassOf fbo:Building ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Permanent fixed construction, consisting of one or more structures, intended to allow human occupation or to house activities."@en,
        "Construção fixa permanente, composta por uma ou mais estruturas, destinada a permitir a ocupação humana ou a abrigar atividades."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:Building ;
    fbo:hasLastEdition "2026-04-13T10:04:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "499" ;
