fbo-pt:NetArea a owl:DatatypeProperty ;
    rdfs:label "Net area of a floor or fraction"@en,
        "Área útil de um piso ou fracção"@pt-PT ;
    schema1:rangeIncludes xsd:float ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 6 do art.º 1º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Sum of the usable floor area of all interior compartments on a given floor or fraction thereof, excluding vestibules, interior circulation, common stairways and ramps, sanitary facilities, closets, storage rooms, wall cabinets and other compartments with a similar function, and measured by the interior perimeter of the walls that delimit those compartments, excluding walls up to 30 cm, interior walls, partitions and ducts."@en,
        "Soma da área útil de todos os compartimentos interiores de um dado piso ou fracção, excluindo-se vestíbulos, circulações interiores, escadas e rampas comuns, instalações sanitárias, roupeiros, arrumos, armários nas paredes e outros compartimentos de função similar, e mede-se pelo perímetro interior das paredes que delimitam aqueles compartimentos, descontando encalços até 30 cm, paredes interiores, divisórias e condutas"@pt-PT ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasEquivalentTerm "Usable area" ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "297" ;
    fbo:hasNotionURL <https://www.notion.so/NetArea-231f8487e6e7807f9591d4e1e056d90f> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-pt:NewConstruction a owl:ObjectProperty ;
