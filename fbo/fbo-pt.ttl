    rdfs:label "Fire Expert Approved"@en,
        "Aprovado por especialistas em segurança contra incêndio"@pt-PT ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "An indication that the definition or solution has been validated by a fire safety expert, based on their technical knowledge and/or professional experience."@en,
