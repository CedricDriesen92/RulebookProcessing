    qudt:hasApplicableUnit "-" .

fbo-pt:SelfClosing a owl:DatatypeProperty ;
    rdfs:label "Self-closing"@en,
        "Fecho automático"@pt-PT ;
    schema1:rangeIncludes xsd:boolean ;
    rdfs:subPropertyOf fbo:SelfClosing ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 6 do art.º 3º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The ability of a construction element guarding a span, in a fire situation, to take or resume the position that guarantees the closure of the span without human intervention"@en,
        "Propriedade de um elemento de construção que guarnece um vão de, em situação de incêndio, tomar ou retomar a posição que garante o fecho do vão sem intervenção humana"@pt-PT ;
    fbo:hasDesignator "C" ;
    fbo:hasDocumentReference fbo-pt:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
