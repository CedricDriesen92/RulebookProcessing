fbo-lt:FireBarrier a owl:Class ;
    rdfs:label "Fire barrier"@en,
        "Priešgaisrinė pertvara"@lt-LT,
        "Priešgaisrinė užtvara"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.40. (STR 2.01.01(2):1999)",
        "Chapter II, Paragraph 10.42. (STR 2.01.01(2):1999)" ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "fire-resistant construction that prevents fire from spreading to adjacent rooms (volumes)."@en,
        "non-combustible materials with a specified fire resistance rating that prevents the fire from spreading horizontally beyond the boundaries of the room."@en,
        "nedegių medžiagų nustatyto atsparumo ugniai nelaikanti konstrukcija, neleidžianti gaisrui išplisti horizontalia kryptimi už patalpos ribų."@lt-LT,
        "nustatyto atsparumo ugniai konstrukcija, neleidžianti gaisrui išplisti į gretimą patalpą (tūrį)."@lt-LT ;
    fbo:hasDesignator "EI" ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338,
        fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime,
        "2026-02-05T07:33:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "221",
        "267" ;
    fbo:hasNotionURL <https://www.notion.so/FireBarrier-214f8487e6e7806bb744ed0a79d772d4>,
        <https://www.notion.so/FireBarrier-214f8487e6e780f39e12e310e2a8e48f> ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-lt:FireCompartment a owl:Class ;
    rdfs:label "Fire compartment"@en,
        "Gaisrinis skyrius"@lt-LT ;
    rdfs:subClassOf fbo:FireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.24. (STR 2.01.01(2):1999)" ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "a closed space in a building (a room or group of rooms) separated from other parts of the same building by structural elements with a specified fire resistance rating, during which time a fire can be extinguished or prevented from spreading to other parts of the building."@en,
        "uždara pastato erdvė (patalpa ar patalpų grupė), atskirta nuo kitų to paties pastato dalių statinio konstrukcijomis, turinčiomis nustatytą atsparumo ugniai laiką, per kurį gaisras gali būti užgesintas arba išvengta jo plitimo į kitą pastato dalį."@lt-LT ;
    fbo:hasDesignator "Fg" ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338,
        fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:42:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "243" ;
    fbo:hasNotionURL <https://www.notion.so/FireCompartment-214f8487e6e780b3bd4aef253d8df937> ;
    fbo:hasValueType "Number" .

