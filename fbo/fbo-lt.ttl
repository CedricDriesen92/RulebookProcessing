fbo-lt:CreatingPressureDifference a owl:Class ;
    rdfs:label "Creating pressure difference"@en,
        "Slėgio skirtumo sudarymas"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.61." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "In stairwells, foyers, exit routes, or other areas of the building, the air pressure shall be higher than the air pressure in the room where the fire originated in order to prevent smoke from spreading from the room where the fire originated."@en,
        "laiptinėse, fojė, išėjimo maršrutų ar kitose pastato patalpose sudaromas oro slėgis, didesnis už gaisro kilmės patalpoje esantį oro slėgį, siekiant išvengti dūmų prasiskverbimo iš gaisro kilmės patalpos."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "228" ;
    fbo:hasNotionURL <https://www.notion.so/CreatingPressureDifference-214f8487e6e78089b3cbd8b2ed124e34> ;
    fbo:hasValueType "Number" .

