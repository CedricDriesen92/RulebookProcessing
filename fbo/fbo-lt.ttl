fbo-lt:RoofCoverings a owl:Class ;
    rdfs:label "Roof coverings"@en,
        "Stogo dangos"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.65." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "materials used to cover roofs, limiting the effects of the atmosphere on the building, including insulation layers and vapor barriers, except for the roof base."@en,
        "medžiagos, naudojamos dengti stogus, ribojančios atmosferos poveikį statiniui, įskaitant izoliacinius sluoksnius ir garo barjerus, išskyrus stogo pagrindą."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
