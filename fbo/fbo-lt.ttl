fbo-lt:FireResistantCable a owl:Class ;
    rdfs:label "Fire-resistant cable"@en,
        "Atsparus gaisrui kabelis"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.46." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "An electrical cable that can perform its intended functions (supply power or transmit signals) for a specified period of time during a fire, as determined by a standard fire test."@en,
        "elektros kabelis, kuris gaisro metu standartinio gaisro bandymu nustatytą laiko tarpą gali atlikti numatytas funkcijas (tiekti energiją ar perduoti signalus)."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
