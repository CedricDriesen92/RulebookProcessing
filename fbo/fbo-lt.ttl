    fbo:hasNotionURL <https://www.notion.so/FireResistantCable-214f8487e6e780819f23dea643b8ab4f> ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-lt:FireSafetyAssessmentCoefficient a owl:DatatypeProperty ;
    rdfs:label "Assessment coefficient for fire safety of a building"@en,
        "Pastato gaisrinės saugos įvertinimo koeficientas"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Annex 3, Paragraph 1, Table 2" ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition """G – assessment coefficient for fire safety of a building, generally considered to be equal to 1.
The coefficient G is determined as follows:
G = G1+…+G8, if the coefficient G1 is assessed;
G = 1+(G2+…+G8), if the G1 coefficient is not assessed;
where: G1…G8 – partial coefficients for the fire safety assessment of a building, depending on the fire safety systems installed in the building and the capabilities of the fire rescue service; their numerical values are given in Table 2 of Annex 3 (https://e-seimas.lrs.lt/portal/legalAct/lt/TAD/TAIS.388658/asr).
The values of the partial coefficients G3 and G4 shall only be applied with the approval of the state fire rescue service."""@en,
        """G – pastato gaisrinės saugos įvertinimo koeficientas, bendruoju atveju laikomas lygus 1.
Koeficientas G nustatomas taip:
G = G1+…+G8, jeigu yra įvertinamas G1 koeficientas;
G = 1+(G2+…+G8), jeigu G1 koeficientas neįvertinamas;
čia: G1…G8 – statinio gaisrinės saugos įvertinimo daliniai koeficientai, priklausantys nuo pastate įdiegiamų gaisrinės saugos sistemų ir priešgaisrinės gelbėjimo tarnybos galimybių; jų skaitinės vertės pateiktos 3 priedo 2 lentelėje (https://e-seimas.lrs.lt/portal/legalAct/lt/TAD/TAIS.388658/asr).
G3, G4 dalinių koeficientų reikšmės taikomos tik pritarus valstybinei priešgaisrinei gelbėjimo tarnybai."""@lt-LT ;
    fbo:hasDesignator "G" ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "510" ;
    fbo:hasNotionURL <https://www.notion.so/FireSafetyAssessmentCoefficient-2c6f8487e6e7800790d8ce7843cf1134> ;
    fbo:hasValueType "Number" .

