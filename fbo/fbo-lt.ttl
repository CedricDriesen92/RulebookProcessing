    fbo:hasDefinition "classes established in the usual way for classifying building elements and construction products according to their tested fire resistance."@en,
        "įprastu būdu nustatytos klasės, skirtos klasifikuoti pastatų elementus ir statybos produktus pagal išbandytą atsparumo ugniai trukmę."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
