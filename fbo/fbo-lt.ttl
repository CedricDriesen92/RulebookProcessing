fbo-lt:FireResistance a owl:DatatypeProperty ;
    rdfs:label "Fire Resistance"@en,
        "Atsparumas ugniai"@lt-LT ;
    rdfs:subPropertyOf fbo:FireResistance ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.33." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "the ability of a building structure or element (construction product) to withstand specified loads and/or to maintain thermal insulation properties and/or to remain homogeneous (sealed, crack-free) during a specified period of time in a standardised fire resistance test"@en,
        "pastato konstrukcijos ar elemento (statybos produkto) gebėjimas standartiniu atsparumo ugniai bandymu nustatytą laiko tarpą išlaikyti nustatytas apkrovas ir (arba) šilumos izoliacines savybes ir (arba) išlikti vientisam (sandariam, be plyšių)"@lt-LT ;
    fbo:hasDocumentReference fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "192" ;
    fbo:hasNotionURL <https://www.notion.so/FireResistance-20ff8487e6e7803cad52e816e5a43e65> ;
    fbo:hasUnit "minutes" ;
    fbo:hasValueType "Number" .

fbo-lt:FireResistanceBuilding a owl:Class ;
    rdfs:label "Fire resistance rating of the Building"@en,
        "Statinio atsparumo ugniai laipsnis"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter VIII, Paragraph 40, Table 2" ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "Buildings and fire compartments of buildings, taking into account their fire load categories and the fire resistance of the structural elements used to build them, are divided into buildings and fire compartments of fire resistance levels I, II, III."@en,
        "Statiniai, statinių gaisriniai skyriai, atsižvelgiant į jų gaisro apkrovos kategorijas ir jiems statyti panaudotų konstrukcijų elementų atsparumą ugniai, skirstomi į I, II, III atsparumo ugniai laipsnio statinius, statinių gaisrinius skyrius."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "453" ;
    fbo:hasNotionURL <https://www.notion.so/FireResistanceBuilding-27ef8487e6e7804aa998d4407c309c66> ;
    fbo:hasRemarks "Usually Fire Safety engineer decides what Fire resistance rating of the building will be" .

