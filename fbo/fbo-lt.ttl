    fbo:hasValueType "Boolean (yes/no)" .

fbo-lt:SeparateFunction a owl:DatatypeProperty ;
    rdfs:label "Separate function"@en,
        "Atskiriamoji funkcija"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.68." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "the ability of an element to prevent the spread of fire and/or smoke for a certain period of time due to the penetration of flames or hot gases (integrity, tightness) or ignition (thermal insulation) behind it."@en,
        "elemento gebėjimas tam tikrą laiką neleisti plisti gaisrui ir (arba) dūmams dėl liepsnos ar karštų dujų prasiskverbimo (vientisumas, sandarumas) ar užsidegimo (šiluminė izoliacija) už jo."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
