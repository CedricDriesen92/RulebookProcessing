fbo-lt:HeightBuilding a owl:DatatypeProperty ;
    rdfs:label "Height of building"@en,
        "Pastato aukštis"@lt-LT ;
    rdfs:subPropertyOf fbo:HeightBuilding ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Annex 3, Paragraph 1." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "height from the lowest surface elevation of the building to the access route for firefighting and rescue vehicles, and where access for firefighting and rescue vehicles is not required, from the lowest surface elevation of the portable fire ladders to the floor elevation of the highest storey (including attic) of the building (fire compartment), m."@en,
        "aukštis nuo gaisrų gesinimo ir gelbėjimo automobilių privažiavimo prie statinio žemiausios paviršiaus altitudės, o kai gaisrų gesinimo ir gelbėjimo automobilių privažiavimo įrengti nebūtina, – nuo nešiojamųjų gaisrinių kopėčių pastatymo žemiausios paviršiaus altitudės iki statinio (gaisrinio skyriaus) aukščiausio aukšto (įskaitant mansardinį) grindų altitudės, m."@lt-LT ;
    fbo:hasDesignator "H" ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:44:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "274" ;
    fbo:hasNotionURL <https://www.notion.so/HeightBuilding-221f8487e6e780a6add7c25912c612c4> ;
    fbo:hasUnit "m" ;
    fbo:hasValueType "Number" .

fbo-lt:IntendedUseOfTheBuilding a owl:DatatypeProperty ;
    rdfs:label "Intended use of the building"@en,
        "Pastato naudojimo paskirtis"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 13." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "The purpose of a building is considered to be the intended use of the building as specified in the public register, provided that the building complies with the mandatory requirements for safety and the activities (technological processes) planned (carried out) therein, as set out in the normative documents on building safety and purpose. When changing the purpose of a building, a building permit is required in the case specified in Article 27(1)(6) of the Construction Law. The composition of a building purpose change project is specified in STR 1.04.04:2017 “Building design, project expertise.”"@en,
        "Statinio paskirtimi laikomas viešajame registre nurodytas statinio naudojimo tikslas, kai statinys atitinka saugos ir jame planuojamos (atliekamos) veiklos (technologijos proceso) privalomuosius reikalavimus, nustatytus normatyviniuose statinio saugos ir paskirties dokumentuose. Keičiant statinio paskirtį, statybą leidžiantis dokumentas privalomas Statybos įstatymo 27 straipsnio 1 dalies 6 punkte nurodytu atveju. Statinio paskirties keitimo projekto sudėtis nurodyta STR 1.04.04:2017 „Statinio projektavimas, projekto ekspertizė“."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338,
        fbo-lt:STATYBOSTECHNINISREGLAMENTASSTR101032017STATINIIRPATALPKLASIFIKAVIMAS ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "200" ;
    fbo:hasNotionURL <https://www.notion.so/IntendedUseOfTheBuilding-214f8487e6e780218c01dfc6414c1cfa> ;
    fbo:hasValueType "Enumeration (choice)" .

