fbo-lt:FireLoad a owl:DatatypeProperty ;
    rdfs:label "Fire Load"@en,
        "Gaisro apkrova"@lt-LT ;
    rdfs:subPropertyOf fbo:FireLoad ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.29. (STR 2.01.01(2):1999)" ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "the amount of energy that can be released by the combustion of all combustible materials in the fire zone, including coatings on the external surfaces of walls, partitions, ceilings, floors"@en,
        "energijos kiekis, kuris gali būti išskirtas sudegus visoms gaisro zonoje esančioms degioms medžiagoms, įskaitant sienų, pertvarų, lubų, grindų išorinių paviršių dangas"@lt-LT ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338,
        fbo-lt:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "193" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoad-20ff8487e6e780f08d15ccff6b4b67bb> ;
    fbo:hasUnit "MJ" ;
    fbo:hasValueType "Number" .

