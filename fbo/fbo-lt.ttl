fbo-lt:MaxBuildingStoreyFloorAreaOfConnectingStoreys a owl:DatatypeProperty ;
    rdfs:label "Maximum floor area of connected storeys of the building"@en,
        "Maksimalus susisiekiančių aukštų grindų plotas"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Implicit Definition" ;
    fbo:hasArticleID "Chapter X, Paragraph 51." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "When determining the area of a building's fire compartment, the areas of all connecting floors are added together."@en,
        "Nustatant statinio gaisrinio skyriaus plotą, visų susisiekiančių aukštų plotai sumuojami."@lt-LT ;
    fbo:hasDocumentReference fbo-lt:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338 ;
