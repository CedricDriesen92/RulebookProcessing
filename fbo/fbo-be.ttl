fbo-be:Building a owl:Class ;
    rdfs:label "Building"@en,
        "Gebouw"@nl-BE ;
    rdfs:subClassOf fbo:Building ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Artikel 1.12" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "any building structure that forms a covered space accessible to people, wholly or partially enclosed by walls; industrial installations (chemical installations, tank farms) and structures (bridges, tunnels,..) are not considered buildings"@en,
        "elke bouwconstructie die een voor mensen toegankelijke overdekte ruimte vormt, geheel of gedeeltelijk met wanden omsloten; industriële installaties (zoals chemische installaties en tankparken) en kunstwerken (bruggen, tunnels,…) worden niet beschouwd als gebouwen"@nl-BE ;
    fbo:hasDocumentReference fbo-be:KBARApp1Terminology ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertValidation false ;
    fbo:hasIFCMapping fbo-ifc:Building ;
    fbo:hasLastEdition "2026-02-03T14:48:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "334" ;
