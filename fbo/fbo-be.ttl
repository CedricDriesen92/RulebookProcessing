fbo-be:FireCompartment a owl:Class ;
    rdfs:label "Compartment"@en,
        "Compartiment"@nl-BE ;
    rdfs:subClassOf fbo:FireCompartment ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasArticleID "Annex 1 - Artikel 1.6 + Annex 2/1, 3/1, 4/1 -  Artikel 2.1" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "Part of a building bounded by walls that serve to prevent the spread of fire to the adjacent compartment or compartments for a certain period of time. A compartment may or may be not divided into rooms."@en,
        "deel van een gebouw begrensd door wanden die de brandvoortplanting naar het aanliggende compartiment of compartimenten gedurende een bepaalde tijd dienen te beletten. Een compartiment is al dan niet onderverdeeld in lokalen."@nl-BE ;
    fbo:hasDocumentReference fbo-be:KBARApp1Terminology,
        fbo-be:KBARApp21LowriseBuildings,
        fbo-be:KBARApp31MediumriseBuildings,
        fbo-be:KBARApp41HighriseBuildings ;
    fbo:hasDomainReference fbo:X10AssignCompartment,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation false ;
    fbo:hasIFCMapping fbo-ifc:FireCompartment1 ;
    fbo:hasLastEdition "2026-02-03T14:42:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "278" ;
    fbo:hasNotionURL <https://www.notion.so/FireCompartment-223f8487e6e78039b8fee3912513fa99> ;
    fbo:hasRelatedProperty fbo-be:AreaFireCompartment .

