    fbo:hasLastEdition "2026-01-23T07:57:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "539" ;
    fbo:hasNotionURL <https://www.notion.so/Distance2EvacuationPath-2f1f8487e6e780dcb3e1da4492ee4c58> .

