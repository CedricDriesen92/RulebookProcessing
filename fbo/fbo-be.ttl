fbo-be:EvacuationLevel a owl:Class ;
    rdfs:label "Evacuation level"@en,
        "Evacuatieniveau"@nl-BE ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Artikel 5.6.8" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "building layer containing the exit(s) allowing evacuation to the outside. These exits lead to the public road or to a space from which it is accessible."@en,
        "bouwlaag die de uitgang(en) bevat waardoor evacuatie naar buiten mogelijk is. Deze uitgangen leiden naar de openbare weg of naar een ruimte vanwaar die bereikbaar is."@nl-BE ;
    fbo:hasDocumentReference fbo-be:KBARApp1Terminology ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-01-06T12:09:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "336" ;
    fbo:hasNotionURL <https://www.notion.so/EvacuationLevel-232f8487e6e780e59798ebac04734f16> .

