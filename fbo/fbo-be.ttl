    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertGuidance "In a compartment, the connection between staircases is via evacuation paths and vluchtterrassen" ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-01-06T12:09:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "68" ;
    fbo:hasNotionURL <https://www.notion.so/EvacuationPath-151f8487e6e7800cbf40fac241d6faee> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

