    fbo:hasDocumentReference fbo-be:KBARApp1Terminology ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertGuidance "If fixed furniture is present, the exact number of occupants can be used for that area. The number according to the definition can then be calculated based on the reduced area (=total area - area of fixed furniture)" ;
