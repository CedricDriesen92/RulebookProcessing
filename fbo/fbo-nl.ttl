    fbo:hasNotionID "406" ;
    fbo:hasNotionURL <https://www.notion.so/AccessibleSector-24ff8487e6e780cfb1a9f9b7e3c3018c> .

fbo-nl:AccessibleSectorElevatorLobby a owl:Class ;
    rdfs:label "elevator lobby accessible sector"@en,
        "voorportaal lift toegankelijkheidssector"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Implicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.77a" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "An extra-protected escape route for an elevator entrance that may not be adjacent to any residential exits. The elevator lobby serves as a place where a developed fire cannot develop or spread within a certain timeframe."@en,
        "Een extra beschermde vluchtroute voor een lifttoegang  waaraan geen uitgangen van woonfuncties mogen grenzen. Het voorportaal van de lift functioneert als een plek waar geen ontwikkelde brand kan ontstaan en kan komen binnen een bepaalde tijd."@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-20T14:48:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "392" ;
    fbo:hasNotionURL <https://www.notion.so/AccessibleSectorElevatorLobby-24ff8487e6e7808284d4d0230b610660> .

fbo-nl:AdditionallyProtectedEscapeRoute a owl:Class ;
    rdfs:label "Additionally protected escape route"@en,
        "Extra beschermde vluchtroute"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Bbl - Bbl 4.50.4" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "Part of a protected escape route located outside a fire compartment"@en,
        "Buiten een brandcompartiment gelegen gedeelte van een beschermde vluchtroute"@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasExpertDefinition "An escape route that imposes requirements on the materialization of the space in which it is exists."@en,
        "Een vluchtroute waaraan eisen worden gesteld aan de materialisering in de ruimten waardoor deze voert."@nl-NL ;
