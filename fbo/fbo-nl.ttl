fbo-nl:SmokeLock a owl:Class ;
    rdfs:label "smoke lock"@en,
        "rooksluis"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Implicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.77" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "A smoke lock prevents the premature entry of smoke into a stairwell. Between the horizontal part of the escape route and a stairwell at buildings (in which a difference in height of more than 20 m must be bridged), there must be a separate traffic space with a protected escape route or an open space (smoke lock) of at least 2 m in length."@en,
        "Een rooksluis voorkomt het voortijdig binnendringen van rook in een trappenhuis. Tussen het horizontale gedeelte van de vluchtroute en een trappenhuis bij gebouwen (waarbij een hoogteverschil van meer dan 20 m moet worden overbrugd) moet zich een aparte verkeersruimte met een beschermde vluchtroute of een open ruimte (rooksluis) van ten minste 2 m lengte bevinden."@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "413" ;
    fbo:hasNotionURL <https://www.notion.so/SmokeLock-24ff8487e6e780ef8c32c06d598dc402> .

