fbo-nl:AccessibleSector a owl:Class ;
    rdfs:label "accessible sector"@en,
        "toegankelijkheidssector"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition + Implicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.77a; Bbl - Artikel 4.189" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "part of a building independently usable and accessible for persons with functional disabilities"@en,
        "voor personen met een functiebeperking zelfstandig bruikbaar en toegankelijk gedeelte van een gebouw"@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X2EVACUATION ;
