fbo-nl:UseableAreaFireCompartment a owl:Class ;
    rdfs:label "Fire compartment usable area"@en,
        "Gebruiksoppervlakte brandcompartiment"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.51.1" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "The usable area of a firecompartment is measured at floor level, between the rising partitions that enclose the room or group of rooms in question. The following are not taken into account when determining the GO: — the area of parts of floors above which the net height is less than 1.5 m, with the exception of floors under stairs, ramps, etc.; — a lift shaft; — a stairwell, ring hole or void, if its area is greater than or equal to 4 m2; — a free-standing building structure (other than a staircase) if its horizontal cross-section is greater than or equal to 0.5 m2; — a service shaft, if its horizontal cross section is greater than or equal to 0.5 m2; — a load-bearing internal wall."@en,
        "De GO van een brandcompartment is gemeten op vloerniveau, tussen de opgaande scheidingsconstructies, die de desbetreffende ruimte of groep van ruimten omhullen. Bij de bepaling van de GO worden niet meegerekend: — de oppervlakte van delen van vloeren, waarboven de netto-hoogte kleiner is dan 1,5 m, met uitzondering van vloeren onder trappen, hellingbanen e.d.; — een liftschacht; — een trapgat, schalmgat of vide, indien de oppervlakte daarvan groter is dan of gelijk is aan 4 m2; — een vrijstaande bouwconstructie (niet zijnde een trap) indien de horizontale doorsnede daarvan groter is dan of gelijk is aan 0,5 m2; — een leidingschacht, indien de horizontale doorsnede daarvan groter is dan of gelijk is aan 0,5 m2; — een dragende binnenwand."@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:UsableAreaFireCompartment ;
    fbo:hasLastEdition "2026-04-13T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "195" ;
    fbo:hasNotionURL <https://www.notion.so/UseableAreaFireCompartment-214f8487e6e7800c95a0fb93b78a1fd1> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-nl:UseableAreaFunctionalArea a owl:Class ;
    rdfs:label "Functional area"@en,
        "Gebruiksgebied"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.50.5" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "Freely divisible part of a function where activities characteristic of the function take place, consisting of one or more spaces on the same floor located in a fire compartment that are not separated from each other by a load-bearing partition and that are not a toilet room, bathroom, technical room or traffic area, unless that space itself is a functional space"@en,
        "Vrij indeelbaar gedeelte van een gebruiksfunctie waar voor de gebruiksfunctie kenmerkende activiteiten plaatsvinden, dat bestaat uit een of meer op dezelfde bouwlaag gelegen ruimten gelegen in een brandcompartiment die niet door een dragende scheidingsconstructie van elkaar zijn gescheiden en die geen toiletruimte, badruimte, technische ruimte of verkeersruimte zijn, tenzij die ruimte zelf een functieruimte is"@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "345" ;
    fbo:hasNotionURL <https://www.notion.so/UseableAreaFunctionalArea-233f8487e6e780df9534eb5902a483c7> .

