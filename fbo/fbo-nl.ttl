fbo-nl:BuildingInternalWall a owl:Class ;
    rdfs:label "Internal wall"@en,
        "Inwendige scheidingsconstructie"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NEN2580:2007" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "Structure which separates two enclosed spaces in a building that are accessible to people, including parts of that structure connected to other structures insofar as those parts affect the compliance of the partition with a regulation under or pursuant to this decree"@en,
        "Constructie die de scheiding vormt tussen twee voor personen toegankelijke besloten ruimten van een gebouw, met inbegrip van de op die constructie aansluitende delen voor andere constructies, voor zover die delen van invloed zijn op het voldoen van die scheidingsconstructie aan een in dit besluit geldende eis"@nl-NL ;
    fbo:hasDocumentReference fbo-nl:NEN25802007C12008 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:InternalWall ;
    fbo:hasLastEdition "2026-01-06T12:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "342" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingInternalWall-233f8487e6e780069a2bd3d306d33b3a> .

fbo-nl:BuildingPartitionConstructionExternal a owl:Class ;
    rdfs:label "external partition (construction)"@en,
        "uitwendige scheidingsconstructie"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.54.2" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "structure separating an enclosed space in a building accessible to persons from the outside air, ground or water, including parts of other structures connected to that structure insofar as those parts affect the compliance of the separating structure with a regulation laid down under or pursuant to this Decree"@en,
        "constructie die de scheiding vormt tussen een voor personen toegankelijke besloten ruimte van een gebouw en de buitenlucht, de grond of het water, inclusief de op die constructie aansluitende delen van andere constructies, voor zover die delen van invloed zijn op het voldoen van die scheidingsconstructie aan een in dit besluit gestelde eis"@nl-NL ;
    fbo:hasDocumentReference fbo-nl:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "376" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingPartitionConstructionExternal-24ff8487e6e78039a20ad39fa7ba7e6f> .

