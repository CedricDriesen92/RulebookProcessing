fbo-PT:CommonArea a owl:Class ;
    rdfs:label "CommonArea"@en,
        "Área comum"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "It is a space in a building for collective use, intended for circulation and shared use by the occupants of different independent units, such as corridors, staircases, lobbies, and accesses, not assigned for the exclusive use of any particular unit."@en,
        "É um espaço de um edifício de utilização coletiva destinado à circulação e uso partilhado pelos ocupantes de diferentes frações autónomas, como corredores, escadas, átrios e acessos, não afeto a utilização exclusiva de nenhuma fração em particular."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:23:00+00:00"^^xsd:dateTime ;
