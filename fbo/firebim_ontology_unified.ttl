fbo-PT:HeightOccupancy a owl:DatatypeProperty ;
    rdfs:label "Height of an occupancy"@en,
        "Altura da utilização-tipo"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 2 do art.º 1º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Difference in elevation between the reference plane and the floor of the last floor above ground that can be occupied by that occupancy, in accordance with the following conditions"@en,
        "Diferença de cota entre o plano de referência e o pavimento do último piso acima do solo, suscetível de ocupação por essa utilização-tipo, de acordo com as seguintes condições"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
