fbo-DK:FunctionType a owl:Class ;
    rdfs:label "Anvendelse"@da-DK,
        "Function Type of use"@en ;
    fbo:hasAdoptedDefinitionType "Implicit definition" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anvendelse af bygningsafsnittet eller brandsektion fx kontorbyggeri, Hotel, daginstitutioner, plejehjem, garageanlæg, enfamiliehuse etc"@da-DK,
        "Use of the building compartment or fire compartment, e.g. office buildings, hotels, day care centres, nursing homes, garages, single-family houses, etc."@en ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Usage" ;
    fbo:hasFireExpertGuidance """Examples of functions that are essential for fire safety:
Visitor pavilions
Cinemas
Residential buildings
Shops
Kindergartens
Carports and outbuildings
Day centres
Nightclubs
Dobbelt-family houses
Single-family houses
Multi-storey residential buildings
Assembly halls
Prisons
Garage complexes
Garages
Hospitals
Hotels
Sports halls
Industrial and warehouse buildings
Agricultural breeding and operating buildings
Canteens
Churches
Clinics (doctor, dentist, physiotherapy, etc.)
Halls of residence
Allotment houses
Concert halls
Offices
Boarding schools, secondary schools and folk high schools
Inns
Chain houses
Meeting rooms
Guesthouses.
Care homes
Nursing homes
Restaurants
Townhouses
Lodging cabins
Shelters
Childcare centres
Holiday homes
Theatres
Technical buildings
Exhibition halls
Classrooms
Student housing
Youth hostels
Warming centres
Daycare centres""" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:16:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "302" ;
    fbo:hasNotionURL <https://www.notion.so/FunctionType-231f8487e6e780b9abcdc629d9ce358b> .

