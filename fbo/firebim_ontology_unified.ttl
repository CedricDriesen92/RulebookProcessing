    fbo:hasNotionURL <https://www.notion.so/FireCompartmentSubcompartment-151f8487e6e7807e9a2ff97037e84332> ;
    fbo:hasUnit "[-]" ;
    fbo:isLinkedTo fbo:FireCompartment .

fbo-DK:FireResistance a owl:DatatypeProperty ;
    rdfs:label "Brandmodstandsevne"@da-DK,
        "Fire resistance"@en ;
