    fbo:hasValueType "Number" .

fbo-PT:HorizontalRoute a owl:Class ;
    rdfs:label "HorizontalRoute"@en,
        "Via de evacuação horizontal"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 14 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Horizontal communication in a building that provides safe conditions for the evacuation of its occupants. Horizontal evacuation routes may be corridors, antechambers, atriums, galleries, or, in large spaces, walkways explicitly marked on the floor for this purpose, which comply with the conditions of the Technical Regulations. Evacuation routes may be protected or unprotected. Protected evacuation routes may be enclosed (interior) or exterior."@en,
        "Comunicação horizontal de um edifício que , apresenta condições de segurança para a evacuação dos seus ocupantes. As vias de evacuação horizontais podem ser corredores, antecâmaras, átrios, galerias ou, em espaços amplos, passadeiras explicitamente marcadas no pavimento para esse efeito, que respeitem as condições do Regulamento Técnico. As vias de evacuação podem ser protegidas ou não. As vias de evacuação protegidas podem ser enclausuradas (interiores) ou exteriores."@pt-PT ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "563" ;
    fbo:hasNotionURL <https://www.notion.so/HorizontalRoute-302f8487e6e780cd9133eec30572843e> .

fbo-PT:IndependentBuilding a owl:DatatypeProperty ;
    rdfs:label "Independent building"@en,
        "Edifícios independente"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID """n.º 19 do art.º 1º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings with independent structures, with no internal communication between them or, when there is one, it is exclusively through a fire chamber, and which comply with the provisions of Fire Safety in Buildings Regulation, regarding the fire resistance of the construction elements that isolate them from each other, as well as parts of the same building with a common structure, with no internal communication between them or, where there is one, it is carried out exclusively through a fire chamber and they comply with the provisions of Fire Safety in Buildings Regulation in relation to the fire resistance of the construction elements that isolate them from each other and neither part depends on the other to comply with the regulatory evacuation conditions."@en,
        "Edifícios dotados de estruturas independentes, sem comunicação interior entre eles ou, quando exista, a mesma seja efetuada exclusivamente através de câmara corta-fogo, e que cumpram as disposições de SCIE, relativamente à resistência ao fogo dos elementos de construção que os isolam entre si, bem como as partes de um mesmo edifício com estrutura comum, sem comunicação interior entre elas ou, quando exista, a mesma seja efetuada exclusivamente através de câmara corta-fogo e cumpram as disposições de SCIE, relativamente à resistência ao fogo dos elementos de construção que as isolam entre si e nenhuma das partes dependa da outra para cumprir as condições regulamentares de evacuação"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "136" ;
    fbo:hasNotionURL <https://www.notion.so/IndependentBuilding-151f8487e6e780ab85ddea02b31afcfd> ;
    fbo:hasUnit "-" ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-PT:IndependentFireCompartiment a owl:DatatypeProperty ;
    rdfs:label "Independent Fire Compartiment"@en,
        "Compartimentos Corta-Fogo independentes"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 3 do art.º 14º do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Different occupancies in the same building must constitute independent fire compartments, with the exceptions provided for in the Technical Regulation"@en,
        "Utilizações-tipo diferentes, no mesmo edifício, devem constituir compartimentos corta -fogo independentes, com as exceções previstas no RT-SCIE"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X11CompartmentSize ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "118" ;
    fbo:hasNotionURL <https://www.notion.so/IndependentFireCompartiment-151f8487e6e780838592c8741c9e6127> ;
    fbo:hasRemarks "It essentially refers to Article 17 of the RT-SCIE" ;
    fbo:hasUnit "-" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:IndependentUnit a owl:Class ;
    rdfs:label "IndependentUnit"@en,
        "Fracção autónoma"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Is an independent unit of a building, with its own exit to a common area or public road, consisting of one or more compartments intended for specific purposes, such as housing, commerce, or services."@en,
        "É uma unidade independente de um edifício, com saída própria para uma parte comum ou para a via pública, sendo constituída por um ou mais compartimentos destinados a fins específicos, como habitação, comércio ou serviços."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "559" ;
    fbo:hasNotionURL <https://www.notion.so/IndependentUnit-302f8487e6e780dbb72bcc0b3e6680d8> .

