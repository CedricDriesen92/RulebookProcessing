fbo-BE:AreaFireCompartment a owl:DatatypeProperty ;
    rdfs:label "Compartment Area"@en,
        "Oppervlakte van een compartiment"@nl-BE ;
    rdfs:subPropertyOf fbo:AreaFireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Article 1.6.1" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "Horizontal gross-area measured without any deduction between the inner surfaces of the compartment boundaries"@en,
        "horizontale bruto-oppervlakte zonder enige aftrek gemeten tussen de binnenvlakken der compartimentswanden"@nl-BE ;
    fbo:hasDocumentReference fbo-BE:KBARApp1Terminology ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasExpertDefinition "The area of the floor, without deducting the area of columns, walls or other elements resting on the floor. The area of the enclosed staircases and enclosed shafts is deducted because they are not part of the compartment."@en,
        "de oppervlakte van de vloer, zonder aftrek van de oppervlakte van de kolommen, muren of andere elementen die op de vloer rusten. De oppervlakte van de omsloten trappenhuizen en van de omsloten kokers wordt wel afgetrokken omdat zij geen deel uitmaken van het compartiment"@nl-BE ;
    fbo:hasFireExpertEntity "Interpretation note - FOD IBZ" ;
    fbo:hasFireExpertValidation false ;
    fbo:hasIFCMapping fbo-ifc:AreaFireCompartment2a ;
    fbo:hasLastEdition "2026-02-16T12:54:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "94" ;
    fbo:hasNotionURL <https://www.notion.so/AreaFireCompartment-151f8487e6e78046a43eef0ac3bf15ff> ;
    fbo:hasRelatedProperty fbo-BE:FireCompartment ;
    fbo:hasUnit "m²" ;
    fbo:hasValueType "Number" .

