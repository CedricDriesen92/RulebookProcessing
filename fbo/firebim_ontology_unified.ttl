fbo-NL:EscapeRouteCapacity a owl:Class ;
    rdfs:label "capacity"@en,
        "capaciteit"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Expert Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.80.1" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDocumentReference fbo-NL:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
        fbo:X24WithoftheExits,
        fbo:X25WithoftheEvacuationPath,
        fbo:X2EVACUATION ;
    fbo:hasExpertDefinition "capacity of an escape route: the flow capacity in combination with the reception capacity. The flow capacity is the number of presons that, dependant on the width of the escape route, are moving through an escape route (expressed in persons per minute). The reception capacity is the number of persons that can safely stay put in a space (expressed in people per square meters). A calculation by the fire expert is needed."@en,
        "capaciteit van een vluchtroute: de doorstroomcapaciteit in combinatie met de opvangcapaciteit. De doorstroomcapaciteit is het aantal personen dat, afhankelijk van de breedte van de vluchtroute, zich door een vluchtroute beweegt (uitgedrukt in personen per minuut). De opvangcapaciteit is het aantal personen dat veilig in een ruimte kan verblijven (uitgedrukt in personen per vierkante meter). Hiervoor dient een berekening uitgevoerd te worden door een fire expert."@nl-NL ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "373" ;
    fbo:hasNotionURL <https://www.notion.so/EscapeRouteCapacity-24ff8487e6e780329514dc80b618d513> .

