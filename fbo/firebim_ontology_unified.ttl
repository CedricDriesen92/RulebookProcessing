    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Et eller flere rum, hvorfra branden ikke spredes til andre brandceller i den tid, der kræves til evakuering og redningsberedskabets redningsindsats i tilstødende brandceller."@da-DK,
        "One or more rooms from which the fire does not spread to other subcompartments during the time required for evacuation and rescue efforts in adjacent subcompartments."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire cell, Fire compartment" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
