fbo-DK:SurfaceCladding a owl:Class ;
    rdfs:label "Beklædning"@da-DK,
        "Surface-cladding"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Et tæt lag i en bygningskonstruktion, typisk det yderste, som beskytter bagvedliggende materialer mod brandpåvirkning i et bestemt tidsrum. Det er eksempelvis den yderste del af en væg, den nederste del af en etageadskillelse eller undersiden af en tagkonstruktion, f.eks. en gipspladebeklædning."@da-DK,
        "A compact, protective layer in a building structure, typically the outermost layer, that protects underlying materials from the effects of fire for a specific period of time. For example, the outermost part of a wall, the lower part of a soffit or the underside of a roof structure, such as plasterboard cladding."@en ;
    fbo:hasDesignator "K1" ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Surface, Cladding, Clothing" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "82" ;
    fbo:hasNotionURL <https://www.notion.so/SurfaceCladding-151f8487e6e7802eb9cde1e46df78a50> ;
    fbo:hasUnit "[-]" .

fbo-DK:SurfaceCladdingRainscreen a owl:Class ;
    rdfs:label "Regnskærm"@da-DK,
        "Rainscreen cladding"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Skærm, som ophænges uden på ydervægsbeklædningen, og som har et bagvedliggende hulrum. En regnskærm kan være åben eller lukket. Brandteknisk set er en regnskærm ikke en beklædning, og den skal ikke være brandbeskyttende. Derfor stilles kun krav til en regnskærms reaktion på brand og sikring mod brandspredning via hulrum bag regnskærmen, men ikke til dens brandbeskyttende evne."@da-DK,
        "A screen that is suspended outside the outer wall cladding and has a cavity behind it. A rainscreen can be open or closed. From a fire protection point of view, a rainscreen is not a cladding and is not required to be fire protective. Therefore, requirements are only set for a rainscreen's reaction to fire and protection against fire spread via cavities behind the rainscreen, but not for its fire protection ability."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasEquivalentTerm "Rain shield, Rain shade, Rain shelter" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:15:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "115" ;
    fbo:hasNotionURL <https://www.notion.so/SurfaceCladdingRainscreen-151f8487e6e7807d8a92e1bb443538a2> .

