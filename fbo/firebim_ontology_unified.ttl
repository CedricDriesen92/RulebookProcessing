fbo-LT:PartialCoefficient a owl:DatatypeProperty ;
    rdfs:label "partial coefficients for the fire safety assessment of a building"@en,
        "statinio gaisrinės saugos įvertinimo daliniai koeficientai"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Annex 3, Paragraph 1, Table 2" ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition """G1…G8 – partial coefficients for the fire safety assessment of a building, depending on the fire safety systems installed in the building and the capabilities of the fire rescue service; their numerical values are given in Table 2 of Annex 3 (https://e-seimas.lrs.lt/portal/legalAct/lt/TAD/TAIS.388658/asr).
The values of the partial coefficients G3 and G4 shall only be applied with the approval of the state fire rescue service."""@en,
        """G1…G8 – statinio gaisrinės saugos įvertinimo daliniai koeficientai, priklausantys nuo pastate įdiegiamų gaisrinės saugos sistemų ir priešgaisrinės gelbėjimo tarnybos galimybių; jų skaitinės vertės pateiktos 3 priedo 2 lentelėje (https://e-seimas.lrs.lt/portal/legalAct/lt/TAD/TAIS.388658/asr).
G3, G4 dalinių koeficientų reikšmės taikomos tik pritarus valstybinei priešgaisrinei gelbėjimo tarnybai."""@lt-LT ;
    fbo:hasDesignator "G1…G8" ;
    fbo:hasDocumentReference fbo-LT:GAISRINSSAUGOSPAGRINDINIAIREIKALAVIMAINr1338 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "512" ;
    fbo:hasNotionURL <https://www.notion.so/PartialCoefficient-2c6f8487e6e780b0b4adee6268ab4c80> ;
    fbo:hasValueType "Number" .

fbo-LT:RoofCoverings a owl:Class ;
    rdfs:label "Roof coverings"@en,
        "Stogo dangos"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.65." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "materials used to cover roofs, limiting the effects of the atmosphere on the building, including insulation layers and vapor barriers, except for the roof base."@en,
