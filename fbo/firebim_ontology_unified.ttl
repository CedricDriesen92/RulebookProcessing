fbo-NL:SupervisionLevelPermanentBedriddenPatients a owl:Class ;
    rdfs:label "permanent supervision"@en,
        "permanente bewaking"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Expert Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.59.6" ;
    fbo:hasCountry fbo:Netherlands ;
