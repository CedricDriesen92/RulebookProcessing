fbo-PT:OperatingEntity a owl:Class ;
    rdfs:label "Operating Entity"@en,
        "Entidade Exploradora"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasExpertDefinition "Entidade competente, individual ou colectiva, responsável pela manutenção das condições de segurança contra incêndio e a implementação das medidas de autoproteção de um edifício ou recinto, durante todo o seu ciclo de vida."@en,
        "Competent entity, whether individual or collective, responsible for maintaining fire safety conditions and implementing emergency management in a building or enclosure throughout its life cycle."@pt-PT ;
    fbo:hasFireExpertEntity "Fire Expert" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "424" ;
    fbo:hasNotionURL <https://www.notion.so/OperatingEntity-268f8487e6e7809aa26bd52bb893e6d2> .

fbo-PT:Outdoor a owl:Class ;
    rdfs:label "Outdoor"@en,
        "Exterior"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "It is any outdoor space or large, permanently ventilated area that is freely connected to the outside and constitutes a safe zone where people can go in the event of a fire."@en,
        "É qualquer espaço ao ar livre ou local amplo e permanentemente ventilado, em comunicação livre com o espaço exterior, que constitui uma zona de segurança para onde as pessoas se podem dirigir em caso de incêndio."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "561" ;
    fbo:hasNotionURL <https://www.notion.so/Outdoor-302f8487e6e780e5b374f20463de5eb0> .

fbo-PT:OutdoorSpace a owl:Class ;
    rdfs:label "OutdoorSpace"@en,
        "Espaço exterior"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Local que não está limitado por paredes ou coberturas que o tornem interior."@en,
        "A place that is not enclosed by walls or roofs that make it interior."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "505" ;
    fbo:hasNotionURL <https://www.notion.so/OutdoorSpace-2aef8487e6e78095a5aec0c4e2d535bf> .

fbo-PT:PanicExitDevice a owl:Class ;
    rdfs:label "Panic exit device"@en,
        "Barra anti-pânico"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 1 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Mechanical device installed on a door that allows, in the event of an emergency evacuation, easy opening by simply pressing against it with the body, without the need to use the hands."@en,
        "Dispositivo mecânico instalado numa porta que permita, em caso de evacuação de emergência, a sua fácil abertura por mera pressão do corpo do utilizador, sem necessidade de uso das mãos"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "349" ;
    fbo:hasNotionURL <https://www.notion.so/PanicExitDevice-24ef8487e6e7802d8ce2fc556e44f15d> .

fbo-PT:PassageUnit a owl:Class ;
    rdfs:label "Passage unit (PU)"@en,
        "Unidade de passagem (UP)"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 13 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition """Theoretical unit used to assess the width required for people to pass through during an evacuation. The correspondence in metric units, rounded down to the nearest whole number, is as follows:
a) 1 UP = 0.9 m;
b) 2 UP = 1.4 m;
c) N UP = N × 0.6 m (for N > 2)."""@en,
        """Unidade teórica utilizada na avaliação da largura necessária à passagem de pessoas no decurso da evacuação. A correspondência em unidades métricas, arredondada por defeito para o número inteiro mais próximo, é a seguinte:
a) 1 UP = 0,9 m;
b) 2 UP = 1,4 m;
c) N UP = N × 0,6 m (para N > 2)."""@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X24WithoftheExits,
        fbo:X25WithoftheEvacuationPath,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "347" ;
    fbo:hasNotionURL <https://www.notion.so/PassageUnit-24ef8487e6e7801f9340dc057b14f20b> .

fbo-PT:ProjectScope a owl:Class ;
    rdfs:label "Project Scope"@en,
        "Âmbito do projecto"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "The fire safety specialty project is the technical document that defines the fire protection solutions and measures for a building or enclosure, establishing the safety objectives, the strategies to achieve them, and the requirements to be integrated into the architectural design and other specialties, through a descriptive and explanatory report and drawings that represent the layout, emergency accesses, risk classification, fire resistance conditions, evacuation, and the location of safety equipment and systems."@en,
        "O projeto de especialidade de segurança contra incêndio é o documento técnico que define as soluções e medidas de proteção contra incêndio de um edifício ou recinto, estabelecendo os objetivos de segurança, as estratégias para os alcançar e as exigências a integrar no projeto de arquitetura e nas restantes especialidades, através de uma memória descritiva e justificativa e de peças desenhadas que representem a implantação, os acessos de socorro, a classificação de risco, as condições de resistência ao fogo, evacuação e a localização dos equipamentos e sistemas de segurança."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "550" ;
    fbo:hasNotionURL <https://www.notion.so/ProjectScope-302f8487e6e780b6a82bd270e32f67fa> .

fbo-PT:ProtectedLobby a owl:Class ;
    rdfs:label "Protected lobby"@en,
        "Câmara corta-fogo"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "n.º 1 do art.º 3º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Independent fire compartment, with a degree of resistance and smoke control systems, which generally establishes communication between two spaces with the aim of ensuring the temporary protection of one of them or preventing the spread of fire between them."@en,
        "Compartimento corta-fogo independente, com um grau de resistência e os meios de controlo de fumo, que estabelece, em regra, a comunicação entre dois espaços com o objetivo de garantir a proteção temporária de um deles ou evitar a propagação do incêndio entre ambos."@pt-PT ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "504" ;
    fbo:hasNotionURL <https://www.notion.so/ProtectedLobby-2aef8487e6e7808bbfe4f0826b269897> .

fbo-PT:ProtectedRoute a owl:Class ;
    rdfs:label "Protected route"@en,
        "Via de evacuação protegida"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 17 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Evacuation route equipped with means that protect its users from gases, smoke and fire during the time necessary for evacuation. The cladding of the surrounding construction elements of protected evacuation routes must exhibit a reaction to fire in accordance with the specifications of this regulation. In a protected evacuation route, there must be no unprotected ducts for plumbing, waste or any other purpose, nor any access to ducts, nor pipes for combustible or oxidising gases, combustible liquids or electrical installations. Exceptions to the latter case are those necessary for lighting, fire detection and control of safety systems or devices, or low-voltage communications. Water pipes intended for firefighting are also exempt."@en,
        "Via de evacuação dotada de meios que conferem aos seus utentes proteção contra os gases, o fumo e o fogo, durante o período necessário à evacuação. Os revestimentos dos elementos de construção envolventes das vias de evacuação protegidas devem exibir uma reação ao fogo conforme as especificações do presente regulamento. Numa via de evacuação protegida não podem existir ductos, não protegidos, para canalizações, lixos ou para qualquer outro fim, nem quaisquer acessos a ductos, nem canalizações de gases combustíveis ou comburentes, líquidos combustíveis ou instalações elétricas. Excetuam-se, neste último caso, as que sejam necessárias à sua iluminação, deteção de incêndios e comando de sistemas ou dispositivos de segurança ou, ainda, de comunicações em tensão reduzida. Excetuam-se ainda as canalizações de água destinadas ao combate a incêndios"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "356" ;
    fbo:hasNotionURL <https://www.notion.so/ProtectedRoute-24ef8487e6e78094bed3c20e30c2d340> .

fbo-PT:PublicOccupants a owl:Class ;
    rdfs:label "Public Occupants"@en,
        "Efectivo de Público"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 22 do art.º 1º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Estimated maximum number of people who can occupy a given space in a building or enclosure that receives the public at the same time, excluding the number of employees and any other persons involved in its operation"@en,
        "Número máximo estimado de pessoas que pode ocupar em simultâneo um dado espaço de edifício ou recinto que recebe público, excluindo o número de funcionários e quaisquer outras pessoas afetas ao seu funcionamento"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "430" ;
    fbo:hasNotionURL <https://www.notion.so/PublicOccupants-269f8487e6e780da9d93cc2f9d0b48c0> .

fbo-PT:ReferencePlane a owl:DatatypeProperty ;
    rdfs:label "Reference plane"@en,
        "Plano de referência"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID """n.º 54 do art.º 1º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The level plane, at the floor level of the access for rescue vehicles, measured perpendicular to a direct exit to the outside of the building; if there is more than one reference plane, the most favorable plane for fire department operations is considered"@en,
        "O nível do plano, ao nível do piso de acesso dos veículos de socorro, medido perpendicularmente a uma saída direta para o exterior do edifício; se existir mais do que um plano de referência, considera-se o plano mais favorável às operações dos bombeiros"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "164" ;
    fbo:hasNotionURL <https://www.notion.so/ReferencePlane-151f8487e6e780f7960efbb187b140c7> ;
    fbo:hasUnit "-" ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-PT:RefugeSpace a owl:DatatypeProperty ;
    rdfs:label "Refuge space"@en,
        "Zona de refúgio"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "n.º 18 do art.º 4º do Anexo I do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "A space within a building, temporarily safe, specially equipped with protective measures, so that people are not exposed to the direct effects of a fire in the building."@en,
        "Local num edifício, temporariamente seguro, especialmente dotado de meios de proteção, de modo a que as pessoas não venham a sofrer dos efeitos diretos de um incêndio no edifício;"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "174" ;
    fbo:hasNotionURL <https://www.notion.so/RefugeSpace-198f8487e6e780ff847ae64eaf66075a> ;
    fbo:hasUnit "-" .

fbo-PT:RiskFireActivation a owl:DatatypeProperty ;
    rdfs:label "Risk of fire activation"@en,
        "Risco de ativação de incêndio"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - Artigo 1.5.3.6" ;
