fbo-NL:WalkingDistance a owl:Class ;
    rdfs:label "walking distance"@en,
        "loopafstand"@nl-NL ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Bbl - Artikel 4.66.1" ;
    fbo:hasCountry fbo:Netherlands ;
    fbo:hasCountryCode "NL" ;
    fbo:hasDefinition "the distance between two points(between a point in the functional area and at least one exit of the subfirecompartment that lies in that functional area ), measured along the shortest possible notional continuous line along which a person can walk maintaining a distance of at least 0.3 m from structural components, with the walking distance over a staircase coinciding with the pitch line;"@en,
        "afstand, gemeten langs een denkbeeldige, kortst realiseerbare lijn tussen twee punten (tussen een punt in een gebruiksgebied en ten minste een uitgang van het subbrandcompartiment waarin dat gebruiksgebied ligt), waarover op een afstand van ten minste 0,3 m van constructieonderdelen kan worden gelopen en waarbij de loopafstand over een trap samenvalt met de klimlijn;"@nl-NL ;
    fbo:hasDocumentReference fbo-NL:Besluitbouwwerkenleefomgeving ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
        fbo:X22TravelDistance,
        fbo:X23LengthofEvacuationPath,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-23T12:36:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "380" ;
    fbo:hasNotionURL <https://www.notion.so/WalkingDistance-24ff8487e6e7803eb65ae6e42e384bcf> .

