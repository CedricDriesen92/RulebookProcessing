    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeIVSchools a owl:DatatypeProperty ;
    rdfs:label "OccupancyType IV - Schools"@en,
        "Utilização-Tipo IV- Escolares"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea d) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings or parts of buildings open to the public, where education, teaching and training activities are carried out or recreational or educational activities are carried out for children and young people, which may or may not include resting or sleeping areas for participants in these actions and activities, namely schools at all levels of education, nurseries, kindergartens, training centers, leisure centers for children and young people and youth centers;"@en,
        "Corresponde a edifícios ou partes de edifícios recebendo público, onde se ministrem ações de educação, ensino e formação ou exerçam atividades lúdicas ou educativas para crianças e jovens, podendo ou não incluir espaços de repouso ou de dormida afetos aos participantes nessas ações e atividades, nomeadamente escolas de todos os níveis de ensino, creches, jardins -de-infância, centros de formação, centros de ocupação de tempos livres destinados a crianças e jovens e centros de juventude;"@pt-PT ;
    fbo:hasDesignator "UT IV" ;
    fbo:hasEquivalentTerm "Use type IV" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "290" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeIV-Schools-231f8487e6e780059c85ea97e01649c1> ;
    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeIXSportsandLeisureFacilities a owl:DatatypeProperty ;
    rdfs:label "OccupancyType IX - Sports and Leisure Facilities"@en,
        "Utilização-Tipo IX - Desportivos e Lazer"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea i) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings, parts of buildings and enclosures, whether or not they are open to the public, used for sports and leisure activities, namely stadiums, riding arenas, hippodromes, velodromes, autodromes, motodromes, karting arenas, playing fields, camping and caravan parks, sports halls, swimming pools, water parks, skating rinks, gyms and saunas"@en,
        "Corresponde a edifícios, partes de edifícios e recintos, recebendo ou não público, destinados a atividades desportivas e de lazer, nomeadamente estádios, picadeiros, hipódromos, velódromos, autódromos, motódromos, kartódromos, campos de jogos, parques de campismo e caravanismo, pavilhões desportivos, piscinas, parques aquáticos, pistas de patinagem, ginásios e saunas;"@pt-PT ;
    fbo:hasDesignator "UT IX" ;
    fbo:hasEquivalentTerm "Use type IX" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "294" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeIX-Sports-and-Leisure-Facilities-231f8487e6e78055a3e3cd32d1aebc8d> ;
    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeScopeCheck1 a owl:Class ;
    rdfs:label "Check #1"@en,
        "Verificação n.º 1"@pt-PT ;
    rdfs:subClassOf fbo-PT:MixedOccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "alínea a) do n.º 3 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition """The general and specific provisions of the type of use to which they belong apply to spaces integrated into a given type of use, under the conditions indicated below, and no other provisions are applicable:
a) Spaces where administrative, document archiving and storage activities necessary for the functioning of entities operating occupancy types III to XII are carried out, provided that they are managed under their responsibility, are not normally accessible to the public and each of these spaces does not have a gross area exceeding:
i) 10% of the gross area allocated to occupancy types III to VII, IX and XI;
ii) 20% of the gross area allocated to occupancy types VIII, X and XII;"""@en,
        """Aos espaços integrados numa dada utilização -tipo, nas condições a seguir indicadas, aplicam-se as disposições gerais e as específicas da utilização-tipo onde se inserem, não sendo aplicáveis quaisquer outras:
a) Espaços onde se desenvolvam atividades administrativas, de arquivo documental e de armazenamento necessários ao funcionamento das entidades que exploram as utilizações-tipo IIIa XII, desde que sejam geridos sob a sua responsabilidade, não estejam normalmente acessíveisao público e cada um desses espaços não possua uma área bruta superior a:
i) 10 % da área bruta afeta às utilizações-tipo III a VII, IX e XI;
ii) 20 % da área bruta afeta às utilizações-tipo VIII, X e XII;"""@pt-PT ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "438" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeScopeCheck1-270f8487e6e780868261e5b876df9785> .

fbo-PT:OccupancyTypeScopeCheck2 a owl:Class ;
    rdfs:label "Check #2"@en,
        "Verificação n.º 2"@pt-PT ;
    rdfs:subClassOf fbo-PT:MixedOccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "alínea b) do n.º 3 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition """The general and specific provisions for the type of use to which they belong apply to spaces integrated into a given type of use, under the conditions indicated below, and no other provisions are applicable:
b) Spaces for meetings, religious worship, conferences and lectures, or where training activities, sports or leisure activities may be carried out, as well as restaurants and bars, provided that these spaces are managed under the responsibility of entities operating occupancy types III to XII and their capacity does not exceed 200 people in buildings or 1,000 people outdoors;"""@en,
        """Aos espaços integrados numa dada utilização-tipo, nas condições a seguir indicadas, aplicam-se as disposições gerais e as específicas da utilização-tipo onde se inserem, não sendo aplicáveis quaisquer outras:
b) Espaços de reunião, culto religioso, conferências e palestras, ou onde se possam ministrar ações de formação, desenvolver atividades desportivas ou de lazer e, ainda, os estabelecimentos de restauração e bebidas, desde que esses espaços sejam geridos sob a responsabilidade das entidades exploradoras de utilizações-tipo III a XII e o seu efetivo não seja superior a 200 pessoas, em edifícios, ou a 1000 pessoas, ao ar livre;"""@pt-PT ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "435" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeScopeCheck2-270f8487e6e78033a4f0c97cc03b928c> .

fbo-PT:OccupancyTypeScopeCheck3 a owl:Class ;
    rdfs:label "Check #3"@en,
        "Verificação n.º 3"@pt-PT ;
    rdfs:subClassOf fbo-PT:MixedOccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "alínea c) do n.º 3 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition """The general and specific provisions for the type of use to which they belong apply to spaces integrated into a given type of use, under the conditions indicated below, and no other provisions are applicable:
c) Commercial spaces, workshops, libraries and exhibition spaces, as well as medical, first aid and nursing stations, provided that they are managed under the responsibility of entities operating occupancy types III to XII and have a gross area not exceeding 200 m2."""@en,
        """Aos espaços integrados numa dada utilização-tipo, nas condições a seguir indicadas, aplicam-se as disposições gerais e as específicas da utilização-tipo onde se inserem, não sendo aplicáveis quaisquer outras:
c) Espaços comerciais, oficinas, bibliotecas e espaços de exposição, bem como postos médicos, de socorros e de enfermagem, desde que sejam geridos sob a responsabilidade das entidades exploradoras de utilizações-tipo III a XII e possuam uma área bruta não superior a 200 m2."""@pt-PT ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "441" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeScopeCheck3-270f8487e6e78099a4d3c9ff4cd04c0a> .

fbo-PT:OccupancyTypeVHealthcareandNursingHomes a owl:DatatypeProperty ;
    rdfs:label "OccupancyType V - Healthcare and Nursing Homes"@en,
        "Utilização-Tipo V - Hospitalares e lares de idosos"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea e) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings or parts of buildings open to the public, where education, teaching and training activities are carried out or recreational or educational activities are carried out for children and young people, which may or may not include resting or sleeping areas for participants in these actions and activities, namely schools at all levels of education, nurseries, kindergartens, training centers, leisure centers for children and young people and youth centers;"@en,
        "corresponde a edifícios ou partes de edifícios recebendo público, destinados à execução de ações de diagnóstico ou à prestação de cuidados na área da saúde, com ou sem internamento, ao apoio a pessoas idosas ou com condicionalismos decorrentes de fatores de natureza física ou psíquica, ou onde se desenvolvam atividades dedicadas a essas pessoas, nomeadamente hospitais, clínicas, consultórios, policlínicas, dispensários médicos, centros de saúde, de diagnóstico, de enfermagem, de hemodiálise ou de fisioterapia, laboratórios de análises clínicas, bem como lares, albergues, residências, centros de abrigo e centros de dia com atividades destinadas à terceira idade;"@pt-PT ;
    fbo:hasDesignator "UT V" ;
    fbo:hasEquivalentTerm "Use type V" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "299" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeV-Healthcare-and-Nursing-Homes-231f8487e6e780a48357d13492560b7a> ;
    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeVIIHotelsandRestaurants a owl:DatatypeProperty ;
    rdfs:label "OccupancyType VII - Hotels and Restaurants"@en,
        "Utilização-Tipo VII - Hoteleiros e Restauração"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea g) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings or parts of buildings, receiving the public, providing temporary accommodation or carrying out food and beverage activities, whether or not under exclusive occupation, namely those intended for tourist developments, local accommodation, where applicable, food and beverage establishments, dormitories and, when not part of a school establishment, student residences and vacation camps, excluding camping and caravanning sites, which are considered to be occupancy type IX spaces"@en,
        "Corresponde a edifícios ou partes de edifícios, recebendo público, fornecendo alojamento temporário ou exercendo atividades de restauração e bebidas, em regime de ocupação exclusiva ou não, nomeadamente os destinados a empreendimentos turísticos, alojamento local, quando aplicável, estabelecimentos de restauração ou de bebidas, dormitórios e, quando não inseridos num estabelecimento escolar, residências de estudantes e colónias de férias, ficando excluídos deste tipo os parques de campismo e caravanismo, que são considerados espaços da utilização-tipo IX"@pt-PT ;
    fbo:hasDesignator "UT VII" ;
    fbo:hasEquivalentTerm "Use type VII" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "306" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeVII-Hotels-and-Restaurants-231f8487e6e780ddb697ea5f437c125d> ;
    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeVIIIRetailandTransportHubs a owl:DatatypeProperty ;
    rdfs:label "OccupancyType VIII - Retail and Transport Hubs"@en,
        "Utilização-Tipo VIII - Comerciais e Gares de Transporte"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
