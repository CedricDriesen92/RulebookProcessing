fbo-DK:EmergencyPanicLights a owl:Class ;
    rdfs:label "Panikbelysning"@da-DK,
        "Emergency panic lights"@en ;
    rdfs:subClassOf fbo:EmergencyPanicLights,
        fbo-DK:ActiveFireProtection ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Belysning af gulvareal, der tænder ved svigt af den normale strømforsyning. Panikbelysning har til formål at give personer mulighed for at orientere sig i forbindelse med evakuering, så de kan finde vej til og orientere sig i flugtveje."@da-DK,
        "Floor area lighting that switches on when the normal power supply fails. Panic lighting is intended to allow people to orient themselves during an evacuation so that they can find their way to and orient themselves in escape routes."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Panic lighting" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "74" ;
    fbo:hasNotionURL <https://www.notion.so/EmergencyPanicLights-151f8487e6e7801e959bf123e1cb9c1a> .

