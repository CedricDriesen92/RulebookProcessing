    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Flugtvej, som personer intuitivt vil søge imod ved evakuering, typisk den normale adgangsvej til en bygning eller et rum."@da-DK,
        "Escape route that people will intuitively head towards during evacuation, typically the normal access route to a building or room."@en ;
