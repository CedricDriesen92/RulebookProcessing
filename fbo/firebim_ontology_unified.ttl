fbo-PT:IsolatedBuilding a owl:DatatypeProperty ;
    rdfs:label "Isolated buildings"@en,
        "Edifícios isolados"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID """n.º 20 do art.º 1º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition """From the point of view of the propagation of fire between façades, buildings that comply with one of the following characteristics:
a) Have façades facing other buildings at a distance of 8 m or more;
b) They have façades facing other buildings, provided that they comply with paragraph a) of Art. 7(8) of of Technical Regulation."""@en,
        """Do ponto de vista de propagação do fogo entre fachadas, edifícios que obedecem a uma das seguintes características:
a) Possuam fachadas em confronto com outros edifícios afastadas de uma distância igual ou superior a 8 m;
b) Possuam fachadas em confronto com outros edifícios, desde que cumpram a alínea a) do n.º 8 do art.º 7.º do RT-SCIE."""@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
