fbo-PT:Level a owl:Class ;
    rdfs:label "Level"@en,
        "Piso de um edifício"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "Nível ou elemento horizontal da construção, destinado ao uso humano ou técnico, situado entre a superfície de apoio inferior (piso do nível) e o teto ou laje do nível superior."@en,
        "Horizontal level or element of a building, intended for human or technical use, located between the lower support surface (floor of the level) and the ceiling or slab of the upper level."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "500" ;
