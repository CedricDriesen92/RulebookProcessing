    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Brandsikringstiltag, som indgår som en permanent integreret del af en bygning, og som ikke kræver aktivering for at fungere. F.eks. brandmæssig adskillelse, beklædning og inddækning eller brandmaling af bærende konstruktioner."@da-DK,
        "Fire protection measures that are a permanent integral part of a building and do not require activation to function. For example, fire separation, cladding and covering or fire painting of load-bearing structures."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Passive fire prevention" ;
    fbo:hasFireExpertValidation true ;
