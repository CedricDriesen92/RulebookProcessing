fbo-PT:FunctionCompartmentation a owl:DatatypeProperty ;
    rdfs:label "Compartmentation function"@en,
        "Função de compartimentação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.14" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a partitioning element to prevent the spread of fire (for example, by the passage of flames or hot gases - see airtightness) or by ignition beyond the exposed surface (see thermal insulation) during the relevant fire situation."@en,
        "Capacidade de um elemento de compartimentação para impedir a propagação do fogo (por exemplo, pela passagem de chamas ou de gases quentes – ver estanquidade) ou por ignição para além da superfície exposta (ver isolamento térmico) durante a situação de incêndio relevante."@pt-PT ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X12FireCompartmentBoundary ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:21:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "90" ;
    fbo:hasNotionURL <https://www.notion.so/FunctionCompartmentation-151f8487e6e7803c8034d6b0d2d77ba5> ;
    fbo:hasUnit "-" ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-PT:FunctionSpace a owl:Class ;
    rdfs:label "Function space"@en,
        "Uso de um espaço / local"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasExpertDefinition "Designação de um dado espaço de um piso de um edifício em termos de uso, podendo ser uma via horizontal (corredor), uma via vertical (escada), um ducto, uma câmara corta-fogo, uma fração autónoma, uma zona de refúgio ou um local (do tipo A, B, C, D, E ou F)."@en,
        "Designation of a given space on a floor of a building in terms of use, which may be a horizontal route (corridor), a vertical route (staircase), a shaft, a fire compartment, an autonomous fraction, a refuge area or a room (type A, B, C, D, E or F)."@pt-PT ;
    fbo:hasFireExpertEntity "Fire Expert" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "426" ;
    fbo:hasNotionURL <https://www.notion.so/FunctionSpace-268f8487e6e780e5b759e717b8ed22ba> .

fbo-PT:GableWall a owl:Class ;
    rdfs:label "Gable wall"@en,
        "Parede de empena"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "n.º 40 do art.º 1º do Anexo I ao RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Side wall of a building, without openings, with the function of insulation from adjacent buildings, whether existing or to be built."@en,
