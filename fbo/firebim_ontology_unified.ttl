    fbo:hasUnit "min/h" ;
    fbo:hasValueType "Number" .

fbo-LT:FacadeExteriorWall a owl:Class ;
    rdfs:label "Facade, exterior wall"@en,
        "Fasadas, išorinė siena"@lt-LT ;
    rdfs:subClassOf fbo:ExteriorWall ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.19." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "A vertical element of a building that separates the interior from the exterior. The facade includes transparent and non-transparent parts and their fastenings to the building structure."@en,
        "vertikalus pastato elementas, atskiriantis pastato vidų nuo išorės. Fasadas apima permatomas ir nepermatomas dalis ir jų sutvirtinimus prie statinio konstrukcijų."@lt-LT ;
    fbo:hasDocumentReference fbo-LT:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
