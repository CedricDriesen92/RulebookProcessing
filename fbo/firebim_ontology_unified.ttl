    fbo:hasNotionURL <https://www.notion.so/MaxBuildingStoreyFloorAreaOfConnectingStoreys-2c7f8487e6e7802db024dc649cf7c891> ;
    fbo:hasUnit "m2" ;
    fbo:hasValueType "Number" .

fbo-LT:MaximumAreaOfFireCompartment a owl:DatatypeProperty ;
    rdfs:label "Maximum area of fire compartment"@en,
        "Maksimalus gaisrinio skyriaus plotas"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Annex 3, Paragraph 1." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "The area of the fire compartment is determined according to the formula Fg = Fs·G·cos(90KH)"@en,
        "gaisrinio skyriaus plotas nustatomas pagal formulę Fg = Fs·G·cos(90KH)"@lt-LT ;
