    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Flugtveje, der uafhængigt af hinanden fører til terræn i det fri og er indbyrdes brandmæssigt adskilte i deres fulde udstrækning."@da-DK,
        "Escape routes that lead independently of each other to the terrain and are fire separated from each other to their full extent."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
        fbo:X2EVACUATION ;
