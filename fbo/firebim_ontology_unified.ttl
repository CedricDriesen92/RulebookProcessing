    rdfs:label "Exit"@en,
        "Saída"@pt-PT ;
    rdfs:subClassOf fbo:Exit ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 9 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Any space along the evacuation routes of a building that occupants must cross to get from where they are to a safe area."@en,
        "Qualquer vão disposto ao longo dos caminhos de evacuação de um edifício que os ocupantes devam transpor para se dirigirem do local onde se encontram até uma zona de segurança"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "363" ;
    fbo:hasNotionURL <https://www.notion.so/Exit-24ef8487e6e780f385d0f9700e5ca79f> .

fbo-PT:FireLoad a owl:DatatypeProperty ;
    rdfs:label "Fire load"@en,
        "Carga de incêndio"@pt-PT ;
    rdfs:subPropertyOf fbo:FireLoad ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.3.8" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The sum of the thermal energy released by the combustion of all combustible materials in a space (the building's contents and construction elements)."@en,
        "Soma da energia térmica libertada pela combustão de todos os materiais combustíveis existentes num espaço (o recheio do edifício e os elementos de construção)."@pt-PT ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "108" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoad-151f8487e6e7806ca29bd829af4a508a> ;
    fbo:hasUnit "MJ" ;
    fbo:hasValueType "Number" .

fbo-PT:FireLoadDensity a owl:DatatypeProperty ;
    rdfs:label "Fire load density"@en,
        "Densidade de carga de incêndio"@pt-PT ;
    rdfs:subPropertyOf fbo:FireLoadDensity ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.3.7" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Fire load per unit area of the floor surface (qf) or per unit area of the total envelope surface, including openings (qt)."@en,
        "Carga de incêndio por unidade de área da superfície do pavimento (qf), ou por unidade de área da superfície da envolvente total, incluindo as aberturas (qt)."@pt-PT ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "107" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoadDensity-151f8487e6e7806bbe83fac021aaea37> ;
    fbo:hasUnit "MJ/m^2" ;
    fbo:hasValueType "Number" .

fbo-PT:FireLoadDensityModified a owl:DatatypeProperty ;
    rdfs:label "Modified fire load density"@en,
        "Densidade da carga de incêndio modificada"@pt-PT ;
    rdfs:subPropertyOf fbo:FireLoadDensity ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Art. 2(h) do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "The fire load density affected by coefficients relating to the degree of danger and the fuel activation index, determined on the basis of the criteria referred to in Article 12(4);"@en,
        "A densidade da carga de incêndio é afetada por coeficientes relativos ao grau de perigo e ao índice de ativação do combustível, determinados com base nos critérios referidos no nº 4 do artigo 12º;"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegimeJurdicodaSeguranaContraIncndioemEdifcios,
        fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-03T14:43:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "88" ;
    fbo:hasNotionURL <https://www.notion.so/FireLoadDensityModified-151f8487e6e78037b8c7d97957453adc> ;
    fbo:hasRemarks "In Portugal, the fire load density is corrected by an activation risk and a combustibility coefficient and is called the modified load density." ;
    fbo:hasUnit "MJ/m^2" ;
    fbo:hasValueType "Number" .

fbo-PT:FireResistance a owl:DatatypeProperty ;
    rdfs:label "Fire Resistance"@en,
        "Resistência ao fogo"@pt-PT ;
    rdfs:subPropertyOf fbo:FireResistance ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.4" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a structure, part of a structure or element to perform its intended functions (load-bearing function and/or compartmentalisation function) for a specific load level, when subjected to a specific fire situation and for a specified period of time."@en,
        "Capacidade de uma estrutura, de parte de uma estrutura ou de um elemento para desempenhar as funções pretendidas (função de suporte de cargas e/ou função de compartimentação) para um nível de carga específico, quando sujeita a uma situação de incêndio específica e durante um período de tempo especificado."@pt-PT ;
    fbo:hasFireExpertEntity "European Standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "155" ;
    fbo:hasNotionURL <https://www.notion.so/FireResistance-151f8487e6e780dda0ecd4dd12ae95c8> ;
    fbo:hasRemarks "“3. GENERIC DEFINITION - WE ADD IT BECAUSE ITS A GENERIC DEFINITION AND ITS NOT RELATED DIRECTLY WITH THE BUILDING - NEED TO BE DISCUSTED" ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:FireStability a owl:DatatypeProperty ;
    rdfs:label "Fire Stability"@en,
        "Estabilidade ao fogo"@pt-PT ;
    rdfs:subPropertyOf fbo:FireStability ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.10" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Capacidade de uma estrutura ou de um elemento para resistir a acções específicas durante o incêndio relevante, de acordo com um critério definido."@pt-PT ;
    fbo:hasDesignator "R" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "146" ;
    fbo:hasNotionURL <https://www.notion.so/FireStability-151f8487e6e780c2813ad1929fdb8ea4> ;
    fbo:hasUnit "Minutes" ;
    fbo:hasValueType "Number" .

