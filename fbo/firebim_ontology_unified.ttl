fbo-PT:ExternalEvacuationRoute a owl:Class ;
    rdfs:label "External evacuation route"@en,
        "Via de evacuação exterior"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 16 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Protected evacuation route, outdoors or wide and permanently ventilated, which is sufficiently separated from the rest of the building or neighbouring buildings, either by distance or by construction elements whose standard fire resistance complies with the provisions of this regulation. This route may be entirely outside a building or partially embedded in it, in which case it must have an opening along the construction elements in contact with the outside, covering the entire space above the respective guardrail."@en,
        "Via de evacuação protegida, ao ar livre ou ampla e permanentemente ventilada, que está suficientemente separada do resto do edifício ou de edifícios vizinhos, quer em afastamento quer por elementos de construção cuja resistência ao fogo padrão está de acordo com o explicitado no presente regulamento. Esta via pode estar totalmente no exterior de um edifício ou nele parcialmente encastrada, devendo, neste caso, dispor de uma abertura, ao longo dos elementos de construção em contacto com o exterior, abrangendo todo o espaço acima da respetiva guarda"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:24:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "358" ;
    fbo:hasNotionURL <https://www.notion.so/ExternalEvacuationRoute-24ef8487e6e7809fafb9ea1ae9ff6b7e> .

fbo-PT:FireDamper a owl:DatatypeProperty ;
    rdfs:label "Fire damper"@en,
        "Registo resistente ao fogo"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID """n.º 11 do art.º 3º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Automatically operated damper with a given fire resistance rating determined by a standardized fire resistance test, intended to prevent the spread of fire or its effects through a duct or opening for a certain period of time."@en,
        "Registo de accionamento automático com uma dada qualificação de resistência ao fogo determinada em ensaio normalizado de resistência ao fogo padrão, destinado a impedir a propagação de um incêndio ou dos seus efeitos através de uma conduta ou de uma abertura, durante um certo período de tempo"@pt-PT ;
    fbo:hasDocumentReference fbo-PT:RegulamentoTcnicodeSeguranaContraIncndioemEdifcios ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertEntity "RT-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "92" ;
    fbo:hasNotionURL <https://www.notion.so/FireDamper-151f8487e6e7803f96b7d87e9ace33fa> ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:FireResistanceStandard a owl:DatatypeProperty ;
    rdfs:label "Standard fire resistance"@en,
        "Resistência ao fogo padrão"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.16" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a structure or part of a structure (usually just the elements) to fulfil its intended functions (structural resistance function and/or compartmentation function) in relation to heat exposure, according to the standard fire curve for a specified combination of actions and over a specified period of time."@en,
        "Capacidade de uma estrutura ou de parte de uma estrutura (normalmente apenas os elementos) para desempenhar as funções pretendidas (função de resistência estrutural e/ou função de compartimentação) relativamente à exposição ao calor, de acordo com a curva de incêndio padrão para uma combinação de acções especificada e durante um período de tempo específico."@pt-PT ;
    fbo:hasFireExpertEntity "European standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "70" ;
    fbo:hasNotionURL <https://www.notion.so/FireResistanceStandard-151f8487e6e780138a5ac6a9e0020080> ;
    fbo:hasRemarks "“3. GENERIC DEFINITION - WE ADD IT BECAUSE ITS A GENERIC DEFINITION AND ITS NOT RELATED DIRECTLY WITH THE BUILDING - NEED TO BE DISCUSTED" ;
    fbo:hasUnit "-" .

fbo-PT:FireScenario a owl:DatatypeProperty ;
    rdfs:label "Fire scenario"@en,
        "Cenário de incêndio"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.3.9" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Qualitative description of the evolution of a fire over time, identifying the main events that characterise the fire and differentiate it from other possible fires. It typically defines the ignition and growth process of the fire, the fully developed fire phase, the cooling phase, as well as the ambient conditions and building systems that will have an impact on the evolution of the fire."@en,
        "Descrição qualitativa da evolução de um incêndio com o tempo, identificando os principais acontecimentos que caracterizam o incêndio e o diferenciam de outros incêndios possíveis. Define, tipicamente, a ignição e o processo de crescimento do incêndio, a fase do incêndio totalmente desenvolvido, a fase de arrefecimento, assim como as condições ambientes e os sistemas do edifício que terão impacto na evolução do incêndio."@pt-PT ;
    fbo:hasFireExpertEntity "European standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "78" ;
    fbo:hasNotionURL <https://www.notion.so/FireScenario-151f8487e6e78027b0e5d10a364e3629> ;
    fbo:hasRemarks "“3. GENERIC DEFINITION - WE ADD IT BECAUSE ITS A GENERIC DEFINITION AND ITS NOT RELATED DIRECTLY WITH THE BUILDING - NEED TO BE DISCUSTED" ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:FireTightness a owl:DatatypeProperty ;
    rdfs:label "Fire tightness > Integrity"@en,
        "Estanquidade ao fogo"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "NP EN 1991-1-2: 2010 - 1.5.1.8" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Ability of a separating element of building construction, when exposed to fire on one side, to prevent the passage through it of flames and hot gases and to prevent the occurrence of flames on the unexposed side"@en,
        "Capacidade de um elemento de compartimentação de um edifício, quando exposto ao fogo de um lado, para impedir a passagem de chamas e de gases quentes através de si e para impedir a ocorrência de chamas no lado não exposto."@pt-PT ;
    fbo:hasDesignator "E" ;
    fbo:hasEquivalentTerm "Integrity" ;
    fbo:hasFireExpertEntity "European standard" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:21:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "98" ;
    fbo:hasNotionURL <https://www.notion.so/FireTightness-151f8487e6e7804cbd3ecce8684626ee> ;
    fbo:hasUnit "Minutes" ;
    fbo:hasValueType "Number" .

fbo-PT:FloorSpaceFactor a owl:Class ;
    rdfs:label "Floor Space Factor"@en,
        "Índice de Ocupação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Implicit definition" ;
    fbo:hasArticleID "n.º 1 do art.º 51º do RT-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Number of occupants per unit area depending on the use of the spaces"@en,
        "Número de ocupantes por unidade de área em função do uso dos espaços."@pt-PT ;
