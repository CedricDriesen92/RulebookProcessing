fbo-PT:ExitCapacity a owl:Class ;
    rdfs:label "Exit Capacity"@en,
        "Capacidade de evacuação de uma saída"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID """n.º 3 do art.º 4º do Anexo I ao
  RT-SCIE""" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Maximum number of people who can pass through this exit per unit of time"@en,
        "Número máximo de pessoas que podem passar através dessa saída por unidade de tempo"@pt-PT ;
