fbo-BE:FinishedFloor a owl:Class ;
    rdfs:label "Finished floor"@en,
        "Afgewerkte vloer"@nl-BE ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Artikel 1.9" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "horizontal wall that forms the separation between one floor of a building and the immediately higher or immediately lower floor; this wall usually comprises the following three components (a) the floor covering (possibly composed of : rokken, insulation layers, floating floors,…) (b) the unfinished floor (c) the ceiling. Parts (a) and (c) may not exist."@en,
        "horizontale wand die de scheiding vormt tussen een bouwlaag van een gebouw en de onmiddellijk hogere of onmiddellijk lagere bouwlaag; deze wand omvat gewoonlijk de volgende drie onderdelen (a) de vloerbedekking (eventueel samengesteld uit: rokken, isolatielagen, zwevende vloeren, …) (b) de onafgewerkte vloer (c) het plafond. Het is mogelijk dat de delen (a) en (c) niet bestaan."@nl-BE ;
    fbo:hasDocumentReference fbo-BE:KBARApp1Terminology ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-01-06T12:09:00+00:00"^^xsd:dateTime ;
