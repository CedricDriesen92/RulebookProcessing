    fbo:hasNotionURL <https://www.notion.so/SmokeResisitance-24ff8487e6e7806b8ab1fcc3a66f7107> .

fbo-NL:SpaceOutdoor a owl:Class ;
    rdfs:label "outdoor space"@en,
        "buitenruimte"@nl-NL ;
