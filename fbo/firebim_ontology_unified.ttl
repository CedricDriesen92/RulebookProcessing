    rdfs:label "Building Information"@en,
        "Informação do edifício"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "É o conjunto de dados alfanuméricos e geométricos associados aos elementos do edifício, incluindo propriedades técnicas, características físicas, especificações de materiais e informações de desempenho que o descrevem ao longo do seu ciclo de vida."@pt-PT ;
    fbo:hasFireExpertEntity "It is the set of alphanumeric and geometric data associated with building elements, including technical properties, physical characteristics, material specifications, and performance information that describes it throughout its life cycle." ;
    fbo:hasFireExpertValidation true ;
