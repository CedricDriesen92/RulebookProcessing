fbo-PT:OccupancyTypeIIGaragesandCarParks a owl:DatatypeProperty ;
    rdfs:label "OccupancyType II - Garages and Car Parks"@en,
        "Utilização-Tipo II - Estacionamentos"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea b) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings or parts of buildings intended exclusively for the collection of vehicles and their trailers off the public highway, or enclosed open-air spaces for the same purpose"@en,
        "Corresponde a edifícios ou partes de edifícios destinados exclusivamente à recolha de veículos e seus reboques, fora da via pública, ou recintos delimitados ao ar livre, para o mesmo fim"@pt-PT ;
    fbo:hasDesignator "UT II" ;
    fbo:hasEquivalentTerm "Use type II" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
