    fbo:hasDefinition "Stablingshøjden er defineret som afstanden fra gulvets overside i et rum til overkanten af oplag"@da-DK,
        "Stacking height is defined as the distance from the top of the floor in a room to the top edge of storage"@en ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
