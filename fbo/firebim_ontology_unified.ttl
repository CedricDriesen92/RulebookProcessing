fbo-DK:BuildingsectionOffices a owl:DatatypeProperty ;
    rdfs:label "Kontor"@da-DK,
        "Offices"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-B03" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Bygningsafsnit med kontorer forstås, at bygningsafsnittet er indrettet med cellekontorer og/eller åbne kontorer (som f.eks. storrumskontorer), med dertil hørende støttefunktioner, som eksempelvis toiletter, garderobe, mødelokaler, kantine, tekøkken og opbevaringsrum (arkiver, serverrum, kopirum mv.)"@da-DK,
        "A building section with offices means that the building section is equipped with cellular offices and/or open offices (such as open-plan offices), with associated support functions such as toilets, cloakroom, meeting rooms, canteen, kitchenette and storage rooms (archives, server rooms, copy rooms, etc.)"@en ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Office space" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "93" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingsectionOffices-151f8487e6e78044ad0fdfc509de8863> ;
    fbo:hasUnit "[-]" .

fbo-DK:CompartmentSleeping a owl:DatatypeProperty ;
    rdfs:label "Soverumsafsnit"@da-DK,
        "Sleeping section"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Et eller flere soverum med tilhørende gange, herunder flugtveje, depotrum, opholdsrum og evt. vagtrum samt andre lokaler med direkte tilknytning til de pågældende soverum."@da-DK,
        "One or more bedrooms with associated corridors, including escape routes, storage rooms, living rooms and possibly guard rooms, as well as other rooms directly connected to the bedrooms in question."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Bedroom section, Sleeping area, Bedroom area" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "84" ;
    fbo:hasNotionURL <https://www.notion.so/CompartmentSleeping-151f8487e6e78030a27cf1e4dbf00b10> ;
    fbo:hasUnit "[-]" .

fbo-DK:DistanceBlindEnd a owl:DatatypeProperty ;
    rdfs:label "Længde på blind ende"@da-DK,
        "Distance Blind End"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-K02" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Gangafstand målt via gangarealer, der har adgang til en udgang i én retning. Afstanden måles parallelt med væggen og fra midt dør til midt dør"@da-DK,
        "Walking distance measured via walkways that have access to an exit in one direction. Distance is measured parallel to the wall and from centerline of one door tocenterline of next door"@en ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Blind end length, Length of dead end" ;
    fbo:hasFireExpertGuidance "The how to measure is shown in BR18-VK5-K02-Figur2.18" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:20:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "286" ;
    fbo:hasNotionURL <https://www.notion.so/DistanceBlindEnd-22cf8487e6e7807cb209d564f24e8466> ;
    fbo:hasValueType "Number" .

fbo-DK:DoorIndependentExitdoors a owl:ObjectProperty ;
    rdfs:label "Uafhængige udgangsdøre"@da-DK,
        "Independent exit doors"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Udgangsdøre, der er placeret med tilstrækkelig indbyrdes afstand der sikrer, at mindst en af udgangsdørene er tilgængelig i tilfælde af brand i den brandmæssige enhed."@da-DK,
        "Exit doors spaced sufficiently far apart to ensure that at least one of the exit doors is accessible in case of fire in the fire compartment or sub fire compartment"@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Independent escape doors, Independent entrance doors" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "110" ;
    fbo:hasNotionURL <https://www.notion.so/DoorIndependentExitdoors-151f8487e6e78074ba7ef53efaae1d99> .

