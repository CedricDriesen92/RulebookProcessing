fbo-PT:OccupancyTypeScope a owl:Class ;
    rdfs:label "OccupancyTypeScope"@en,
        "Âmbito das Utilizações-tipo"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "A \"utilização-tipo\" classifica os edifícios e recintos em doze categorias distintas conforme a sua ocupação e uso específico (habitacional, estacionamento, administrativo, escolar, hospitalar, espetáculos, comercial, entre outros), determinando os requisitos de segurança contra incêndio aplicáveis a cada uma."@en,
        "“Occupancy type” classifies buildings and premises into twelve distinct types according to their specific occupation and use (residential, parking, administrative, educational, hospital, entertainment, commercial, among others), determining the fire safety requirements applicable to each one."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-13T10:22:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "547",
        "556" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeScope-302f8487e6e7800a8506de1ef0006eed>,
        <https://www.notion.so/OccupancyTypeScope-302f8487e6e780fa917ceb7296af38ec> .

