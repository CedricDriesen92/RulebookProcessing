    fbo:hasNotionURL <https://www.notion.so/RoofCoverings-214f8487e6e78096a1dff2334b769db7> ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-LT:SeparateFunction a owl:DatatypeProperty ;
    rdfs:label "Separate function"@en,
        "Atskiriamoji funkcija"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.68." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "the ability of an element to prevent the spread of fire and/or smoke for a certain period of time due to the penetration of flames or hot gases (integrity, tightness) or ignition (thermal insulation) behind it."@en,
        "elemento gebėjimas tam tikrą laiką neleisti plisti gaisrui ir (arba) dūmams dėl liepsnos ar karštų dujų prasiskverbimo (vientisumas, sandarumas) ar užsidegimo (šiluminė izoliacija) už jo."@lt-LT ;
    fbo:hasDocumentReference fbo-LT:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "268" ;
    fbo:hasNotionURL <https://www.notion.so/SeparateFunction-214f8487e6e780f48869f81d8aa71e80> ;
    fbo:hasValueType "Boolean (yes/no)" .

fbo-LT:SmokeAndHeatVentilationEquipment a owl:Class ;
    rdfs:label "Smoke and heat ventilation equipment"@en,
        "Dūmų ir šilumos vėdinimo įranga"@lt-LT ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "Chapter II, Paragraph 10.70." ;
    fbo:hasCountry fbo:Lithuania ;
    fbo:hasCountryCode "LT" ;
    fbo:hasDefinition "A system designed to improve the removal of combustible gases and heat from a building in the event of a fire. Smoke and heat are removed by mechanical ventilation equipment and/or natural convection."@en,
        "sistema, kurios paskirtis – gerinti gaisro išskiriamų degiųjų dujų ir šilumos šalinimą iš statinio. Dūmai ir šiluma šalinami mechanine vėdinimo įranga ir (arba) natūraliąja konvekcija."@lt-LT ;
    fbo:hasDocumentReference fbo-LT:StatybostechninireikalavimreglamentasSTR2010121999esminiaistatinioreikalavimaigaisrinsaugaNr422 ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "207" ;
    fbo:hasNotionURL <https://www.notion.so/SmokeAndHeatVentilationEquipment-214f8487e6e7803b86cdeec7b28a5561> ;
    fbo:hasValueType "Boolean (yes/no)" .

