fbo-DK:SystemIndependentExit a owl:ObjectProperty ;
    rdfs:label "Uafhængige udgange"@da-DK,
        "Independent exits"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-K01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Uafhængige udgange forstås som udgange, der er placeret mindst 5 m fra hinanden, så en brand under evakuering af
brandcellen ikke kan spærre flere udgange. Dermed kan to uafhængige udgange føre til samme flugtvej."""@da-DK,
        """Independent exits are defined as exits that are located at least 5 metres apart so that a fire during evacuation of
the fire subcompartment cannot block multiple exits. This means that two independent exits can lead to the same escape route."""@en ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Independent outputs, Independent outlets" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "99" ;
    fbo:hasNotionURL <https://www.notion.so/SystemIndependentExit-151f8487e6e7804db6bfc5fbafee8324> .

