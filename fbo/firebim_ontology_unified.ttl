fbo-BE:BVR26042024 a owl:NamedIndividual,
        fbo:Document ;
    rdfs:label "BVR 26/04/2024"@en ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasDescription "Besluit van de Vlaamse Regering tot vaststelling van de specifieke brandveiligheidsnormen waaraan lokale dienstencentra, centra voor dagverzorging, centra voor dagopvang, centra voor kortverblijf, centra voor herstelverblijf, groepen van assistentiewoningen en woonzorgcentra moeten voldoen en tot bepaling van de procedure voor de uitreiking van het attest van naleving van die normen"@en ;
    fbo:hasDocumentType "regulation" ;
    fbo:hasOriginalLanguage "nl-BE" ;
    fbo:hasOriginalName "Decision of the Flemish Government laying down the specific fire safety standards to be met by local service centres, day care centres, day care centres, short-term care centres, rehabilitation centres, groups of assisted living housing and residential care centres and determining the procedure for issuing the certificate of compliance with those standards"@nl-BE ;
    fbo:hasPublicationDate "2024-04-26"^^xsd:date ;
    fbo:hasURL <https://codex.vlaanderen.be/PrintDocument.ashx?id=1039871&datum=&geannoteerd=false&print=false> .

fbo-BE:BuildingLayerParking a owl:Class ;
    rdfs:label "Parking Building layer"@en,
        "parkeerbouwlaag"@nl-BE ;
    fbo:hasArticleID "Artikel 1.11" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "this refers to the space between the floor and the ceiling above. The floors below level EI are the basement floors and are not eligible for determining the number of floors in a building"@en,
        "ruimte van de parking tussen een vloer en een plafond die de parkeerzones voor voertuigen, de circulatiewegen en eventuele lokalen omvat. De vloer van deze ruimte kan horizontaal of hellend zijn."@nl-BE ;
    fbo:hasDocumentReference fbo-BE:KBARApp1Terminology ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-01-22T10:44:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "532" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingLayerParking-2f0f8487e6e78059a8fcf594c5c38541> .

