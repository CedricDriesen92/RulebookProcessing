fbo-PT:ExclusiveOccupancyType a owl:Class ;
    rdfs:label "Exclusive Occupancy Type"@en,
        "Utilização Tipo Exclusiva"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "n.º 2 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Depending on their use, buildings and premises may be for exclusive use when they are integrated into a single type of occupancy."@en,
