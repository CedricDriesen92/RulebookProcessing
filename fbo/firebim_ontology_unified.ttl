fbo-PT:OccupancyTypeVIPublicEntertainmentandAssembly a owl:DatatypeProperty ;
    rdfs:label "OccupancyType VI - Public Entertainment and Assembly"@en,
        "Utilização-Tipo VI - Espetáculos e reuniões públicas"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea f) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings, parts of buildings, itinerant or temporary venues and open-air venues that receive the public, intended for shows, public meetings, the showing of audiovisual media, dances, games, conferences, lectures, religious worship and exhibitions, whether or not they can be multipurpose, multipurpose and carry out the above activities on a non-permanent basis, namely theaters, cinemas, coliseums, bullrings, circuses, gambling halls, dance halls, nightclubs, bars with live music, recording studios, auditoriums, conference rooms, religious temples, multi-purpose pavilions and exhibition venues not classifiable under occupancy type X"@en,
        "Corresponde a edifícios ou partes de edifícios recebendo público, destinados à execução de ações de diagnóstico ou à prestação de cuidados na área da saúde, com ou sem internamento, ao apoio a pessoas idosas ou com condicionalismos decorrentes de fatores de natureza física ou psíquica, ou onde se desenvolvam atividades dedicadas a essas pessoas, nomeadamente hospitais, clínicas, consultórios, policlínicas, dispensários médicos, centros de saúde, de diagnóstico, de enfermagem, de hemodiálise ou de fisioterapia, laboratórios de análises clínicas, bem como lares, albergues, residências, centros de abrigo e centros de dia com atividades destinadas à terceira idade;"@pt-PT ;
    fbo:hasDesignator "UT VI" ;
    fbo:hasEquivalentTerm "Use type VI" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "298" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeVI-Public-Entertainment-and-Assembly-231f8487e6e780999329e3343bd24f8d> ;
