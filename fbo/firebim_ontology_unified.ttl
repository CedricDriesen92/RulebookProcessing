fbo-BE:HeightBuilding a owl:DatatypeProperty ;
    rdfs:label "Height of the building"@en,
        "hoogte van een gebouw"@nl-BE ;
    rdfs:subPropertyOf fbo:HeightBuilding ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Artikel 1.2.1" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "the height of a building is conventionally the distance between the finished floor level of the highest bulding layer and the lowest level of the roads usable by fire engines around the building"@en,
        "de hoogte van een gebouw is conventioneel de afstand tussen het afgewerkte vloerpeil van de hoogste bouwlaag en het laagste peil van de door de brandweerwagens bruikbare wegen omheen het gebouw"@nl-BE ;
    fbo:hasDocumentReference fbo-BE:KBARApp1Terminology ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-02-10T08:15:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "323" ;
    fbo:hasNotionURL <https://www.notion.so/HeightBuilding-232f8487e6e7809c9d10d1520d75dbd7> .

