fbo-PT:AreaCompartmentCompliance a owl:Class ;
    rdfs:label "AreaCompartmentCompliance"@en,
        "Conformidade da área de compartimentação"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "The compliance of the compartmentalization area is verified when the area of each fire compartment of the building does not exceed the maximum values established in the regulation according to the type of use, risk category, and characteristics of the building."@en,
        "A conformidade da área de compartimentação verifica-se quando a área de cada compartimento corta-fogo do edifício não excede os valores máximos estabelecidos no regulamento em função da utilização-tipo, categoria de risco e características do edifício."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-24T09:23:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "554" ;
    fbo:hasNotionURL <https://www.notion.so/AreaCompartmentCompliance-302f8487e6e7801b9431c61a309a7c9a> .

fbo-PT:AreaCompartmentException a owl:Class ;
    rdfs:label "Area Compartmentation Exception"@en,
        "Área de compartimentação - excepção"@pt-PT ;
    fbo:hasAdoptedDefinitionType "Expert definition" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasExpertDefinition "The exception to the compartmentation area allows, under certain specific conditions set out in the regulation, buildings to have fire compartmentation areas exceeding the maximum limits established, in specific cases or through the adoption of additional safety measures."@en,
        "A exceção à área de compartimentação permite que, em determinadas condições específicas previstas no regulamento, os edifícios possam ter áreas de compartimentação corta-fogo superiores aos limites máximos estabelecidos, em casos específicos ou mediante a adoção de medidas suplementares de segurança."@pt-PT ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-24T09:23:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "553" ;
    fbo:hasNotionURL <https://www.notion.so/AreaCompartmentException-302f8487e6e780729d1eda12acb58255> .

