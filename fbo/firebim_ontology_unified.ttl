    fbo:hasDefinition "Frie bredde i flugtveje skal minimum være 10 mm for hver person, som brandcellen eller flugtvejen er beregnet til."@da-DK,
        "Clear width in escape routes must be at least 10 mm for each person the subcompartment or escape route is intended for."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
