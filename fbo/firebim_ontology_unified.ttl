    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Åbning til det fri i et opholdsrum, f.eks. vindue, lem og altandør, som benyttes i forbindelse med redningsberedskabets redningsindsats eller redning ved egen hjælp i situationer, hvor personerne i rummet er afskåret fra at benytte flugtvejene."@da-DK,
        "An opening to the outside of a occupied room, such as a window, hatch and balcony door, which is used for emergency rescue or self-help rescue in situations where the occupants of the room are prevented from using the escape routes."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
