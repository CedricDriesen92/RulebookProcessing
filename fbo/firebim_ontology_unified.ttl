    rdfs:label "Ceiling"@en,
        "Plafond"@nl-BE ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Artikel 1.8" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "building element covering the subsurface of the floor or roof and its supporting structure, consisting of suspensions, fixings and any insulation material. The ceiling can be attached directly to the building’s structural elements or be a suspended ceiling"@en,
        "bouwelement dat het ondervlak van de vloer of van het dak bedekt en zijn draagstructuur bestaande uit de ophangingen, de bevestigingen en het eventuele isolatiemateriaal. Het plafond kan onmiddellijk tegen de structurele elementen van het gebouw bevestigd worden of een verlaagd plafond zijn."@nl-BE ;
    fbo:hasDocumentReference fbo-BE:KBARApp1Terminology ;
    fbo:hasFireExpertValidation false ;
    fbo:hasIFCMapping fbo-ifc:Ceiling ;
    fbo:hasLastEdition "2026-02-03T14:37:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "309" ;
    fbo:hasNotionURL <https://www.notion.so/Ceiling-232f8487e6e78014bd15eb46e640cf61> .

