    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeIIIAdministrative a owl:DatatypeProperty ;
    rdfs:label "OccupancyType III - Administrative"@en,
        "Utilização-Tipo III - Administrativos"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea c) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings or parts of buildings where administrative, customer service or service activities are carried out, namely offices, public offices, courts, registry offices, service counters, notaries, offices of liberal professionals, research spaces not dedicated to teaching, security and rescue force posts, excluding repair and maintenance workshops"@en,
        "Corresponde a edifícios ou partes de edifícios onde se desenvolvem atividades administrativas, de atendimento ao público ou de serviços, nomeadamente escritórios, repartições públicas, tribunais, conservatórias, balcões de atendimento, notários, gabinetes de profissionais liberais, espaços de investigação não dedicados ao ensino, postos de forças de segurança e de socorro, excluindo as oficinas de reparação e manutenção;"@pt-PT ;
    fbo:hasDesignator "UT III" ;
    fbo:hasEquivalentTerm "Use type III" ;
    fbo:hasFireExpertEntity "RJ-SCIE" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "295" ;
    fbo:hasNotionURL <https://www.notion.so/OccupancyTypeIII-Administrative-231f8487e6e7807e9dc3c52f26feea1f> ;
    fbo:hasRemarks "In Nota Técnica nº 5, referenced herein, the legislator lists several examples of uses for each use type." ;
    fbo:hasUnit "Choice" ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-PT:OccupancyTypeIResidentialbuildings a owl:DatatypeProperty ;
    rdfs:label "OccupancyType I - Residential buildings"@en,
        "Utilização-Tipo I - Habitacionais"@pt-PT ;
    rdfs:subPropertyOf fbo-PT:OccupancyType ;
    fbo:hasAdoptedDefinitionType "Explicit Definition" ;
    fbo:hasArticleID "alínea a) do nº 1 do art.º 8º do RJ-SCIE" ;
    fbo:hasCountry fbo:Portugal ;
    fbo:hasCountryCode "PT" ;
    fbo:hasDefinition "Buildings or parts of buildings intended for single-family or multi-family housing, including common access spaces and non-residential areas reserved for the exclusive use of residents"@en,
        "Corresponde a edifícios ou partes de edifícios destinados a habitação unifamiliar ou multifamiliar, incluindo os espaços comuns de acessos e as áreas não residenciais reservadas ao uso exclusivo dos residentes;"@pt-PT ;
    fbo:hasDesignator "UT I" ;
    fbo:hasEquivalentTerm "Use type I" ;
