fbo-DK:FireCompartment a owl:Class ;
    rdfs:label "Brandsektion"@da-DK,
        "Fire Compartment"@en ;
    rdfs:subClassOf fbo:FireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "En brandmæssigt fritliggende bygning eller et afgrænset område af en bygning, som er udført med brandsektionsadskillelser mod andre rum og bygninger. En brandsektion består af en eller flere brandceller."@da-DK,
        "A detached (in terms of fire spread) building or a defined area of a building that is constructed with fire compartment separations from other rooms and buildings. A fire compartment consists of one or more Subcompartments."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire section, Fire division" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "130" ;
    fbo:hasNotionURL <https://www.notion.so/FireCompartment-151f8487e6e78099a790f6834c50080d> ;
    fbo:hasUnit "[-]" ;
    fbo:isLinkedTo fbo:FireCompartment .

fbo-DK:FireCompartmentSubcompartment a owl:DatatypeProperty ;
    rdfs:label "Brandcelle"@da-DK,
        "Compartment - Subcompartment"@en ;
    rdfs:subPropertyOf fbo:FireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
