fbo-BE:AreaTriplex a owl:Class ;
    rdfs:label "Area of triplex compartment"@en,
        "oppervlakte van een triplex"@nl-BE ;
    fbo:hasAdoptedDefinitionType "Implicit definition" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "the cumulative gross area of the building layers that form the triplex, measured between the inner surfaces of the compartment boundaries"@en,
        "de gecumuleerde bruto-oppervlakte van de bouwlagen die de triples vormen, gemeten tussen de binnenvlakken van de compartimentswanden."@nl-BE ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-02-20T14:48:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "327" ;
    fbo:hasNotionURL <https://www.notion.so/AreaTriplex-232f8487e6e780adb699f7b0c4b07bc9> .

fbo-BE:Atrium a owl:DatatypeProperty ;
    rdfs:label "Compartment-type:Atrium"@en,
        "Compartment-type:Atrium"@nl-BE ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "CEN/TR 12101-5" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "Enclosed space, not necessarily vertically aligned, passing through two or more storeys in a building. Lift wells, escalator shafts, building services ducts and protected stairways are not classified as atria"@en,
        "Compartiment dat over 2 of meerdere bouwlagen loopt, er is niet noodzakelijk een trap binnen dit compartiment die de verschillende bouwlagen verbindt"@nl-BE ;
    fbo:hasDomainReference fbo:X10AssignCompartment,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-01-22T10:50:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "169" ;
    fbo:hasNotionURL <https://www.notion.so/Atrium-151f8487e6e780fe96fac4395c76f657> ;
    fbo:hasRemarks "not defined in legislation but definition in standard CEN/TR 12101-5" ;
    fbo:hasValueType "Boolean (yes/no)" .

