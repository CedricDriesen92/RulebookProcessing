    fbo:hasUnit "[-]" .

fbo-DK:RoomfunctionSafetyStaircase a owl:DatatypeProperty ;
    rdfs:label "Sikkerhedstrappe"@da-DK,
        "Emergency safety staircase"@en ;
    rdfs:subPropertyOf fbo-DK:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Flugtvejstrappe, der er udformet, så der er meget lille sandsynlighed for røgspredning til eller røgudvikling i trapperummet, for at opretholde funktionen som flugtvej og indtrængningsvej. Sikringen kan blandt andet omfatte, at trappen udføres med tryksætningsanlæg (ATA-anlæg) eller med adgang over luftsluse samt skærpede krav til overflader mv. i trapperummet."@da-DK,
        "Escape stairs designed to minimize the likelihood of smoke spreading to or developing in the stairwell in order to maintain its function as an escape and entry route. The safety measures may include, among other things, that the staircase is equipped with pressurization systems (ATA systems) or with access via an airlock and stricter requirements for surfaces etc. in the stairwell."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Safety staircase" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:11:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "152" ;
    fbo:hasNotionURL <https://www.notion.so/RoomfunctionSafetyStaircase-151f8487e6e780d5a338ef8a215e292d> ;
    fbo:hasUnit "[-]" .

