    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Ved køkken generelt forstås et rum til madlavning i boligenheder, herunder fælleskøkkener på kollegier og lignende."@da-DK,
        "Kitchen in general, means a cooking space in residential units, including communal kitchens in dormitories and the like."@en ;
    fbo:hasDocumentReference fbo-DK:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Kitchen facilities" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:17:00+00:00"^^xsd:dateTime ;
