fbo-BE:NumberOccupants a owl:Class ;
    rdfs:label "Number of occupants of a compartment"@en,
        "Aantal gebruikers van een compartiment"@nl-BE ;
    rdfs:subClassOf fbo:NumberOccupants ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "Artikel 1.6.2" ;
    fbo:hasCountry fbo:Belgium ;
    fbo:hasCountryCode "BE" ;
    fbo:hasDefinition "For rooms not accessible to the public, the number of users is at least equal to the surface area of the compartment/10. For rooms accessible to the public, the number of users is at least equal to the surface area of the compartment/3. If the number of users can be accurately determined based on fixed furniture, this surface area may be deducted. The number of users is then the sum of the accurately determined number and the number calculated based on the reduced surface area."@en,
        "Voor lokalen niet toegankelijk voor publiek is het aantal gebruikers ten minste gelijk aan de oppervlakte van het compartiment/10. Voor lokalen toegankelijk voor publiek is het aantal gebruikers ten minste gelijk aan de oppervlakte van het compartiment/3. Indien het aantal gebruikers nauwkeurig kan bepaald worden op basis van vast meubilair, mag dit oppervlak in mindering gebracht worden. Het aantal gebruikers is dan de som van het nauwkeurig bepaalde aantal en het aantal berekend op basis van de verminderde oppervlakte."@nl-BE ;
    fbo:hasDocumentReference fbo-BE:KBARApp1Terminology ;
    fbo:hasFireExpertValidation false ;
    fbo:hasLastEdition "2026-02-10T08:16:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "536" ;
    fbo:hasNotionURL <https://www.notion.so/NumberOccupants-2f0f8487e6e780f58c08d70e03c45212> .

