    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Brandslukningsmateriel udført som fast installation og tilsluttet bygningens normale vandforsyning. Bruges til en førsteindsats af personer i bygningen. Kan være udført med formfast eller flad slange."@da-DK,
        "Fire extinguishing equipment designed as a fixed installation and connected to the building's normal water supply. Used for first response by people in the building. Can be made with rigid or flat hose."@en ;
    fbo:hasDesignator "SLV" ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Snake winds, Snake coils, Snake windings, Serpentine winds" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:15:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "71" ;
    fbo:hasNotionURL <https://www.notion.so/HoseReel-151f8487e6e78013b015d88fcbbde463> ;
    qudt:hasApplicableUnit "-" .

