fbo-dk:EvacuationTime a owl:Class ;
    rdfs:label "Evakueringstid"@da-DK,
        "Evacuation time"@en ;
    rdfs:subClassOf fbo:EvacuationTime ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Den tid, der går fra brandens start til alle personer i bygningen befinder sig på terræn i det fri eller et sikkert sted i bygningen. Evakueringstiden er summen af detekterings-, varslings-, reaktions- og beslutningstid samt bevægelsestid."@da-DK,
        "The time from the start of the fire until all people in the building are on the terrain or in a safe refuge inside the building. Evacuation time is the sum of detection-, warning-, reaction-, decision and movement-time."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "128" ;
    fbo:hasNotionURL <https://www.notion.so/EvacuationTime-151f8487e6e78091a6fee46206c0ae52> ;
    fbo:hasValueType "Number" ;
    fbo:isLinkedTo fbo:EvacuationTime .

fbo-dk:Exit a owl:Class ;
    rdfs:label "Udgang"@da-DK,
        "Exit"@en ;
    rdfs:subClassOf fbo:Exit ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Dør i flugtvejssystem omfattende:
    - Dør til terræn i det fri
    - Dør til flugtvejstrappe
    - Dør til flugtvejsgang i anden brandsektion.
Begrebet anvendes også som en generel betegnelse for udgange, der benyttes i forbindelse med evakuering. Dette kan omfatte udgangsdøre, f.eks. i forbindelse med beregning af gangafstande i en brandmæssig enhed, eller åbninger i bygninger, herunder telte, der giver direkte adgang til terræn i det fri."""@da-DK,
        """Door in escape route system includes:
- Door to open-air terrain
- Door to escape staircase
- Door to escape route corridor in the second fire compartment.
The term is also used as a general term for exits used for evacuation purposes. This can include exit doors, for example when calculating walking distances in a fire compartment, or openings in buildings, including tents, that provide direct access to terrain."""@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Output, Outlet" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "96" ;
    fbo:hasNotionURL <https://www.notion.so/Exit-151f8487e6e7804a8935f1fb1c4d5edf> .

fbo-dk:FireCompartment a owl:Class ;
    rdfs:label "Brandsektion"@da-DK,
        "Fire Compartment"@en ;
    rdfs:subClassOf fbo:FireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "En brandmæssigt fritliggende bygning eller et afgrænset område af en bygning, som er udført med brandsektionsadskillelser mod andre rum og bygninger. En brandsektion består af en eller flere brandceller."@da-DK,
        "A detached (in terms of fire spread) building or a defined area of a building that is constructed with fire compartment separations from other rooms and buildings. A fire compartment consists of one or more Subcompartments."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire section, Fire division" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-04-22T11:48:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "130" ;
    fbo:hasNotionURL <https://www.notion.so/FireCompartment-151f8487e6e78099a790f6834c50080d> ;
    fbo:isLinkedTo fbo:FireCompartment ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:FireCompartmentSubcompartment a owl:Class ;
    rdfs:label "Brandcelle"@da-DK,
        "Compartment - Subcompartment"@en ;
    rdfs:subClassOf fbo:FireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Et eller flere rum, hvorfra branden ikke spredes til andre brandceller i den tid, der kræves til evakuering og redningsberedskabets redningsindsats i tilstødende brandceller."@da-DK,
        "One or more rooms from which the fire does not spread to other subcompartments during the time required for evacuation and rescue efforts in adjacent subcompartments."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire cell, Fire compartment" ;
    fbo:hasFireExpertValidation true ;
