    rdfs:label "Fri bredde flugtveje"@da-DK,
        "Free width Evacuation routes"@en ;
    rdfs:subClassOf fbo:WidthFreeEvacuationroutes ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-K02" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Frie bredde i flugtveje skal minimum være 10 mm for hver person, som brandcellen eller flugtvejen er beregnet til."@da-DK,
        "Clear width in escape routes must be at least 10 mm for each person the subcompartment or escape route is intended for."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X25WithoftheEvacuationPath,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Clear width escape routes" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "287" ;
    fbo:hasNotionURL <https://www.notion.so/WidthFreeEvacuationroutes-22cf8487e6e78086b241dcf8b8c8748c> .

fbo-dk:AutomaticFireAlarmsystem a owl:Class ;
    rdfs:label "ABA-anlæg"@da-DK,
        "Automatic Fire Alarm system"@en ;
    rdfs:subClassOf fbo:AutomaticFireAlarmsystem,
        fbo-dk:ActiveFireProtection ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anlæg, der indeholder ABA-central og detektorer, som ved detektering af røg-, varme- eller flammeudvikling automatisk tilkalder redningsberedskabet, samt eventuelt alarmtryk, der ved manuel aktivering tilkalder redningsberedskabet. Brandtekniske installationer kan kobles til et ABAanlæg, og ABA-anlægget vil derved være det styrende anlæg for de tilkoblede anlæg."@da-DK,
        "A system containing a fire alarm control centre and detectors that automatically call the emergency services when smoke, heat or flames are detected, as well as any alarm pressure that calls the emergency services when manually activated. Fire technical installations can be connected to a fire alarm system, and the fire alarm system will then be the controlling system for the connected systems."@en ;
    fbo:hasDesignator "ABA" ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Automatic fire alarm installations" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:AutomaticDetection ;
    fbo:hasLastEdition "2026-02-03T14:38:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "137" ;
    fbo:hasNotionURL <https://www.notion.so/AutomaticFireAlarmsystem-151f8487e6e780acb6a2ed6a6e96ab25> ;
    fbo:isLinkedTo fbo:AutomaticFireAlarmsystem .

fbo-dk:AutomaticFireSprinklersystem a owl:Class ;
    rdfs:label "AVS-anlæg"@da-DK,
        "Automatic sprinkler system"@en ;
    rdfs:subClassOf fbo-dk:ActiveFireProtection ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anlæg, der kontrollerer, dæmper eller slukker en brand ved brug af vand som slukningsmiddel. Et sprinkleranlæg består af vandforsyning, alarmventiler og rørsystem med sprinklere. Sprinklere er armaturer, der ved hjælp af spredeplader fordeler den dimensionerede vandtilstrømning på en forudbestemt måde over et bestemt areal. Sprinklere aktiveres oftest ved, at en væskefyldt glasbulb eller smelteled, som er placeret så den blokerer for vandtilstrømningen, opvarmes af branden og brydes ved en given temperatur. Sprinklere kan også være uden glasbulb eller smelteled, og vil da blive aktiveret ved ABA-detektering af røg eller flammer."@da-DK,
        "A system that controls, suppresses or extinguishes a fire using water as an extinguishing agent. A sprinkler system consists of a water supply, alarm valves and pipework with sprinklers. Sprinklers are fittings that distribute the designed water flow in a predetermined way over a specific area by means of  deflector plates. Sprinklers are usually activated when a liquid-filled glass bulb or fusible link, positioned to block the water flow,  is heated by the fire and breaking at a given temperature. Sprinklers can also be without a glass bulb or fusible link and will be activated by fire alarm system upon detection of smoke or flames."@en ;
    fbo:hasDesignator "AVS" ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Automatic water sprinkler system" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:AutomaticFireExtinguishSystem ;
    fbo:hasLastEdition "2026-02-03T14:38:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "120" ;
    fbo:hasNotionURL <https://www.notion.so/AutomaticFireSprinklersystem-151f8487e6e78089ab55f08e806a900a> ;
