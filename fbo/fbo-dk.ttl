    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Klasse nummereret fra 1-4. Risikoklassen fastlægges på baggrund af anvendelseskategori, byggeriets kompleksitet og risikoforhold ved evakuering og redning."@da-DK,
        "Classes numbered from 1 to 4. The risk class is determined based on the category of use, the complexity of the building and the risk factors involved in evacuation and rescue."@en ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:21:00+00:00"^^xsd:dateTime ;
