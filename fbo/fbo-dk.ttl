fbo-dk:DoorExit a owl:Class ;
    rdfs:label "Udgangsdør"@da-DK,
        "Exit door"@en ;
    rdfs:subClassOf fbo:DoorExit ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
