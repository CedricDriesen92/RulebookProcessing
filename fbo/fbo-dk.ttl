fbo-dk:RoomfunctionProductionskitchen a owl:Class ;
    rdfs:label "Produktionskøkken"@da-DK,
        "Production kitchen"@en ;
    rdfs:subClassOf fbo-dk:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Produktionskøkken er et storkøkken, der udgør en arbejdsplads, hvor der foregår tilberedning af mad ved brug af kogeplader, stegeplader, ovne, grill, friture og lignende."@da-DK,
        "Production kitchen is a commercial kitchen that is a workplace where food is prepared using hobs, griddles, ovens, grills, fryers and the like."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "86" ;
    fbo:hasNotionURL <https://www.notion.so/RoomfunctionProductionskitchen-151f8487e6e78031acc6cf58c33847ac> ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:RoomfunctionResidentialunit a owl:Class ;
    rdfs:label "Boenhed"@da-DK,
        "Residential unit"@en ;
    rdfs:subClassOf fbo-dk:Roomfunction ;
