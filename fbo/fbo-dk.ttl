    fbo:hasNotionID "149" ;
    fbo:hasNotionURL <https://www.notion.so/OpeningRescue-151f8487e6e780cdb450ccd328e79f80> .

fbo-dk:PassiveFireProtection a owl:Class ;
    rdfs:label "Passiv brandsikring"@da-DK,
        "Passive fire protection"@en ;
    rdfs:subClassOf fbo:PassiveFireProtection ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Brandsikringstiltag, som indgår som en permanent integreret del af en bygning, og som ikke kræver aktivering for at fungere. F.eks. brandmæssig adskillelse, beklædning og inddækning eller brandmaling af bærende konstruktioner."@da-DK,
        "Fire protection measures that are a permanent integral part of a building and do not require activation to function. For example, fire separation, cladding and covering or fire painting of load-bearing structures."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Passive fire prevention" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "167" ;
    fbo:hasNotionURL <https://www.notion.so/PassiveFireProtection-151f8487e6e780fba155d4bc6fded875> .

fbo-dk:PeopleKnowledgeEscaperoutes a owl:Class ;
    rdfs:label "Stedkendt person"@da-DK,
        "People with knowledge of escape routes"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Person, der har kendskab til bygningens eller bygningsafsnittets flugtveje. Enten i kraft af at personen er bekendt med bygningen (bygningsafsnittet), eller at bygningen (bygningsafsnittet) er så simpel og overskuelig, at flugtvejene umiddelbart kan identificeres."@da-DK,
        "Person who has knowledge of the escape routes of the building or functional fireunit. Either by virtue of the person being familiar with the building (Functional fireunit) or because the building (Functional fireunit) is so simple and clear that the escape routes can be immediately identified."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Authorised person, Recognised person, Substitute person, Person of interest" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "113" ;
    fbo:hasNotionURL <https://www.notion.so/PeopleKnowledgeEscape-routes-151f8487e6e7807887a4d9cc8eadd6fa> ;
    fbo:hasValueType "Boolean (yes/no)" ;
    qudt:hasApplicableUnit "Y/N" .

fbo-dk:PlaceSaferefuge a owl:Class ;
    rdfs:label "Sikkert sted"@da-DK,
        "Safe refuge"@en ;
    rdfs:subClassOf fbo:PlaceSaferefuge ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Område i en bygning, som personer kan evakuere til, og hvor de kan opholde sig i sikkerhed i forhold til branden. Fra det sikre sted kan der ske evakuering videre til terræn i det fri."@da-DK,
        "Area in a building to which people can evacuate and where they can stay safe from the fire. From the safe place, evacuation can be continued to the ground in the open."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Safe place, Secure location" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:15:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "134" ;
    fbo:hasNotionURL <https://www.notion.so/PlaceSaferefuge-151f8487e6e780a2a9a3f04bcdefb983> .

fbo-dk:RiskClass a owl:Class ;
    rdfs:label "Risikoklasse"@da-DK,
        "Risk class"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
