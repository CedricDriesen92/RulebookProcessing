    fbo:hasDefinition "Den del af bevægelsestiden, hvor personer tilbagelægger afstanden til terræn i det fri eller til et sikkert sted, eksklusiv eventuel køtid ved udgange og flaskehalse i flugtvejssystemet."@da-DK,
        "The portion of movement time during which people travel the distance to open terrain or to a safe refuge, excluding any queuing time at exits and congestion in the escape route system."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Travelling time" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:20:00+00:00"^^xsd:dateTime ;
