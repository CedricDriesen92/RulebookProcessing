    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Sammenhængende system af udgange, flugtvejsgange og flugtvejstrapper, som skal sikre, at personer kan evakuere en bygning på sikker vis."@da-DK,
        "Coherent system of exits, escape route corridor and emergency stairways to ensure that people can safely evacuate a building."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
