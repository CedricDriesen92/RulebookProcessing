fbo-dk:CompartmentSleeping a owl:Class ;
    rdfs:label "Soverumsafsnit"@da-DK,
        "Sleeping section"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Et eller flere soverum med tilhørende gange, herunder flugtveje, depotrum, opholdsrum og evt. vagtrum samt andre lokaler med direkte tilknytning til de pågældende soverum."@da-DK,
        "One or more bedrooms with associated corridors, including escape routes, storage rooms, living rooms and possibly guard rooms, as well as other rooms directly connected to the bedrooms in question."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Bedroom section, Sleeping area, Bedroom area" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "84" ;
    fbo:hasNotionURL <https://www.notion.so/CompartmentSleeping-151f8487e6e78030a27cf1e4dbf00b10> ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:DistanceActualTravel a owl:Class ;
    rdfs:label "Ganglængde"@da-DK,
        "Distance - Actual travel distance"@en ;
    rdfs:subClassOf fbo:DistanceActualTravel ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Den faktiske afstand, som en person skal gå i ganglinje for at nå et givent punkt. Ganglinjen udlægges som den direkte vej, under hensyn til faste forhindringer eller fast inventar, og på trædefast areal. Anvendes også om den fysiske længde af en gang."@da-DK,
        "The actual distance that a person must walk in a walking line to reach a given point. The walking line is laid out as the direct route, taking into account fixed obstacles or fixtures, and on a walkable surface. Also used to refer to the physical length of a corridor."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Aisle length, Gangway length, Walking distance, Gear length" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "85" ;
    fbo:hasNotionURL <https://www.notion.so/DistanceActualTravel-151f8487e6e780318ce5e17e203ed2e4> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M .

fbo-dk:DistanceBlindEnd a owl:Class ;
    rdfs:label "Længde på blind ende"@da-DK,
        "Distance Blind End"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-K02" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Gangafstand målt via gangarealer, der har adgang til en udgang i én retning. Afstanden måles parallelt med væggen og fra midt dør til midt dør"@da-DK,
        "Walking distance measured via walkways that have access to an exit in one direction. Distance is measured parallel to the wall and from centerline of one door tocenterline of next door"@en ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Blind end length, Length of dead end" ;
    fbo:hasFireExpertGuidance "The how to measure is shown in BR18-VK5-K02-Figur2.18" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:20:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "286" ;
    fbo:hasNotionURL <https://www.notion.so/DistanceBlindEnd-22cf8487e6e7807cb209d564f24e8466> ;
    fbo:hasValueType "Number" .

fbo-dk:DistanceDirectTravel a owl:Class ;
    rdfs:label "Gangafstand"@da-DK,
        "Distance - Direct travel distance (theoretical)"@en ;
    rdfs:subClassOf fbo:DistanceDirectTravel ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Den teoretisk længste afstand, som en person skal tilbagelægge for at nå frem til nærmeste udgang eller udgangsdør ved at bevæge sig langs ganglinjer. Ganglinjer udlægges svarende til den mest ugunstige placering af personen. I lokaler skal afstanden via ganglinjer, der kun fører til udgangsdør i én retning, multipliceres med 1,5."@da-DK,
        "The theoretical longest distance a person must travel to reach the nearest exit or exit door by moving along a path of travel. The paths are laid out corresponding to the most unfavorable location of the person. In rooms, the distance along paths leading to the exit door in one direction only should be multiplied by 1.5."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X22TravelDistance,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Walking distance, Gangway distance" ;
    fbo:hasFireExpertGuidance "The how to calculate are illustrated in BR18-VK5-K02-figur2.2" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "172" ;
    fbo:hasNotionURL <https://www.notion.so/DistanceDirectTravel-151f8487e6e780ff92c4cfcb580c9b7c> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M .

fbo-dk:DistancePathway a owl:Class ;
    rdfs:label "Ganglinje"@da-DK,
        "Distance - Pathway"@en ;
    rdfs:subClassOf fbo:DistancePathway ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Imaginær linje som man følger, når man f.eks. går hen mod en dør i et lokale, ned ad en gang eller på en trappe eller rampe. Hvor ganglinjen forløber langs skrå bygningselementer, f.eks. ramper eller trapper, udlægges ganglinjen som den skrå linje langs elementet fra øverste til nederste del."@da-DK,
        "Imaginary line that you follow when walking towards a door in a room, down a hallway or on a staircase or ramp, for example. Where the pathway runs along inclined building elements, such as ramps or stairs, the pathway is laid out as the inclined line along the element from top to bottom."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Hydrograph, Gangway, Aisle line" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "102" ;
    fbo:hasNotionURL <https://www.notion.so/DistancePathway-151f8487e6e7805a9013f4c4ea54de44> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M .

