fbo-dk:BoundaryFireCompartment a owl:Class ;
    rdfs:label "Brandsektionsadskillelse"@da-DK,
        "Fire compartment - boundary"@en ;
    rdfs:subClassOf fbo:BoundaryFireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "En væg eller etageadskillelse, der er udformet, så en brand ikke spredes til andre brandsektioner inden for den tid, der er nødvendig for evakuering og redningsberedskabets indsats."@da-DK,
        "A wall or floor construction designed to prevent a fire from spreading to other fire compartments within the time required for evacuation and emergency response."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire compartment separation" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "123" ;
    fbo:hasNotionURL <https://www.notion.so/BoundaryFireCompartment-151f8487e6e7808fb6c3f0b89dd68121> ;
    fbo:isLinkedTo fbo:BoundaryFireCompartment ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:BoundarySubcompartment a owl:Class ;
    rdfs:label "Brandcelleadskillelse"@da-DK,
        "Room - Subcompartment - boundary"@en ;
    rdfs:subClassOf fbo:BoundaryFireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Bygningsdel, f.eks. væg, etageadskillelse eller dør, som indgår ved etablering af en brandcelle."@da-DK,
        "Building element, e.g. wall, floor construction or door, which is used to create a fire compartment."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Fire cell separation, Fire compartment separation" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:10:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "125" ;
    fbo:hasNotionURL <https://www.notion.so/BoundarySubcompartment-151f8487e6e78090953bc8ffbac2f18f> ;
    fbo:isLinkedTo fbo:BoundaryFireCompartment ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:BuildingFireCompartmentDaytimeoccupancy a owl:Class ;
    rdfs:label "Dagophold"@da-DK,
        "Daytime occupancy buildings"@en ;
    rdfs:subClassOf fbo:BuildingFireCompartmentDaytimeoccupancy ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anvendelse som medfører, at der ikke er sovende personer i bygningen. Bygninger, der anvendes af vågne personer om natten, betragtes også som bygninger til dagophold."@da-DK,
        "Use classification that means that there are no sleeping persons in the building. Buildings used by people who are awake at night are also considered daytime occupancy buildings."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Day stay, Daycare" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-04-22T10:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "124" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingFireCompartmentDaytimeoccupancy-151f8487e6e780908a31f285f6bc52bd> ;
    fbo:hasValueType "Boolean (yes/no)" ;
    qudt:hasApplicableUnit "Y/N" .

fbo-dk:BuildingFunctionalFireUnit a owl:Class ;
    rdfs:label "Bygningsafsnit"@da-DK,
        "Functional Fire Unit"@en ;
    rdfs:subClassOf fbo:BuildingFunctionalFireUnit ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Bygning, eller del af en bygning, hvori de tilstedeværende brandmæssige
risikoforhold angivet ved anvendelseskategori(er) og risikoklasse er sammenlignelige. Et bygningsafsnit skal henføres til én eller flere anvendel
seskategorier, men kun én risikoklasse.
Et bygningsafsnit kan bestå af ét eller flere rum, og til et bygningsafsnit
hører også understøttende funktioner som for eksempel gange, køkken,
depotrum, teknikrum, toiletrum, baderum eller lignende, som har di
rekte tilknytning til bygningsafsnittets funktion.
Et bygningsafsnit kan indrettes som én eller flere brandsektioner, og skal
have adgang til tilknyttede flugtveje."""@da-DK,
        """A building, or part of a building, in which the existing fire
risk conditions indicated by use category(ies) and risk class are
similar. A Functional Fire Unit shall be assigned to one or more use
categories, but only one risk class.
A Functional Fire Unit may consist of one or more rooms, and a Functional Fire Unit
also includes supporting functions such as corridors, kitchens,
storage rooms, technical rooms, toilet rooms, bathrooms or similar, which are
directly related to the function of the Functional Fire Unit.
A Functional Fire Unit can be organised as one or more fire compartments and must have access to associated escape routes."""@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Building compartment, Building section" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-04-22T12:57:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "271" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingFunctionalFireUnit-21ff8487e6e780e9a2c0e11513d03987> ;
    qudt:hasApplicableUnit "[-]" .

