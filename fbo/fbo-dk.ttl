fbo-dk:BuildingsectionOffices a owl:Class ;
    rdfs:label "Kontor"@da-DK,
        "Offices"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-B03" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Bygningsafsnit med kontorer forstås, at bygningsafsnittet er indrettet med cellekontorer og/eller åbne kontorer (som f.eks. storrumskontorer), med dertil hørende støttefunktioner, som eksempelvis toiletter, garderobe, mødelokaler, kantine, tekøkken og opbevaringsrum (arkiver, serverrum, kopirum mv.)"@da-DK,
        "A building section with offices means that the building section is equipped with cellular offices and/or open offices (such as open-plan offices), with associated support functions such as toilets, cloakroom, meeting rooms, canteen, kitchenette and storage rooms (archives, server rooms, copy rooms, etc.)"@en ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Office space" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "93" ;
    fbo:hasNotionURL <https://www.notion.so/BuildingsectionOffices-151f8487e6e78044ad0fdfc509de8863> ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:CeilingSuspended a owl:Class ;
    rdfs:label "Nedhængt loft"@da-DK,
        "Suspended ceiling"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Loft placeret under loftsbeklædningen som ikke nødvendigvis opfylder kravene til den indvendige loftsbeklædning."@da-DK,
        "Ceiling located below the ceiling cladding that does not necessarily meet the requirements for the interior ceiling cladding."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasEquivalentTerm "Drop ceiling" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:Ceiling ;
