fbo-dk:AutomaticFireVentilationsystem a owl:Class ;
    rdfs:label "ABV-anlæg"@da-DK,
        "Automatic Fire Ventilationsystem"@en ;
    rdfs:subClassOf fbo:AutomaticFireVentilationsystem,
        fbo-dk:ActiveFireProtection ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anlæg til brandventilation af rum eller bygningsafsnit, der har til formål at fjerne røg og varme. Anlægget aktiveres automatisk ved detektering af brand."@da-DK,
        "Smoke and heat exhaust ventilation system for rooms or building compartments to remove smoke and heat. The system is automatically activated when a fire is detected."@en ;
    fbo:hasDesignator "ABV" ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
