fbo-dk:SystemIndependentEvacuationRoute a owl:Class ;
    rdfs:label "Uafhængige flugtveje"@da-DK,
        "Independent evacuation routes"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Flugtveje, der uafhængigt af hinanden fører til terræn i det fri og er indbyrdes brandmæssigt adskilte i deres fulde udstrækning."@da-DK,
        "Escape routes that lead independently of each other to the terrain and are fire separated from each other to their full extent."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X21NumberofDoorsExits,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Independent emergency escape routes" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "114" ;
    fbo:hasNotionURL <https://www.notion.so/SystemIndependentEvacuationRoute-151f8487e6e78078a26ec6de375fc343> .

fbo-dk:SystemIndependentExit a owl:Class ;
    rdfs:label "Uafhængige udgange"@da-DK,
        "Independent exits"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-K01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Uafhængige udgange forstås som udgange, der er placeret mindst 5 m fra hinanden, så en brand under evakuering af
brandcellen ikke kan spærre flere udgange. Dermed kan to uafhængige udgange føre til samme flugtvej."""@da-DK,
        """Independent exits are defined as exits that are located at least 5 metres apart so that a fire during evacuation of
the fire subcompartment cannot block multiple exits. This means that two independent exits can lead to the same escape route."""@en ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Independent outputs, Independent outlets" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "99" ;
    fbo:hasNotionURL <https://www.notion.so/SystemIndependentExit-151f8487e6e7804db6bfc5fbafee8324> .

