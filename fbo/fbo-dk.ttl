fbo-dk:IndustrialClass5 a owl:Class ;
    rdfs:label "Industri- og lagerklasse 5 (ILK5)"@da-DK,
        "Industrial and warehouse class 5"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-B10-1.4.4.5" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Bygningsafsnit i ILK 5 er defineret som bygningsafsnit, der er indrettet med:
• En brandbelastning som kan være større end 1.600 MJ/m2
, hvor
• Der kan forudsættes en ”meget hurtig” brandudvikling, α=0,118 kW/s2
, og som har
• En stablingshøjde på højst 40 m.
Dermed omfatter denne klasse alle lagerbygninger med blandet brændbart oplag, brændbar
emballage og en stablingshøjde mellem 8 m og 40 m."""@da-DK,
        """Building compartments in ILK 5 are defined as building compartments that are designed with:
- A fire load that can be greater than 1,600 MJ/m2
, where
- A ‘very fast’ fire development can be assumed, α=0.118 kW/s2
, and which has
- A stacking height of no more than 40 metres.
Thus, this class includes all warehouses with mixed combustible storage, combustible
packaging and a stacking height between 8 m and 40 m."""@en ;
    fbo:hasDesignator "ILK5" ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Industrial and storage class 5 (ILK5), Industrial and Warehouse Class 5 (ILK5)" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "307" ;
    fbo:hasNotionURL <https://www.notion.so/IndustrialClass5-231f8487e6e780e08093ee041e95dd9c> .

fbo-dk:LengthHosepath a owl:Class ;
    rdfs:label "Slangevej"@da-DK,
        "Distance - Hose path"@en ;
    rdfs:subClassOf fbo:LengthHosepath ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Afstand for trækning af redningsberedskabets slanger, der fastlægges svarende til ganglængden. Eventuelt bidrag fra ophaling af slange via durchsicht eller udvendig ophaling til indsats via trapperum skal medtages svarende til den lodrette afstand."@da-DK,
        "The distance for deploying fire service hoses, which is determined based on the actual travel distance. Any additional distance resulting from hoisting hoses through internal openings (durchsicht) or external hoisting to access via stairwells must also be included as the corresponding vertical distance"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasEquivalentTerm "Snake road, Serpentine road, Snake path" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:15:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "141" ;
    fbo:hasNotionURL <https://www.notion.so/LengthHosepath-151f8487e6e780b9b88cda41efc871d3> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M .

fbo-dk:NumberOccupantsEvacuationRoute a owl:Class ;
    rdfs:label "Personbelastning pr.evakueringsrute"@da-DK,
        "Number of Occupants per Evacuation route"@en ;
    fbo:hasAdoptedDefinitionType "Explicit and implicit definition" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Det antal personer, som den enkelte brandmæssige enhed er indrettet til, og som bl.a. angives på brandplaner og på pladsfordelingsplaner. Benyttes også som betegnelse for det dimensionsgivende antal personer, f.eks. angivet ved antal personer pr. m2 , som lægges til grund ved dimensionering af bredde af flugtveje, flugtvejspassager og døre til flugtveje samt ved evakueringsberegninger ved brandteknisk dimensionering."@da-DK,
        "The number of persons for which each fire safety unit is designed and which is indicated on fire plans and space allocation plans, among other things. This is also used to refer to the design occupant load, e.g. expressed as number of persons per m2 , which is used when dimensioning the width of escape routes, escape route passages and doors to escape routes as well as in evacuation calculations for fire engineering design."@en ;
    fbo:hasDomainReference fbo:X25WithoftheEvacuationPath,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Person load" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-04-22T13:12:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "366" ;
    fbo:hasNotionURL <https://www.notion.so/NumberOccupantsEvacuationRoute-24ff8487e6e78014b21ad3c18206b3fe> ;
    fbo:hasValueType "Number" .

