fbo-dk:FireSafetyInstallationSmokeAlarmsystem a owl:Class ;
    rdfs:label "Røgalarmanlæg"@da-DK,
        "Smoke alarm system"@en ;
    rdfs:subClassOf fbo:FireSafetyInstallationSmokeAlarmsystem ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anlæg, bestående af en eller flere forbundne røgalarmer, der detekterer røg og varsler i den brandmæssige enhed, f.eks. en bolig, hvor røgen opstår. Røgalarmanlæg er tilsluttet bygningens strømforsyning og forsynet med batteribackup."@da-DK,
        "System consisting of one or more interconnected smoke alarms that detect smoke and alert in the fire unit, e.g. a residence, where the smoke occurs. Smoke alarm systems are connected to the building's power supply and equipped with battery backup."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
