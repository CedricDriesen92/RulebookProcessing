    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Dør fra en brandmæssig enhed, der giver adgang til flugtvej eller direkte til terræn i det fri."@da-DK,
        "Door from a fire compartment that provides access to an escape route or directly to the terrain."@en ;
