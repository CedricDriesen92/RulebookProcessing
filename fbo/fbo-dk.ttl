fbo-dk:DoorIndependentExitdoors a owl:Class ;
    rdfs:label "Uafhængige udgangsdøre"@da-DK,
        "Independent exit doors"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Udgangsdøre, der er placeret med tilstrækkelig indbyrdes afstand der sikrer, at mindst en af udgangsdørene er tilgængelig i tilfælde af brand i den brandmæssige enhed."@da-DK,
        "Exit doors spaced sufficiently far apart to ensure that at least one of the exit doors is accessible in case of fire in the fire compartment or sub fire compartment"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
