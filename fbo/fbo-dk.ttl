fbo-dk:RoomfunctionEscaperouteCorridor a owl:Class ;
    rdfs:label "Flugtvejsgang"@da-DK,
        "Evacuation route corridor"@en ;
    rdfs:subClassOf fbo-dk:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Gang, der primært er indrettet til flugtvejsfunktion, og som giver adgang til en eller flere udgange. En flugtvejsgang indrettes i egen brandmæssige enhed, for at beskytte personer mod kritiske forhold under evakuering. Der er særlige krav til indretningen af flugtvejsgange og brandbelastning en en flugtvejsgang må højst være 50 MJ/m2, svarende til ultra lav brandbelastning"@da-DK,
        "A corridor that is primarily designed for escape route function and provides access to one or more exits. An escape route corridor is designed in its own fire compartment (nomaly a Subcompartment) to protect people from critical conditions during evacuation. There are special requirements for the design of escape routes and the fire load in an escape route must not exceed 50 MJ/m2, corresponding to ultra low fire load"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Escape route corridor, Escape route passageway" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:11:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "126" ;
    fbo:hasNotionURL <https://www.notion.so/RoomfunctionEscaperouteCorridor-151f8487e6e78091963dcb4545955bc5> ;
    fbo:isLinkedTo fbo:Roomfunction ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:RoomfunctionEscapestaircase a owl:Class ;
    rdfs:label "Flugtvejstrappe"@da-DK,
        "Emergency escape staircase"@en ;
    rdfs:subClassOf fbo-dk:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Trappe i flugtvej, som benyttes i tilfælde af evakuering, og som ofte også benyttes som redningsberedskabets indtrængningsvej. Er ofte placeret i sin egen brandmæssige enhed med udgang
  til terræn i det fri, evt. via et vindfang, for at sikre, at trappen bevarer sin funktion som flugtvej og indtrængningsvej i tilfælde af brand. Der må ikke henstilles oplag eller inventar i en flugtvejstrappe og rummet skal være uden brandbelastning"""@da-DK,
        "Stairs in an escape route used in the event of an evacuation and often also used as a fire brigade entry route. Often located in its own fire compartment with access to the ground outside, possibly via a vestibule, to ensure that the staircase retains its function as an escape and entry route in case of fire. No storage or furniture may be placed in an escape staircase and the space must be free of fire loads"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Escape route staircase, Escape stairs" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "163" ;
    fbo:hasNotionURL <https://www.notion.so/RoomfunctionEscapestaircase-151f8487e6e780f48f1af84303ea1cc3> ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:RoomfunctionKitchen a owl:Class ;
    rdfs:label "Køkken"@da-DK,
        "Kitchen"@en ;
    rdfs:subClassOf fbo-dk:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Ved køkken generelt forstås et rum til madlavning i boligenheder, herunder fælleskøkkener på kollegier og lignende."@da-DK,
        "Kitchen in general, means a cooking space in residential units, including communal kitchens in dormitories and the like."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Kitchen facilities" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "119" ;
    fbo:hasNotionURL <https://www.notion.so/RoomfunctionKitchen-151f8487e6e780838e7cfcb25eb89045> ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:RoomfunctionKitchenette a owl:Class ;
    rdfs:label "Te- eller anretterkøkken"@da-DK,
        "Kitchenette"@en ;
    rdfs:subClassOf fbo-dk:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Te- eller anretterkøkken er et rum uden varmeflader i form af ovn, kogeplade eller friture, men hvor der kan forefindes mikrobølgeovn, elkedel, opvaskemaskine, køleskab og kaffeautomater eller –maskiner. Denne type køkken, hvor der ikke produceres mad, anses ikke som et rum med en særlig brandfare. Tilsvarende mindre køkkener, hvor der indgår ovn, kogeplade eller friture, anses at udgøre en særlig brandfare og er dermed ikke et Te- eller anretterkøkken"@da-DK,
        "A kitchenette is a room without heating surfaces such as an oven, hob or fryer, but where a microwave, kettle, dishwasher, refrigerator and coffee machines or coffee makers may be present. This type of kitchen, where no food is produced, is not considered a room with a particular fire hazard. Similarly, smaller kitchens that include an oven, hob or deep fryer are considered a special fire hazard and are therefore not a Kitchenette"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Tea or appetiser kitchen, Tea or catering kitchen, Tea or side dish kitchen, Sideboard kitchen" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:17:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "112" ;
    fbo:hasNotionURL <https://www.notion.so/RoomfunctionKitchenette-151f8487e6e780768793dd587231cdad> ;
    qudt:hasApplicableUnit "[-]" .

