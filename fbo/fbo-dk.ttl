fbo-dk:SeparationFire a owl:Class ;
    rdfs:label "Brandmæssig adskillelse"@da-DK,
        "Fire separation"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Bygningsdel, f.eks. væg eller etageadskillelse med brandklassificerede egenskaber, som indgår ved etablering af en brandsektion eller ved røgopdeling af en flugtvejsgang, samt brandvæg til sikring mod brandsmitte ved matrikelskel."@da-DK,
        "Building element, e.g. wall or storey partition with fire-rated properties, which is used to create a fire compartment or smoke separation of an escape route, as well as a fire wall to protect against fire spread at property boundaries."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "66" ;
    fbo:hasNotionURL <https://www.notion.so/SeparationFire-151f8487e6e780039d30e3a8c3166fe5> ;
    fbo:isLinkedTo fbo:BoundaryFireCompartment .

fbo-dk:Site a owl:Class ;
    rdfs:label "Terræn i det fri"@da-DK,
        "Terrain"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Udendørs områder i terræn, hvor evakuerede personer er i sikkerhed for branden, og hvorfra der er uhindret adgang til offentligt areal eller vej. Benyttes også om områder, der er så store, at alle de evakuerede personer kan opholde sig her i sikker afstand fra branden."@da-DK,
        "Outdoor areas on the ground where evacuees are safe from the fire and from which there is unobstructed access to a public area or road. Also used for areas that are large enough for all evacuees to remain at a safe distance from the fire."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Outdoor terrain, Terrain in the open air, Terrain in the great outdoors, Off-road terrain" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "101" ;
    fbo:hasNotionURL <https://www.notion.so/Site-151f8487e6e78057b007f5c578c0f1e6> .

fbo-dk:SpaceLivingunit a owl:Class ;
    rdfs:label "Boenhed eller Boligenhed"@da-DK,
        "Living or Housing unit"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Afgrænset del af bygning bestående af et eller flere værelser/rum, f.eks. på hoteller og plejehjem, hvor mindst et af rummene er indrettet med sovepladser. Bygning, eller afgrænset del af bygning, henført til anvendelseskategori 4, hvor der bor én familie eller relaterede personer, f.eks. bofællesskab, generationsfællesskab og lignende."@da-DK,
        "Delimited part of a building consisting of one or more rooms/spaces, e.g. in hotels and nursing homes, where at least one of the rooms is furnished with sleeping accommodation. Or Building, or defined part of a building, assigned to use category 4, where one family or related persons live, e.g. cohousing, intergenerational community and similar."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Living unit or Residential unit" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:09:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "72" ;
    fbo:hasNotionURL <https://www.notion.so/SpaceLivingunit-151f8487e6e7801a95fade238b16fcdd> ;
    fbo:isLinkedTo fbo:Roomfunction ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:SpaceUsableAttic a owl:Class ;
    rdfs:label "Udnyttelig tageetage (tagrum)"@da-DK,
        "Usable attic (roof space)"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Tagetage, hvor der er et areal, der kan anvendes uden væsentlige indgreb i de bærende konstruktioner. Uanset om en udnyttelig tagetage benyttes eller ikke benyttes betragtes den i brandmæssig henseende som udnyttelig."@da-DK,
        "Attics, where there is an area that can be used without significant interference with the load-bearing structures. Regardless of whether a usable attic is used or not used, it is considered usable for fire safety purposes."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Utilisable rooftop (roof space), Utilisable roof space (roof space), Usable rooftop (roof space)" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
