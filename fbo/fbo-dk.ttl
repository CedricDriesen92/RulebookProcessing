    fbo:hasNotionURL <https://www.notion.so/EscapeRoute-34af8487e6e780d3a2f3f8cda70b6af4> ;
    fbo:hasValueType "Boolean (yes/no)" ;
    qudt:hasApplicableUnit "[-]" .

fbo-dk:EvacuationRoutePrimary a owl:Class ;
