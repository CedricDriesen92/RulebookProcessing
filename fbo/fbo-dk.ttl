fbo-dk:ActiveFireProtection a owl:Class ;
    rdfs:label "Aktiv brandsikringsanlæg"@da-DK,
        "Active fire protection"@en ;
    rdfs:subClassOf fbo:ActiveFireProtection ;
    fbo:hasAdoptedDefinitionType "Implicit definition" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Aktiv brandsikring omfatter alle tekniske installationer og systemer, der bruges til at registrere, advare om, og bekæmpe brand i en bygning. Det er udstyr, der reagerer aktivt ved brand"@da-DK,
        "Active fire protection includes all technical installations and systems used to detect, warn of, and suppress/contain fire in a building. It is equipment that actively responds to fire"@en ;
    fbo:hasDomainReference fbo:X0BUILDINGINFORMATION,
        fbo:X1COMPARTMENTATION,
        fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:ActiveFireProtection ;
    fbo:hasLastEdition "2026-02-17T13:12:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "275" ;
    fbo:hasNotionURL <https://www.notion.so/ActiveFireProtection-222f8487e6e7805a8988d633b5d8aa19> ;
    fbo:hasSubitem fbo-dk:AutomaticFireAlarmsystem,
        fbo-dk:AutomaticFireSprinklersystem,
        fbo-dk:AutomaticFireVentilationsystem,
        fbo-dk:EmergencyExitLighting,
        fbo-dk:EmergencyPanicLights ;
    fbo:isLinkedTo fbo:ActiveFireProtection .

fbo-dk:UseCategory a owl:Class ;
    rdfs:label "Anvendelseskategori"@da-DK,
        "Use category"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Kategori med et nummer fra 1 – 6, der fastlægges på baggrund af en bygnings eller et bygningsafsnits primære anvendelse baseret på, om bygningsafsnittet er indrettet med sovepladser, om personerne i bygningsafsnittet har kendskab til flugtveje, om personerne i bygningsafsnittet har mulighed for ved egen hjælp at bringe sig i sikkerhed samt på antallet af personer pr. brandmæssig enhed."@da-DK,
        "Category with a number from 1 - 6, determined based on the primary use of a primary use of a building or section of a building based on whether the building section has sleeping accommodation, whether the occupants of the building section have knowledge of escape routes, whether the occupants of the building section have the ability to get to safety by themselves and the number of occupants per fire safety unit."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Functional category" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-01-06T12:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "75" ;
    fbo:hasNotionURL <https://www.notion.so/UseCategory-151f8487e6e78021aaf3e1de904dfabe> ;
    fbo:hasSubitem fbo-dk:UseCategoryAK1,
        fbo-dk:UseCategoryAK2,
        fbo-dk:UseCategoryAK3,
        fbo-dk:UseCategoryAK4,
        fbo-dk:UseCategoryAK5,
        fbo-dk:UseCategoryAK6 ;
    fbo:hasValueType "Enumeration (choice)" .

fbo-dk:Roomfunction a owl:Class ;
    rdfs:label "Rum funktion"@da-DK,
        "Room function"@en ;
    rdfs:subClassOf fbo:Roomfunction ;
    fbo:hasAdoptedDefinitionType "Implicit definition" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Rum funktion handler om, hvordan et rum er designet og indrettet for at understøtte bestemte aktiviteter og oplevelser."@da-DK,
        "Room function refers to how a room is designed and furnished to support specific activities and experiences."@en ;
    fbo:hasDomainReference fbo:X12FireCompartmentBoundary,
        fbo:X1COMPARTMENTATION ;
    fbo:hasFireExpertGuidance """Examples of room functions that are essential for fire safety
• Corridors that serve as escape routes
• Residential units
• Dormitory rooms
• Shared kitchens in dormitories
• Assembly rooms
• Office spaces
• Storage/copy rooms
• Workshops
• Shop
• Storage room
• Staff room
• Canteen
• Production kitchen
• Teaching room
• Rooms in daycare centres.
• Garage
• Ward in a hospital or care institution
• Hotel room
• Technical room
• Cleaning room
• Ventilation room
• Electrical room
• Attic space that is not currently used but could be used.""" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:15:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "409" ;
    fbo:hasNotionURL <https://www.notion.so/Roomfunction-24ff8487e6e780e0a945c9b115ee6c19> ;
    fbo:hasSubitem fbo-dk:RoomOccupancy,
        fbo-dk:RoomfunctionAssemblyrooms,
        fbo-dk:RoomfunctionCanteen,
        fbo-dk:RoomfunctionClassrooms,
        fbo-dk:RoomfunctionCopyroom,
        fbo-dk:RoomfunctionDormitory,
        fbo-dk:RoomfunctionEscaperouteCorridor,
        fbo-dk:RoomfunctionEscapestaircase,
        fbo-dk:RoomfunctionKitchen,
        fbo-dk:RoomfunctionKitchenette,
        fbo-dk:RoomfunctionOfficespace,
        fbo-dk:RoomfunctionProductionskitchen,
        fbo-dk:RoomfunctionResidentialunit,
        fbo-dk:RoomfunctionSafetyStaircase,
        fbo-dk:RoomfunctionSchoolkitchen,
        fbo-dk:RoomfunctionShop,
        fbo-dk:RoomfunctionStaffroom,
        fbo-dk:RoomfunctionStorage,
        fbo-dk:RoomfunctionStorageroom .

