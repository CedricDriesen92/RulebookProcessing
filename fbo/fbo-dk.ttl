    fbo:hasNotionID "144" ;
    fbo:hasNotionURL <https://www.notion.so/AutomaticFireVentilationsystem-151f8487e6e780c0a14bd2c7b78f60bc> ;
    fbo:isLinkedTo fbo:AutomaticFireVentilationsystem .

