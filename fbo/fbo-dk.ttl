fbo-dk:WidthFreeDoors a owl:Class ;
    rdfs:label "Fri bredde flugtvejsdøre"@da-DK,
        "Free width Emergency escape door"@en ;
    rdfs:subClassOf fbo:WidthFreeDoors ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-K02" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Døre i fælles adgangsveje skal have
en fri bredde på mindst 0,77 m. Dog skal den frie bredde på udgangsdøre fra brandceller samt i flugtveje og døre i
flugtveje minimum være 10 mm for hver person, som brandcellen eller flugtvejen er beregnet til."""@da-DK,
        """Doors in common access routes must have a minimum clear width of 0.77 m. However, the clear width of exit doors from subcompartments, escape routes and doors in
escape routes must have a minimum clear width of 10 mm for each person for whom the fire subcompartment or escape route is intended."""@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X24WithoftheExits,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Clear width escape route doors" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:19:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "289" ;
    fbo:hasNotionURL <https://www.notion.so/WidthFreeDoors-22cf8487e6e780fdb30af21947bbc12c> ;
    fbo:hasValueType "Number" .

