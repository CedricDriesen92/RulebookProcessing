fbo-dk:AreaEvacuationroute a owl:Class ;
    rdfs:label "Flugtvejspassage eller Flugtvejsareal"@da-DK,
        "Evacuation route passage or Evacuation route area"@en ;
    rdfs:subClassOf fbo:AreaEvacuationroute ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Friholdt areal i et opholdsrum, der giver adgang til udgangsdør(e)"@da-DK,
        "Free space in a room for occupancy that provides access to exit door(s)"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Escape route passage or Escape route area" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:19:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "105" ;
    fbo:hasNotionURL <https://www.notion.so/AreaEvacuationroute-151f8487e6e780629f6de578c7bda3ae> ;
    fbo:isLinkedTo fbo:AreaEvacuationroute .

fbo-dk:AreaFireCompartment a owl:Class ;
    rdfs:label "Etageareal i brandmæssig henseende"@da-DK,
        "Compartment-Area - Floor area"@en ;
    rdfs:subClassOf fbo:AreaFireCompartment ;
    fbo:hasAdoptedDefinitionType "Explicit and implicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01, BR18-§455" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Summen af bruttoarealerne for samtlige etager, herunder kældre og udnyttelige tagetager samt altanlukninger, udestuer, forbindelsesgange og lignende. I forbindelse med brandforhold må der ikke foretages fradrag, jf. BR18 § 455, stk. 3 nr. 1, 4 og 5 samt stk. 4, som alene må benyttes ved beregning af bebyggelsesprocent."@da-DK,
        "The sum of the gross areas of all floors, including basements and usable roof spaces as well as enclosed balconies, enclosed porches, connecting corridors and similar. In connection with fire conditions, no deductions may be made, cf. BR18 § 455(3)(1), (4) and (5) and (4), which may only be used when calculating the building percentage."@en ;
    fbo:hasDocumentReference fbo-dk:BR18,
        fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Floor area in terms of fire safety" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:AreaFireCompartment2a ;
    fbo:hasLastEdition "2026-02-03T14:38:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "69" ;
    fbo:hasNotionURL <https://www.notion.so/AreaFireCompartment-151f8487e6e7800fa26cdd6dd0fb5b2a> ;
    fbo:hasValueType "Number" ;
    fbo:isLinkedTo fbo:AreaFireCompartment ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-dk:AreaFloorRoom a owl:Class ;
    rdfs:label "Gulvareal"@da-DK,
        "Floor area in rooms"@en ;
    rdfs:subClassOf fbo:AreaFloorRoom ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Areal af et rums gulvoverflade afgrænset af rummets omgivende vægge. Ved beregning af arealet foretages der ikke fradrag for areal af eventuelle søjler og andre bygningsdele i rummet"@da-DK,
        "The floor area of a room measured to the inside face of the surrounding walls. When calculating the area, no deduction is made for the area of any columns and other building elements in the room"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X11CompartmentSize,
        fbo:X1COMPARTMENTATION ;
    fbo:hasEquivalentTerm "Floor space" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-10T08:11:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "165" ;
    fbo:hasNotionURL <https://www.notion.so/AreaFloorRoom-151f8487e6e780f8bac2c40437774032> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-dk:AreaFreespace a owl:Class ;
    rdfs:label "Friareal"@da-DK,
        "Free space"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Indendørs areal, der er friholdt for oplag, inventar og lignende."@da-DK,
        "Indoor area that is kept free of storage, inventory and the like."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Free area, Clearance area, Open space" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:19:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "170" ;
    fbo:hasNotionURL <https://www.notion.so/AreaFreespace-151f8487e6e780feb8a6d6212d0fc7c4> ;
    fbo:hasValueType "Number" .

fbo-dk:AreaOpeningClearAerodynamicAa a owl:Class ;
    rdfs:label "Aerodynamisk frit areal (Aa)"@da-DK,
        "Aerodynamic free area (Aa)"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Areal, hvor luften frit kan strømme gennem en åbning. Defineres som Cv-faktoren multipliceret med det geometriske åbningsareal"@da-DK,
        "Area where air can freely flow through an opening. Defined as the Cv factor multiplied by the geometric opening area."@en ;
    fbo:hasDesignator "Aa" ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Aerodynamic free area" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:18:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "87" ;
    fbo:hasNotionURL <https://www.notion.so/AreaOpeningClearAerodynamic-Aa-151f8487e6e7803489efc5b46dc09e0c> ;
    fbo:hasValueType "Number" .

fbo-dk:AreaOpeningClearGeometric a owl:Class ;
    rdfs:label "Frit åbningsareal (geometrisk frit åbningsareal)"@da-DK,
        "Free opening area (geometric free opening area)"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Geometrisk åbningsareal (Ag) med fradrag af forhindringer i åbningen (f.eks. motorer, åbningsmekanismer eller riste) samt reduktion pga. åbningsgraden af eventuelt vindue eller lem."@da-DK,
        "Geometric opening area (Ag) minus any obstructions in the opening (e.g. motors, opening mechanisms or grilles) and reduction due to the degree of opening of any window or hatch."@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:13:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "158" ;
    fbo:hasNotionURL <https://www.notion.so/AreaOpeningClearGeometric-151f8487e6e780e786d5f8888fc32961> ;
    fbo:hasValueType "Number" ;
    qudt:hasApplicableUnit qudt-unit:M2 .

fbo-dk:AreaOpeningGeometricAg a owl:Class ;
    rdfs:label "Geometrisk åbningsareal (Ag)"@da-DK,
        "Geometric opening area (Ag)"@en ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Det indvendige areal af åbning (karmlysningsarealet)."@da-DK,
        "The inside area of the opening"@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Geometric aperture area (Ag)" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:14:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "89" ;
    fbo:hasNotionURL <https://www.notion.so/AreaOpeningGeometric-Ag-151f8487e6e7803999ecc4a087e5a058> ;
    fbo:hasValueType "Number" .

fbo-dk:AreaSubCompartment a owl:Class ;
    rdfs:label "Brandcelle areal"@da-DK,
        "Subcompartment area"@en ;
    fbo:hasAdoptedDefinitionType "Explicit and implicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition """Areal af et rums gulvoverflade afgrænset af rummets omgivende vægge.
Ved beregning af arealet foretages der ikke fradrag for areal af eventuelle søjler og andre bygningsdele i rummet."""@da-DK,
        """The floor area of a room's floor surface delimited by the room's surrounding walls.
When calculating the area, no deduction is made for the area of any columns and other building elements in the room."""@en ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X1COMPARTMENTATION,
        fbo:X21NumberofDoorsExits,
        fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Fire cell size, Fire compartment size" ;
    fbo:hasFireExpertGuidance "The area of the room’s floor are defined in BR18-VK5-D01. It is implicit that the area of the subcompartments are the sum of the area and the room’s floor" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasLastEdition "2026-02-17T13:12:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "285" ;
    fbo:hasNotionURL <https://www.notion.so/AreaSubCompartment-22cf8487e6e78068b436c0ba5a61f185> ;
    fbo:isLinkedTo fbo:AreaFireCompartment .

fbo-dk:AutomaticWarningsystem a owl:Class ;
    rdfs:label "Automatisk varslingsanlæg AVA"@da-DK,
        "Automatic warning system"@en ;
    rdfs:subClassOf fbo:AutomaticWarningSystem ;
    fbo:hasAdoptedDefinitionType "Explicit definition" ;
    fbo:hasArticleID "BR18-VK5-D01" ;
    fbo:hasCountry fbo:Denmark ;
    fbo:hasCountryCode "DK" ;
    fbo:hasDefinition "Anlæg, der via en tone eller en talt besked varsler personer om en utilsigtet hændelse, herunder brand. Varslingsanlæg kan aktiveres manuelt (internt varslingsanlæg) eller automatisk via et ABA-anlæg (automatisk varslingsanlæg)."@da-DK,
        "An alarm system that uses a tone or spoken message to alert people of an accidental event, including fire. Alarm systems can be activated manually (internal alarm system) or automatically via an ABA system (automatic alarm system)."@en ;
    fbo:hasDesignator "AVA" ;
    fbo:hasDocumentReference fbo-dk:BR18VK5D01 ;
    fbo:hasDomainReference fbo:X2EVACUATION ;
    fbo:hasEquivalentTerm "Automatic warning device AVA, AVA automatic alarm system" ;
    fbo:hasFireExpertValidation true ;
    fbo:hasIFCMapping fbo-ifc:AutomaticDetection ;
    fbo:hasLastEdition "2026-02-03T14:46:00+00:00"^^xsd:dateTime ;
    fbo:hasNotionID "147" ;
    fbo:hasNotionURL <https://www.notion.so/AutomaticWarningsystem-151f8487e6e780c99835da6a4163a27d> ;
    fbo:isLinkedTo fbo:AutomaticWarningSystem .

