@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_5_2_1 a fro:Section ;
    fro:hasArticle ex:Article_5_2_1_1,
        ex:Article_5_2_1_2,
        ex:Article_5_2_1_3 ;
    fro:hasID "5.2.1" ;
    fro:hasOriginalText "Structurele elementen" .

ex:Article_5_2_1_1 a fro:Article ;
    fro:hasID "A5.2.1.1" ;
    fro:hasMember ex:Member_5_2_1_1_1 ;
    fro:hasVersion fro:v0_1 .

ex:Article_5_2_1_2 a fro:Article ;
    fro:hasID "A5.2.1.2" ;
    fro:hasMember ex:Member_5_2_1_2_1,
        ex:Member_5_2_1_2_2 ;
    fro:hasOriginalText "Wanneer het dak geen andere functie heeft dan alleen het beschermen van de parking tegen de weersomstandigheden:"@nl ;
    fro:hasVersion fro:v0_1 ;
    fro:linksTo fbo-be:Ceiling,
        fbo-be:Parking .

ex:Article_5_2_1_3 a fro:Article ;
    fro:hasID "A5.2.1.3" ;
    fro:hasMember ex:Member_5_2_1_3_1,
        ex:Member_5_2_1_3_2 ;
    fro:hasOriginalText "Voor de open parkeerbouwlagen worden de structurele elementen aan geen enkele vereiste onderworpen inzake brandweerstand, op voorwaarde:"@nl ;
    fro:hasVersion fro:v0_1 ;
    fro:linksTo fbo:FireResistance,
        fbo-be:BuildingLayerParking .

ex:Member_5_2_1_1_1 a fro:Member ;
    fro:hasOriginalText "In afwijking van het punt 3.2 hebben de structurele elementen van de parking R 120 en de vloeren van de parkeerbouwlagen en van de hellingen hebben R 120."@nl ;
    fro:linksTo fbo-be:BuildingLayerParking,
        fbo-be:FinishedFloor,
        fbo-be:Parking .

ex:Member_5_2_1_2_1 a fro:Member ;
    fro:hasOriginalText "- hebben de structurele elementen van het dak R 30;"@nl .

ex:Member_5_2_1_2_2 a fro:Member ;
    fro:hasOriginalText "- of worden de structurele elementen van het dak gescheiden van de rest van de parking door een bouwelement EI 30."@nl .

ex:Member_5_2_1_3_1 a fro:Member ;
    fro:hasOriginalText "- dat de vloeren van deze open parkeerbouwlagen en de hellingen tussen deze open parkeerbouwlagen minstens REI 60 hebben;"@nl ;
    fro:linksTo fbo-be:BuildingLayerParking,
        fbo-be:FinishedFloor .

ex:Member_5_2_1_3_2 a fro:Member ;
    fro:hasOriginalText "- en dat deze structurele elementen geen ander compartiment dragen."@nl ;
    fro:linksTo fbo-be:FireCompartment .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

