ex:Article_5_2_3_1 a fro:Article ;
    fro:hasID "A5.2.3.1" ;
    fro:hasMember ex:Member_5_2_3_1_1,
        ex:Member_5_2_3_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_5_2_3_1_1 a fro:Member ;
    fro:hasOriginalText "In afwijking van het punt 1.3 moeten de parkings van aangrenzende gebouwen niet door een wand worden afgescheiden. Die parkings vormen bijgevolg slechts één en dezelfde parking."@nl ;
    fro:linksTo fbo-be:Building,
        fbo-be:Parking .

ex:Member_5_2_3_1_2 a fro:Member ;
    fro:hasOriginalText "In dat geval hebben de structurele elementen van de gehele parking R 120, met inbegrip van de structurele elementen van de open parkeerbouwlagen."@nl ;
    fro:linksTo fbo:FireStability,
        fbo-be:Parking .

ex:Section_5_2_3 a fro:Section ;
    fro:hasArticle ex:Article_5_2_3_1 ;
    fro:hasID "5.2.3" ;
    fro:hasOriginalText "Parking onder verschillende gebouwen"@nl .

