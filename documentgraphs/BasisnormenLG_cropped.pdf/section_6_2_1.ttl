@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_2_1 a fro:Section ;
    fro:hasArticle ex:Article_6_2_1_1 ;
    fro:hasID "6.2.1" .

ex:Article_6_2_1_1 a fro:Article ;
    fro:hasID "A6.2.1.1" ;
    fro:hasMember ex:Member_6_2_1_1_1,
        ex:Member_6_2_1_1_2,
        ex:Member_6_2_1_1_3,
        ex:Member_6_2_1_1_4,
        ex:Member_6_2_1_1_5,
        ex:Member_6_2_1_1_6 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_2_1_1_1 a fro:Member ;
    fro:hasOriginalText "Deze toestellen hebben hun eigen machinekamers, schachten en bordessen."@nl ;
    fro:linksTo fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft .

ex:Member_6_2_1_1_2 a fro:Member ;
    fro:hasOriginalText "De machinekamers bevinden zich bovenaan de schacht."@nl ;
    fro:linksTo fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft .

ex:Member_6_2_1_1_3 a fro:Member ;
    fro:hasOriginalText "De binnenwanden van de machinekamers en van de schachten hebben EI 60."@nl ;
    fro:linksTo fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft,
        fbo-be:WallTypeInternal .

ex:Member_6_2_1_1_4 a fro:Member ;
    fro:hasOriginalText "De binnentoegangsdeuren hebben EI1 30."@nl .

ex:Member_6_2_1_1_5 a fro:Member ;
    fro:hasOriginalText "De schachtwanden aan de kant van het bordes en de toezichtluiken in deze wanden hebben EI 30."@nl ;
    fro:linksTo fbo-be:VerticalShaft,
        fbo-be:WallTypeInternal .

ex:Member_6_2_1_1_6 a fro:Member ;
    fro:hasOriginalText "De schachtdeuren of toegangsluiken van deze toestellen werken automatisch en zijn normaal gesloten."@nl ;
    fro:linksTo fbo:SelfClosing .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

