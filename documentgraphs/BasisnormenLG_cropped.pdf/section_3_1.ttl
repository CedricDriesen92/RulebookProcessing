ex:Section_3_1 a fro:Section ;
    fro:hasArticle ex:Article_3_1_1 ;
    fro:hasID "3.1" ;
    fro:hasOriginalText "Doorvoeringen door wanden."@nl .

ex:Article_3_1_1 a fro:Article ;
    fro:hasID "A3.1.1" ;
    fro:hasMember ex:Member_3_1_1_1,
        ex:Member_3_1_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_3_1_1_1 a fro:Member ;
    fro:hasOriginalText "Doorvoeringen doorheen wanden van leidingen voor fluïda of voor elektriciteit en de uitzetvoegen van wanden mogen de vereiste brandweerstand van de bouwelementen niet nadelig beïnvloeden."@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:Conduits,
        fbo-be:Pipes,
        fbo-be:WallTypeInternal .

ex:Member_3_1_1_2 a fro:Member ;
    fro:hasOriginalText "De bepalingen van bijlage 7 \"Gemeenschappelijke bepalingen\", hoofdstuk 1, zijn van toepassing."@nl ;
    fro:hasReference ex:Reference_Bijlage_7 .

ex:Reference_Bijlage_7 a fro:Reference ;
    fro:hasID "Bijlage 7" .

