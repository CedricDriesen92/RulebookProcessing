@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .

ex:Section_0_3 a fro:Section ;
    fro:hasID "0.3" ;
    fro:hasOriginalText "Platen"@nl ;
    fro:hasSection ex:Section_0_3_1 .

ex:Section_0_3_1 a fro:Section ;
    fro:hasFigure fro:Figure_2_1,
        fro:Figure_2_2 ;
    fro:hasID "0.3.1" ;
    fro:hasOriginalText """[De platen zijn opgenomen bij de betreffende tekst]
Plaat 2.1 - Gevels tussen gebouwen
Plaat 2.2 - Gevels tussen compartimenten"""@nl .

fro:Figure_2_1 a fro:Figure ;
    fro:hasID "F2.1" ;
    fro:hasOriginalText "Plaat 2.1 - Gevels tussen gebouwen"@nl ;
    fro:linksTo fbo-be:WallTypeExternal .

fro:Figure_2_2 a fro:Figure ;
    fro:hasID "F2.2" ;
    fro:hasOriginalText "Plaat 2.2 - Gevels tussen compartimenten"@nl ;
    fro:linksTo fbo-be:FireCompartment .

