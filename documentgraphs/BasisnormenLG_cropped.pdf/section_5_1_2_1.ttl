@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_5_1_2_1 a fro:Section ;
    fro:hasArticle ex:Article_5_1_2_1_1 ;
    fro:hasID "5.1.2.1" ;
    fro:hasOriginalText "Stooklokalen met verbrandingstoestellen met een gecumuleerd verbrandingsdebiet groter dan of gelijk aan 75 kW en brandstofopslagruimtes."@nl .

ex:Article_5_1_2_1_1 a fro:Article ;
    fro:hasID "A5.1.2.1.1" ;
    fro:hasMember ex:Member_5_1_2_1_1_1,
        ex:Member_5_1_2_1_1_2,
        ex:Member_5_1_2_1_1_3,
        ex:Member_5_1_2_1_1_4,
        ex:Member_5_1_2_1_1_5,
        ex:Member_5_1_2_1_1_6,
        ex:Member_5_1_2_1_1_7 ;
    fro:hasOriginalText """De stooklokalen met verbrandingstoestellen met een gecumuleerd verbrandingsdebiet groter dan of gelijk aan 75 kW en de brandstofopslagruimtes, zijn technische lokalen.

De voorschriften van punt 5.1.1 zijn van toepassing, mits volgende wijzigingen:"""@nl ;
    fro:hasVersion fro:v0_1 .

ex:Member_5_1_2_1_1_1 a fro:Member ;
    fro:hasOriginalText "De stooklokalen met verbrandingstoestellen met een gecumuleerd verbrandingsdebiet groter dan of gelijk aan 75 kW en de brandstofopslagruimtes, zijn technische lokalen."@nl ;
    fro:linksTo fbo-be:TechnicalRoom .

ex:Member_5_1_2_1_1_2 a fro:Member ;
    fro:hasOriginalText "De voorschriften van punt 5.1.1 zijn van toepassing, mits volgende wijzigingen:"@nl .

ex:Member_5_1_2_1_1_3 a fro:Member ;
    fro:hasOriginalText "- Elke stooklokaal en brandstofopslagruimte moet een afzonderlijk compartiment vormen;"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_5_1_2_1_1_4 a fro:Member ;
    fro:hasOriginalText "- De binnenwanden van deze stooklokalen en brandstofopslagruimtes EI 60 hebben;"@nl ;
    fro:linksTo fbo-be:WallTypeInternal .

ex:Member_5_1_2_1_1_5 a fro:Member ;
    fro:hasMember ex:Member_5_1_2_1_1_5_1,
        ex:Member_5_1_2_1_1_5_2,
        ex:Member_5_1_2_1_1_5_3,
        ex:Member_5_1_2_1_1_5_4 ;
    fro:hasOriginalText "- Toegang tot deze stooklokalen en brandstofopslagruimtes:"@nl .

ex:Member_5_1_2_1_1_5_1 a fro:Member ;
    fro:hasOriginalText "- Hetzij via een zelfsluitende deur EI1 60;"@nl .

ex:Member_5_1_2_1_1_5_2 a fro:Member ;
    fro:hasMember ex:Member_5_1_2_1_1_5_2_1,
        ex:Member_5_1_2_1_1_5_2_2,
        ex:Member_5_1_2_1_1_5_2_3 ;
    fro:hasOriginalText "- Hetzij via een sas met de volgende kenmerken:"@nl ;
    fro:linksTo fbo-be:TechnicalRoom .

ex:Member_5_1_2_1_1_5_2_1 a fro:Member ;
    fro:hasOriginalText "1. het bevat zelfsluitende deuren EI1 30;"@nl .

ex:Member_5_1_2_1_1_5_2_2 a fro:Member ;
    fro:hasOriginalText "2. de wanden hebben EI 60;"@nl .

ex:Member_5_1_2_1_1_5_2_3 a fro:Member ;
    fro:hasOriginalText "3. de oppervlakte bedraagt minimum 2 m²;"@nl .

ex:Member_5_1_2_1_1_5_3 a fro:Member ;
    fro:hasOriginalText "- Hetzij via een uitgang in open lucht, derwijze dat een evacuatieniveau bereikbaar is."@nl ;
    fro:linksTo fbo-be:EvacuationLevel .

ex:Member_5_1_2_1_1_5_4 a fro:Member ;
    fro:hasOriginalText "De deuren draaien open in de vluchtzin."@nl .

ex:Member_5_1_2_1_1_6 a fro:Member ;
    fro:hasOriginalText "- Geen enkel punt van deze stooklokalen en brandstofopslagruimtes mag zich verder bevinden dan 15 m van de dichtstbijzijnde uitgang."@nl ;
    fro:linksTo fbo-be:Distance2NearestExit .

ex:Member_5_1_2_1_1_7 a fro:Member ;
    fro:hasOriginalText "De capaciteit van een brandstofopslagruimte wordt beperkt zodat de totale brandlast van de brandstofopslagruimte kleiner is dan of gelijk aan 750 GJ."@nl ;
    fro:linksTo fbo:FireLoad .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

