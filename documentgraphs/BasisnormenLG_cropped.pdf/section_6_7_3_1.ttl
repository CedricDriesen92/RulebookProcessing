@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_7_3_1 a fro:Section ;
    fro:hasArticle ex:Article_6_7_3_1_1 ;
    fro:hasID "6.7.3.1" ;
    fro:hasOriginalText "Algemeen."@nl .

ex:Article_6_7_3_1_1 a fro:Article ;
    fro:hasID "A6.7.3.1.1" ;
    fro:hasMember ex:Member_6_7_3_1_1_1,
        ex:Member_6_7_3_1_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_7_3_1_1_1 a fro:Member ;
    fro:hasForwardReference ex:Section_3_1 ;
    fro:hasOriginalText "De wanddoorgangen van luchtkanalen moeten algemeen voldoen aan 3.1."@nl ;
    fro:linksTo fbo-be:Conduits .

ex:Member_6_7_3_1_1_2 a fro:Member ;
    fro:hasMember ex:Member_6_7_3_1_1_2_1,
        ex:Member_6_7_3_1_1_2_2,
        ex:Member_6_7_3_1_1_2_3 ;
    fro:hasOriginalText "Dit voorschrift geldt niet voor de doorgang van luchtkanalen door wanden met EI 30, onder volgende voorwaarden:"@nl ;
    fro:linksTo fbo-be:Conduits,
        fbo-be:WallTypeInternal .

ex:Member_6_7_3_1_1_2_1 a fro:Member ;
    fro:hasOriginalText "- de luchtkanalen zijn vervaardigd uit materialen van klasse A1 over een afstand van minstens 1 m aan weerszijde van de doorboorde wand;"@nl ;
    fro:linksTo fbo-be:Conduits,
        fbo-be:WallTypeInternal .

ex:Member_6_7_3_1_1_2_2 a fro:Member ;
    fro:hasOriginalText "- de luchtkanalen die op deze doorgangen aansluiten en die doorheen horizontale evacuatiewegen lopen, mogen niet aangesloten zijn op de luchtmonden die zich in deze evacuatiewegen bevinden;"@nl ;
    fro:linksTo fbo-be:Conduits,
        fbo-be:EvacuationPath .

ex:Member_6_7_3_1_1_2_3 a fro:Member ;
    fro:hasOriginalText "- het betreft een compartiment met uitsluitend lokalen met dagbezetting."@nl ;
    fro:linksTo fbo-be:DayOccupation,
        fbo-be:FireCompartment .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

