@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_5_1_5_2 a fro:Section ;
    fro:hasArticle ex:Article_5_1_5_2_1,
        ex:Article_5_1_5_2_2 ;
    fro:hasID "5.1.5.2" ;
    fro:hasOriginalText "Horizontale kokers" .

ex:Article_5_1_5_2_1 a fro:Article ;
    fro:hasID "A5.1.5.2.1" ;
    fro:hasMember ex:Member_5_1_5_2_1_1,
        ex:Member_5_1_5_2_1_2,
        ex:Member_5_1_5_2_1_3,
        ex:Member_5_1_5_2_1_4 ;
    fro:hasVersion fro:v0_1 .

ex:Article_5_1_5_2_2 a fro:Article ;
    fro:hasID "A5.1.5.2.2" ;
    fro:hasMember ex:Member_5_1_5_2_2_1,
        ex:Member_5_1_5_2_2_2,
        ex:Member_5_1_5_2_2_3,
        ex:Member_5_1_5_2_2_4,
        ex:Member_5_1_5_2_2_5 ;
    fro:hasVersion fro:v0_1 .

ex:Member_5_1_5_2_1_1 a fro:Member ;
    fro:hasOriginalText "Wanneer horizontale kokers door verticale wanden dringen waarvoor een brandweerstand vereist is, geldt één van de volgende drie maatregelen:"@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:HorizontalShaft,
        fbo-be:WallTypeInternal .

ex:Member_5_1_5_2_1_2 a fro:Member ;
    fro:hasOriginalText "1. de wanden van de horizontale kokers en de valluiken en deurtjes hebben minstens de vereiste brandweerstand van de verticale wand;"@nl .

ex:Member_5_1_5_2_1_3 a fro:Member ;
    fro:hasOriginalText "2. ter hoogte van de doorvoering bevindt zich een bouwelement met minstens de vereiste brandweerstand van de verticale wand;"@nl .

ex:Member_5_1_5_2_1_4 a fro:Member ;
    fro:hasMember ex:Member_5_1_5_2_1_4_1,
        ex:Member_5_1_5_2_1_4_2,
        ex:Member_5_1_5_2_1_4_3 ;
    fro:hasOriginalText "3. de wanden van de horizontale kokers hebben EI 30; de valluiken en deurtjes EI1 30; de kokers worden ter hoogte van elk compartiment onderbroken door verticale schermen met de volgende kenmerken:"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_5_1_5_2_1_4_1 a fro:Member ;
    fro:hasOriginalText "- ze bestaan uit een materiaal van klasse A1 en/of A2-s1,d0;"@nl .

ex:Member_5_1_5_2_1_4_2 a fro:Member ;
    fro:hasOriginalText "- ze beslaan de gehele ruimte tussen de leidingen;"@nl .

ex:Member_5_1_5_2_1_4_3 a fro:Member ;
    fro:hasOriginalText "- ze hebben EI 30."@nl .

ex:Member_5_1_5_2_2_1 a fro:Member ;
    fro:hasOriginalText "Wanneer verticale kokers door horizontale wanden dringen waarvoor een brandweerstand vereist is, geldt één van de volgende drie maatregelen:"@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:VerticalShaft,
        fbo-be:WallTypeInternal .

ex:Member_5_1_5_2_2_2 a fro:Member ;
    fro:hasMember ex:Member_5_1_5_2_2_2_1,
        ex:Member_5_1_5_2_2_2_2,
        ex:Member_5_1_5_2_2_2_3 ;
    fro:hasOriginalText "1. de wanden van de verticale kokers hebben een brandweerstand EI 60; de valluiken en deurtjes hebben EI1 30."@nl .

ex:Member_5_1_5_2_2_2_1 a fro:Member ;
    fro:hasOriginalText "Zij hebben aan hun boveneind een degelijke verluchting. De vrije verluchtingsdoorsnede van de koker is ten minste gelijk aan 10% van de totale horizontale doorsnede van de koker, met een minimum van 4 dm²."@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction .

ex:Member_5_1_5_2_2_2_2 a fro:Member ;
    fro:hasMember ex:Member_5_1_5_2_2_2_2_1,
        ex:Member_5_1_5_2_2_2_2_2,
        ex:Member_5_1_5_2_2_2_2_3,
        ex:Member_5_1_5_2_2_2_2_4 ;
    fro:hasOriginalText "De vrije verluchtingsdoorsnede kan uitgerust worden met gemotoriseerde verluchtingskleppen waarvan de opening als volgt bevolen wordt:"@nl .

ex:Member_5_1_5_2_2_2_2_1 a fro:Member ;
    fro:hasOriginalText "- automatisch bij detectie van een brand in de koker;"@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal .

ex:Member_5_1_5_2_2_2_2_2 a fro:Member ;
    fro:hasOriginalText "- automatisch bij de detectie van een brand in het gebouw, indien dit uitgerust is met een algemene branddetectie-installatie;"@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal .

ex:Member_5_1_5_2_2_2_2_3 a fro:Member ;
    fro:hasOriginalText "- automatisch bij een defect aan de energiebron, de voeding of de bediening (toestel met positieve veiligheid);"@nl .

ex:Member_5_1_5_2_2_2_2_4 a fro:Member ;
    fro:hasOriginalText "- manueel via een bediening op een evacuatieniveau op een in akkoord met de brandweer bepaalde plaats."@nl .

ex:Member_5_1_5_2_2_2_3 a fro:Member ;
    fro:hasOriginalText "Indien de vrije verluchtingsdoorsnede van een koker uitgerust is met een gemotoriseerde verluchtingsklep, moeten de eventuele gasleidingen in deze koker beantwoorden aan de voorschriften van de norm NBN D 51-003 of van de norm NBN D 51-006 voor de leidingen en verbindingen in een niet-verluchte technische koker."@nl ;
    fro:hasReference fro:Reference_NBN_D_51_003,
        fro:Reference_NBN_D_51_006 .

ex:Member_5_1_5_2_2_3 a fro:Member ;
    fro:hasOriginalText "2. ter hoogte van de doorvoering bevindt zich een bouwelement met minstens de vereiste brandweerstand van de horizontale wand;"@nl .

ex:Member_5_1_5_2_2_4 a fro:Member ;
    fro:hasMember ex:Member_5_1_5_2_2_4_1,
        ex:Member_5_1_5_2_2_4_2,
        ex:Member_5_1_5_2_2_4_3 ;
    fro:hasOriginalText "3. de wanden van de verticale kokers hebben EI 30; de valluiken en deurtjes EI1 30; de verticale kokers worden ter hoogte van elk compartiment onderbroken door horizontale schermen met de volgende kenmerken:"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_5_1_5_2_2_4_1 a fro:Member ;
    fro:hasOriginalText "- zij bestaan uit een materiaal van klasse A1 en/of A2-s1,d0;"@nl .

ex:Member_5_1_5_2_2_4_2 a fro:Member ;
    fro:hasOriginalText "- zij beslaan de gehele ruimte tussen de leidingen;"@nl .

ex:Member_5_1_5_2_2_4_3 a fro:Member ;
    fro:hasOriginalText "- zij hebben EI 30."@nl .

ex:Member_5_1_5_2_2_5 a fro:Member ;
    fro:hasOriginalText "In gevallen 2 en 3 moeten de kokers niet verlucht zijn."@nl .

fro:Reference_NBN_D_51_003 a fro:Reference ;
    fro:hasID "NBN D 51-003" .

fro:Reference_NBN_D_51_006 a fro:Reference ;
    fro:hasID "NBN D 51-006" .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

