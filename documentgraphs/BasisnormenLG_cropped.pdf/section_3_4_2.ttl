    fro:hasMember ex:Member_3_4_2_1_1 ;
    fro:hasVersion fro:v0_1 .

ex:Member_3_4_2_1_1 a fro:Member ;
    fro:hasOriginalText "De wanden waarvoor brandwerendheid vereist is, lopen door in de ruimte tussen het plafond en het verlaagd plafond."@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:Ceiling,
        fbo-be:SuspendedCeiling,
        fbo-be:WallTypeInternal .

ex:Section_3_4_2 a fro:Section ;
    fro:hasArticle ex:Article_3_4_2_1 ;
