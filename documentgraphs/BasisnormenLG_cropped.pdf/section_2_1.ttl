@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_2 fro:hasSection ex:Section_2_1 .

ex:Article_2_1_1 a fro:Article ;
    fro:hasID "A2.1.1" ;
    fro:hasMember ex:Member_2_1_1_1,
        ex:Member_2_1_1_2,
        ex:Member_2_1_1_3,
        ex:Member_2_1_1_4,
        ex:Member_2_1_1_5 ;
    fro:hasVersion fro:v0_1 .

ex:Article_2_1_2 a fro:Article ;
    fro:hasID "A2.1.2" ;
    fro:hasMember ex:Member_2_1_2_1,
        ex:Member_2_1_2_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_2_1_1_1 a fro:Member ;
    fro:hasForwardReference ex:Section_5_2 ;
    fro:hasOriginalText "Het gebouw is verdeeld in compartimenten waarvan de oppervlakte kleiner is dan 2500 m², met uitzondering van de parkings (zie 5.2)."@nl ;
    fro:linksTo fbo-be:FireCompartment,
        fbo-be:Parking .

ex:Member_2_1_1_2 a fro:Member ;
    fro:hasOriginalText "De maximale oppervlakte van een gelijkvloers gebouw bestaande uit één compartiment mag 3500 m² bedragen."@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_2_1_1_3 a fro:Member ;
    fro:hasOriginalText "De lengte van dit compartiment bedraagt niet meer dan 90 m."@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_2_1_1_4 a fro:Member ;
    fro:hasOriginalText "De maximale oppervlakte van een compartiment mag, respectievelijk, groter dan ofwel 2500 m², ofwel 3500 m² bedragen indien het compartiment is uitgerust met een automatische blusinstallatie en een rook- en warmteafvoerinstallatie."@nl ;
    fro:linksTo fbo-be:AutomaticFireExtinguishSystem,
        fbo-be:FireCompartment,
        fbo-be:SmokeAndHeatExtraction .

ex:Member_2_1_1_5 a fro:Member ;
    fro:hasOriginalText "De Minister van Binnenlandse Zaken bepaalt de voorwaarden waaronder uitzonderingen mogelijk zijn op de grootte van het compartiment respectievelijk ofwel 2500 m² ofwel 3500 m² zonder dat een automatische blusinstallatie en/of een rook- en warmteafvoerinstallatie moet voorzien worden."@nl ;
    fro:linksTo fbo-be:AutomaticFireExtinguishSystem,
        fbo-be:FireCompartment,
        fbo-be:SmokeAndHeatExtraction .

ex:Member_2_1_2_1 a fro:Member ;
    fro:hasOriginalText "De hoogte van een compartiment stemt overeen met de hoogte van één bouwlaag."@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:FireCompartment .

ex:Member_2_1_2_2 a fro:Member ;
    fro:hasMember ex:Member_2_1_2_2_1,
        ex:Member_2_1_2_2_2,
        ex:Member_2_1_2_2_3,
        ex:Member_2_1_2_2_4,
        ex:Member_2_1_2_2_5 ;
    fro:hasOriginalText "De volgende uitzonderingen zijn nochtans toegestaan:"@nl .

ex:Member_2_1_2_2_1 a fro:Member ;
    fro:hasForwardReference ex:Section_5_2 ;
    fro:hasOriginalText "- a) de parking met bouwlagen (zie 5.2);"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:Parking .

ex:Member_2_1_2_2_2 a fro:Member ;
    fro:hasOriginalText "- b) een compartiment mag zich uitstrekken over twee boven elkaar gelegen bouwlagen met een binnenverbindingstrap (duplex), indien de gecumuleerde oppervlakte van die bouwlagen niet groter is dan 2500 m²;"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:Duplex,
        fbo-be:FireCompartment,
        fbo-be:InternalStair .

ex:Member_2_1_2_2_3 a fro:Member ;
    fro:hasOriginalText "- c) de hoogte van een compartiment mag zich uitstrekken over drie boven elkaar gelegen bouwlagen met een binnenverbindingstrap (triplex), voor zover de som van hun gecumuleerde oppervlakte de 300 m² niet overschrijdt, en dat dit compartiment is uitgerust met een automatische branddetectie van het type totale bewaking die automatisch een aanduiding van de brandmelding geeft en waarvan de detectoren aangepast zijn aan de aanwezige risico's;"@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal,
        fbo-be:BuildingLayer,
        fbo-be:FireCompartment,
        fbo-be:InternalStair,
        fbo-be:Triplex .

ex:Member_2_1_2_2_4 a fro:Member ;
    fro:hasForwardReference ex:Section_5_1_1 ;
    fro:hasOriginalText "- d) de hoogte van een compartiment mag zich uitstrekken over verscheidene boven elkaar geplaatste bouwlagen, indien dit compartiment slechts technische lokalen omvat (zie 5.1.1)."@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:FireCompartment,
        fbo-be:TechnicalRoom .

ex:Member_2_1_2_2_5 a fro:Member ;
    fro:hasMember ex:Member_2_1_2_2_5_1 ;
    fro:hasOriginalText "- e) de hoogte van een compartiment mag zich uitstrekken over verscheidene bouwlagen (atrium) op voorwaarde:"@nl ;
    fro:linksTo fbo-be:Atrium,
        fbo-be:BuildingLayer,
        fbo-be:FireCompartment .

ex:Member_2_1_2_2_5_1 a fro:Member ;
    fro:hasMember ex:Member_2_1_2_2_5_1_1,
        ex:Member_2_1_2_2_5_1_2 ;
    fro:hasOriginalText "- - dat dit compartiment is uitgerust met een automatische blusinstallatie en een rook- en warmteafvoerinstallatie."@nl ;
    fro:linksTo fbo-be:AutomaticFireExtinguishSystem,
        fbo-be:FireCompartment,
        fbo-be:SmokeAndHeatExtraction .

ex:Member_2_1_2_2_5_1_1 a fro:Member ;
    fro:hasOriginalText "De Minister van Binnenlandse Zaken bepaalt de voorwaarden waaronder uitzonderingen mogelijk zijn op de verplichte plaatsing van een automatische blusinstallatie en een rook- en warmteafvoerinstallatie;"@nl ;
    fro:linksTo fbo-be:AutomaticFireExtinguishSystem,
        fbo-be:SmokeAndHeatExtraction .

ex:Member_2_1_2_2_5_1_2 a fro:Member ;
    fro:hasOriginalText "De Minister van Binnenlandse Zaken bepaalt de voorwaarden waaraan de automatische blusinstallatie en rook- en warmteafvoerinstallatie moeten voldoen."@nl ;
    fro:linksTo fbo-be:AutomaticFireExtinguishSystem,
        fbo-be:SmokeAndHeatExtraction .

ex:Section_2_1 a fro:Section ;
    fro:hasArticle ex:Article_2_1_1,
        ex:Article_2_1_2 ;
    fro:hasID "2.1" ;
    fro:hasOriginalText "Grootte van de compartimenten"@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

