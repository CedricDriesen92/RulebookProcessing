ex:Section_6_1_4_3 a fro:Section ;
    fro:hasArticle ex:Article_6_1_4_3_1 ;
    fro:hasID "6.1.4.3" .

ex:Article_6_1_4_3_1 a fro:Article ;
    fro:hasID "A6.1.4.3.1" ;
    fro:hasMember ex:Member_6_1_4_3_1_1,
        ex:Member_6_1_4_3_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_1_4_3_1_1 a fro:Member ;
    fro:hasOriginalText "Elke liftbatterij is minstens voorzien van een manuele oproepvoorziening op een evacuatieniveau."@nl ;
    fro:linksTo fbo:AutomaticWarningSystem,
        fbo-be:EvacuationLevel .

ex:Member_6_1_4_3_1_2 a fro:Member ;
    fro:hasOriginalText "Bovendien, als het gebouw uitgerust is met een algemene branddetectie-installatie of met een branddetectie-installatie in de schachten en/of in de machinekamers, moet deze installatie in geval van brand een signaal doorgeven naar de liften."@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal,
        fbo-be:Building,
        fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft .

