@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_4_3 a fro:Section ;
    fro:hasArticle ex:Article_4_3_1 ;
    fro:hasID "4.3" ;
    fro:hasOriginalText "Buitentrappenhuizen"@nl .

ex:Article_4_3_1 a fro:Article ;
    fro:hasID "A4.3.1" ;
    fro:hasMember ex:Member_4_3_1_1,
        ex:Member_4_3_1_2,
        ex:Member_4_3_1_3,
        ex:Member_4_3_1_4 ;
    fro:hasVersion fro:v0_1 .

ex:Member_4_3_1_1 a fro:Member ;
    fro:hasOriginalText "Buitentrappen moeten toegang geven tot een evacuatieniveau."@nl ;
    fro:linksTo fbo-be:EvacuationLevel .

ex:Member_4_3_1_2 a fro:Member ;
    fro:hasForwardReference ex:Section_4_2_3 ;
    fro:hasOriginalText "De voorschriften van 4.2.3 zijn er op van toepassing met nochtans de volgende afwijking: er wordt geen stabiliteit bij brand vereist, maar het materiaal behoort tot klasse A1."@nl ;
    fro:linksTo fbo:FireStability,
        fbo:ReactionToFire .

ex:Member_4_3_1_3 a fro:Member ;
    fro:hasMember ex:Member_4_3_1_3_1,
        ex:Member_4_3_1_3_2 ;
    fro:hasOriginalText "De verbinding tussen het compartiment en een buitentrap gebeurt:"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_4_3_1_3_1 a fro:Member ;
    fro:hasOriginalText "- hetzij via een deur;"@nl ;
    fro:linksTo fbo:DoorExit .

ex:Member_4_3_1_3_2 a fro:Member ;
    fro:hasOriginalText "- hetzij via (een) vluchtterras(sen)."@nl ;
    fro:linksTo fbo:PlaceSaferefuge .

ex:Member_4_3_1_4 a fro:Member ;
    fro:hasOriginalText "Voor de verbinding tussen het evacuatieniveau en de onmiddellijk hoger gelegen bouwlaag mag echter een trap of gedeelte van trap aangewend worden die inschuifbaar of geleed is."@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:EvacuationLevel .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

