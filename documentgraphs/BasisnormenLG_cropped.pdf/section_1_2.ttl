@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_1 fro:hasSection ex:Section_1_2 .

ex:Article_1_2_1 a fro:Article ;
    fro:hasID "A1.2.1" ;
    fro:hasMember ex:Member_1_2_1_1 ;
    fro:hasVersion fro:v0_1 .

ex:Member_1_2_1_1 a fro:Member ;
    fro:hasOriginalText "Bijgebouwen, uitspringende daken, luifels, uitkragende delen of andere dergelijke toevoegingen zijn enkel toegelaten indien daardoor noch de evacuatie, noch de veiligheid van de gebruikers, noch de actie van de brandweer in het gedrang komen."@nl ;
    fro:linksTo fbo-be:Building,
        fbo-be:EvacuationPath .

ex:Section_1_2 a fro:Section ;
    fro:hasArticle ex:Article_1_2_1 ;
    fro:hasID "1.2" ;
    fro:hasOriginalText "Bijgebouwen"@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

