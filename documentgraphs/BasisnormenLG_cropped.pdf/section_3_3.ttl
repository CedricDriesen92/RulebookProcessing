@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_3 fro:hasSection ex:Section_3_3 .

ex:Article_3_3_1 a fro:Article ;
    fro:hasID "A3.3.1" ;
    fro:hasMember ex:Member_3_3_1_1,
        ex:Member_3_3_1_2,
        ex:Member_3_3_1_3 ;
    fro:hasTable fro:Table_2_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_3_3_1_1 a fro:Member ;
    fro:hasForwardReference ex:Section_4_1,
        ex:Section_4_4 ;
    fro:hasOriginalText "Voor de wanden en de deuren, die compartimenten afbakenen, geldt 4.1; bakenen zij evacuatiewegen af dan geldt 4.4."@nl ;
    fro:linksTo fbo-be:EvacuationPath,
        fbo-be:FireCompartment,
        fbo-be:WallTypeInternal .

ex:Member_3_3_1_2 a fro:Member ;
    fro:hasOriginalText "De verticale binnenwanden die lokalen of het geheel van lokalen met nachtbezetting afbakenen hebben een brandweerstand, aangegeven in tabel 2.2."@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:NightOccupation,
        fbo-be:WallTypeInternal .

ex:Member_3_3_1_3 a fro:Member ;
    fro:hasOriginalText "De deuren in deze wanden hebben EI1 30."@nl ;
    fro:linksTo fbo-be:WallTypeInternal .

ex:Section_3_3 a fro:Section ;
    fro:hasArticle ex:Article_3_3_1 ;
    fro:hasID "3.3" ;
    fro:hasOriginalText "Verticale binnenwanden en binnendeuren."@nl .

fro:Table_2_2 a fro:Table ;
    fro:hasID "T2.2" ;
    fro:hasOriginalText """Wanden
Boven de vloer van Ei
Eén bouwlaag         EI 30
Meerdere bouwlagen           EI 60
Onder Ei,
met inbegrip van de vloer van           EI 60
Ei
Tabel 2.2 – Brandweerstand van verticale binnenwanden"""@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
