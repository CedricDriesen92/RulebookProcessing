@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_8_2_2 a fro:Section ;
    fro:hasArticle ex:Article_6_8_2_2_1 ;
    fro:hasID "6.8.2.2" ;
    fro:hasOriginalText "AANTAL EN PLAATS VAN DE TOESTELLEN VOOR BRANDMELDING, WAARSCHUWING, ALARM EN BRANDBESTRIJDING."@nl .

ex:Article_6_8_2_2_1 a fro:Article ;
    fro:hasID "A6.8.2.2.1" ;
    fro:hasMember ex:Member_6_8_2_2_1_1,
        ex:Member_6_8_2_2_1_2,
        ex:Member_6_8_2_2_1_3 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_8_2_2_1_1 a fro:Member ;
    fro:hasOriginalText "De toestellen die menselijke interventie vergen, worden aangebracht op zichtbare of helder aangeduide plaatsen die in alle omstandigheden vrij bereikbaar zijn."@nl ;
    fro:linksTo fbo:ActiveFireProtection .

ex:Member_6_8_2_2_1_2 a fro:Member ;
    fro:hasOriginalText "Zij bevinden zich onder meer nabij uitgangen, op overlopen, in gangen en worden derwijze aangebracht dat zij de circulatie niet hinderen en niet beschadigd of aangestoten kunnen worden."@nl ;
    fro:linksTo fbo:Exit .

ex:Member_6_8_2_2_1_3 a fro:Member ;
    fro:hasOriginalText "De buiten geplaatste toestellen worden desnoods tegen alle weersomstandigheden beschut."@nl ;
    fro:linksTo fbo:ActiveFireProtection .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

