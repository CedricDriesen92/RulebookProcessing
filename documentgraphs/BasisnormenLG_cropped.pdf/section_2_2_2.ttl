@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_2_2 fro:hasSection ex:Section_2_2_2 .

ex:Article_2_2_2_1 a fro:Article ;
    fro:hasID "A2.2.2.1" ;
    fro:hasMember ex:Member_2_2_2_1_1,
        ex:Member_2_2_2_1_2,
        ex:Member_2_2_2_1_3,
        ex:Member_2_2_2_1_4,
        ex:Member_2_2_2_1_5 ;
    fro:hasVersion fro:v0_1 .

ex:Member_2_2_2_1_1 a fro:Member ;
    fro:hasOriginalText "De uitgangen zijn gelegen in tegenovergestelde zones van het compartiment."@nl ;
    fro:linksTo fbo:Exit,
        fbo-be:FireCompartment .

ex:Member_2_2_2_1_2 a fro:Member ;
    fro:hasMember ex:Member_2_2_2_1_2_1,
        ex:Member_2_2_2_1_2_2,
        ex:Member_2_2_2_1_2_3 ;
    fro:hasOriginalText "De evacuatiewegen leiden ofwel:"@nl ;
    fro:linksTo fbo-be:EvacuationPath .

ex:Member_2_2_2_1_2_1 a fro:Member ;
    fro:hasOriginalText "naar buiten;"@nl ;
    fro:linksTo fbo:Exit .

ex:Member_2_2_2_1_2_2 a fro:Member ;
    fro:hasOriginalText "naar trappenhuizen;"@nl ;
    fro:linksTo fbo-be:EnclosedInternalStairCase .

ex:Member_2_2_2_1_2_3 a fro:Member ;
    fro:hasForwardReference ex:Section_4_4 ;
    fro:hasOriginalText "naar trappen, binnen of buiten het gebouw gelegen (voor de horizontale afstanden zie 4.4)."@nl ;
    fro:linksTo fbo-be:hasInternalStair .

ex:Member_2_2_2_1_3 a fro:Member ;
    fro:hasOriginalText """Wat de ondergrondse bouwlagen betreft mag één uitgang naar buiten via een evacuatieweg met
wanden EI 30 en deuren EI1 30 de vereiste toegang tot één der trappenhuizen vervangen."""@nl ;
    fro:linksTo fbo:DoorExit,
        fbo:Exit,
        fbo:FireResistance,
        fbo-be:BuildingLayer,
        fbo-be:EvacuationPath .

ex:Member_2_2_2_1_4 a fro:Member ;
    fro:hasForwardReference ex:Section_5_2 ;
    fro:hasOriginalText "Voor de parking: zie 5.2."@nl ;
    fro:linksTo fbo-be:Parking .

ex:Member_2_2_2_1_5 a fro:Member ;
    fro:hasForwardReference ex:Section_4_4 ;
    fro:hasOriginalText """Op  een  evacuatieniveau  leidt  iedere  trap  naar  buiten,  hetzij  rechtstreeks,  hetzij  over  een
evacuatieweg die beantwoordt aan de voorschriften van 4.4."""@nl ;
    fro:linksTo fbo:Exit,
        fbo-be:EvacuationLevel,
        fbo-be:EvacuationPath,
        fbo-be:hasInternalStair .

ex:Section_2_2_2 a fro:Section ;
    fro:hasArticle ex:Article_2_2_2_1 ;
    fro:hasID "2.2.2" ;
    fro:hasOriginalText "De uitgangen."@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

