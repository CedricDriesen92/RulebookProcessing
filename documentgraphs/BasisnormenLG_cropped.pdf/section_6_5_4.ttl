ex:Section_6_5_4 a fro:Section ;
    fro:hasArticle ex:Article_6_5_4_1 ;
    fro:hasID "6.5.4" ;
    fro:hasOriginalText "Veiligheidsverlichting." .

ex:Article_6_5_4_1 a fro:Article ;
    fro:hasID "A6.5.4.1" ;
    fro:hasMember ex:Member_6_5_4_1_1,
        ex:Member_6_5_4_1_2,
        ex:Member_6_5_4_1_3 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_5_4_1_1 a fro:Member ;
    fro:hasOriginalText "De veiligheidsverlichting voldoet aan de voorschriften van de normen NBN EN 1838, NBN EN 60598-2-22 en NBN EN 50172." ;
    fro:hasReference fro:Reference_NBN_EN_1838,
        fro:Reference_NBN_EN_50172,
        fro:Reference_NBN_EN_60598_2_22 ;
    fro:linksTo fbo:EmergencyExitLighting .

ex:Member_6_5_4_1_2 a fro:Member ;
    fro:hasOriginalText "Deze veiligheidsverlichting mag gevoed worden door de normale stroombron, maar valt deze uit, dan moet de voeding geschieden door één of meerdere autonome stroombron(nen)." ;
    fro:linksTo fbo:EmergencyExitLighting .

ex:Member_6_5_4_1_3 a fro:Member ;
    fro:hasOriginalText "Autonome verlichtingstoestellen aangesloten op de kring die de betrokken normale verlichting voedt, mogen eveneens gebruikt worden voor zover zij alle waarborgen voor een goede werking bieden." ;
    fro:linksTo fbo:EmergencyExitLighting .

fro:Reference_NBN_EN_1838 a fro:Reference ;
    fro:hasID "NBN EN 1838" .

fro:Reference_NBN_EN_50172 a fro:Reference ;
    fro:hasID "NBN EN 50172" .

fro:Reference_NBN_EN_60598_2_22 a fro:Reference ;
    fro:hasID "NBN EN 60598-2-22" .

