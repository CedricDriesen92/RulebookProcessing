ex:Section_4_1 a fro:Section ;
    fro:hasArticle ex:Article_4_1_1 ;
    fro:hasID "4.1" ;
    fro:hasOriginalText "Compartimenten."@nl .

ex:Article_4_1_1 a fro:Article ;
    fro:hasID "A4.1.1" ;
    fro:hasMember ex:Member_4_1_1_1 ;
    fro:hasOriginalText "De wanden tussen compartimenten hebben minstens de brandweerstand aangegeven in tabel 2.3."@nl ;
    fro:hasTable ex:Table_2_3 ;
    fro:hasVersion fro:v0_1 ;
    fro:linksTo fbo:FireResistance,
        fbo-be:FireCompartment,
        fbo-be:WallTypeInternal .

ex:Member_4_1_1_1 a fro:Member ;
    fro:hasOriginalText "De verbinding tussen twee compartimenten is slechts toegestaan indien zij geschiedt via een zelfsluitende of bij brand zelfsluitende deur EI1 30."@nl ;
    fro:linksTo fbo:DoorExit,
        fbo:SelfClosing,
        fbo-be:FireCompartment .

ex:Table_2_3 a fro:Table ;
    fro:hasID "T2.3" ;
    fro:hasOriginalText """Wanden
Boven de vloer van Ei
Type | Brandweerstand
Eén bouwlaag | EI 30
Meerdere bouwlagen | EI 60
Onder Ei met inbegrip van de vloer van Ei | EI 60
Tabel 2.3 – Brandweerstand van wanden tussen compartimenten."""@nl .

