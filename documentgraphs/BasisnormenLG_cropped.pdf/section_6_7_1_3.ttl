@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_7_1_3 a fro:Section ;
    fro:hasArticle ex:Article_6_7_1_3_1 ;
    fro:hasID "6.7.1.3" ;
    fro:hasOriginalText "Beperking van het hergebruik van lucht"@nl .

ex:Article_6_7_1_3_1 a fro:Article ;
    fro:hasID "A6.7.1.3.1" ;
    fro:hasMember ex:Member_6_7_1_3_1_1,
        ex:Member_6_7_1_3_1_2,
        ex:Member_6_7_1_3_1_3 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_7_1_3_1_1 a fro:Member ;
    fro:hasOriginalText "De lucht afgezogen uit lokalen met een bijzonder brandgevaar, opslagplaats voor ontvlambare producten, stookplaats, keuken, garage, parking, transformatorlokaal, lokaal voor de opslag van vuilnis, mag niet opnieuw worden rondgestuurd en moet naar buiten worden afgevoerd."@nl ;
    fro:linksTo fbo:FireHazardSpecial,
        fbo-be:Parking,
        fbo-be:RoomTypeCollectiveKitchen,
        fbo-be:TechnicalRoom .

ex:Member_6_7_1_3_1_2 a fro:Member ;
    fro:hasMember ex:Member_6_7_1_3_1_2_1,
        ex:Member_6_7_1_3_1_2_2 ;
    fro:hasOriginalText "De lucht afgezogen uit andere lokalen mag:"@nl .

ex:Member_6_7_1_3_1_2_1 a fro:Member ;
    fro:hasForwardReference ex:Section_6_7_5 ;
    fro:hasOriginalText "- ofwel opnieuw rondgestuurd worden naar dezelfde lokalen, op voorwaarde dat in het recyclagekanaal een rookklep conform punt 6.7.5 wordt geplaatst;"@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction .

ex:Member_6_7_1_3_1_2_2 a fro:Member ;
    fro:hasOriginalText "- ofwel ingeblazen worden in nog andere lokalen om er als compensatielucht te dienen voor mechanische extractiesystemen met rechtstreekse afvoer naar buiten, op voorwaarde dat bijkomend een rookklep en een kanaalsysteem voor rechtstreekse afvoer naar buiten van deze recyclagelucht wordt voorzien."@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction .

ex:Member_6_7_1_3_1_3 a fro:Member ;
    fro:hasOriginalText "In beide gevallen moet een rookdetectie worden geïnstalleerd in de recyclagelucht voor de rookklep. Als er rook wordt gedetecteerd in de recyclagelucht worden de"@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal,
        fbo-be:SmokeAndHeatExtraction .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

