@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_3_5_2_2 fro:hasSection ex:Section_3_5_2_2_2 .

ex:Article_3_5_2_2_2_1 a fro:Article ;
    fro:hasID "A3.5.2.2.2.1" ;
    fro:hasMember ex:Member_3_5_2_2_2_1_1,
        ex:Member_3_5_2_2_2_1_2,
        ex:Member_3_5_2_2_2_1_3,
        ex:Member_3_5_2_2_2_1_4,
        ex:Member_3_5_2_2_2_1_5 ;
    fro:hasVersion fro:v0_1 .

ex:Member_3_5_2_2_2_1_1 a fro:Member ;
    fro:hasOriginalText "De voorschriften voor enkelwandige gevels mogen toegepast worden op de binnenwand wanneer de buitenwand vaste of mobiele ventilatieopeningen bevat die automatisch openen bij brand."@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction,
        fbo-be:WallTypeExternal .

ex:Member_3_5_2_2_2_1_2 a fro:Member ;
    fro:hasOriginalText "De vaste ventilatieopeningen zijn geplaatst op 30 10 graden naar de buitenkant en naar boven toe ten opzichte van de horizontale, gelijkmatig verdeeld over ten minste 50% van de oppervlakte ervan."@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction .

ex:Member_3_5_2_2_2_1_3 a fro:Member ;
    fro:hasOriginalText "De mobiele ventilatieopeningen voldoen, bij brand, aan dezelfde voorwaarden als de vaste ventilatieopeningen."@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction .

ex:Member_3_5_2_2_2_1_4 a fro:Member ;
    fro:hasOriginalText "De veiligheidsstand van de mobiele lamellen wordt in werking gesteld door een algemene branddetectie-installatie in de compartimenten langs gevels."@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal,
        fbo-be:FireCompartment,
        fbo-be:WallTypeExternal .

ex:Member_3_5_2_2_2_1_5 a fro:Member ;
    fro:hasForwardReference ex:Section_3_5_2_3 ;
    fro:hasOriginalText "De automatische bediening moet voldoen aan de voorwaarden voorzien in punt 3.5.2.3."@nl .

ex:Section_3_5_2_2_2 a fro:Section ;
    fro:hasArticle ex:Article_3_5_2_2_2_1 ;
    fro:hasID "3.5.2.2.2" ;
    fro:hasOriginalText "Dubbelwandige gevel naar buiten toe open."@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

