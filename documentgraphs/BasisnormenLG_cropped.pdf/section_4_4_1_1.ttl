@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_4_4_1 a fro:Section ;
    fro:hasID "4.4.1" ;
    fro:hasOriginalText "Algemene voorschriften"@nl ;
    fro:hasSection ex:Section_4_4_1_1,
        ex:Section_4_4_1_2 .

ex:Article_4_4_1_1_1 a fro:Article ;
    fro:hasID "A4.4.1.1.1" ;
    fro:hasMember ex:Member_4_4_1_1_1_1,
        ex:Member_4_4_1_1_1_2,
        ex:Member_4_4_1_1_1_3,
        ex:Member_4_4_1_1_1_4,
        ex:Member_4_4_1_1_1_5,
        ex:Member_4_4_1_1_1_6 ;
    fro:hasVersion fro:v0_1 .

ex:Article_4_4_1_2_1 a fro:Article ;
    fro:hasID "A4.4.1.2.1" ;
    fro:hasMember ex:Member_4_4_1_2_1_1,
        ex:Member_4_4_1_2_1_10,
        ex:Member_4_4_1_2_1_11,
        ex:Member_4_4_1_2_1_2,
        ex:Member_4_4_1_2_1_3,
        ex:Member_4_4_1_2_1_4,
        ex:Member_4_4_1_2_1_5,
        ex:Member_4_4_1_2_1_6,
        ex:Member_4_4_1_2_1_7,
        ex:Member_4_4_1_2_1_8,
        ex:Member_4_4_1_2_1_9 ;
    fro:hasVersion fro:v0_1 .

ex:Member_4_4_1_1_1_1 a fro:Member ;
    fro:hasOriginalText """a)   voor lokalen met uitsluitend dagbezetting:
- 30 m van de evacuatieweg die de uitgangen verbindt;
- 45 m van de toegang tot de dichtstbijzijnde uitgang;
- 80 m van de toegang tot een tweede uitgang."""@nl ;
    fro:linksTo fbo-be:DayOccupation,
        fbo-be:Distance2EvacuationPath,
        fbo-be:Distance2NearestExit,
        fbo-be:Distance2SecondExit .

ex:Member_4_4_1_1_1_2 a fro:Member ;
    fro:hasOriginalText """b)   voor lokalen of geheel van lokalen met nachtbezetting:
- 20 m van de evacuatieweg die de uitgangen verbindt;
- 30 m van de toegang tot de dichtstbijzijnde uitgang;
- 60 m van de toegang tot een tweede uitgang."""@nl ;
    fro:linksTo fbo-be:Distance2EvacuationPath,
        fbo-be:Distance2NearestExit,
        fbo-be:Distance2SecondExit,
        fbo-be:NightOccupation .

ex:Member_4_4_1_1_1_3 a fro:Member ;
    fro:hasOriginalText "De lengte van doodlopende evacuatiewegen mag niet meer dan 15 m bedragen."@nl ;
    fro:linksTo fbo-be:LengthEvacuationPath .

ex:Member_4_4_1_1_1_4 a fro:Member ;
    fro:hasOriginalText "De nuttige breedte van de evacuatiewegen, vluchtterrassen en van hun toegangs-, uitgangs- of doorgangsdeuren is groter dan of gelijk aan de vereiste nuttige breedte (zie bijlage 1 \"Terminologie\"). Zij bedraagt ten minste 0,80 m voor de evacuatiewegen en de deuren, en ten minste 0,60 m voor de vluchtterrassen."@nl ;
    fro:linksTo fbo-be:EvacuationPath .

ex:Member_4_4_1_1_1_5 a fro:Member ;
    fro:hasOriginalText "In een compartiment gaat de verbinding tussen en naar de trappen via evacuatiewegen of over vluchtterrassen."@nl ;
    fro:linksTo fbo-be:EvacuationPath,
        fbo-be:hasInternalStair .

ex:Member_4_4_1_1_1_6 a fro:Member ;
    fro:hasForwardReference ex:Section_5_2 ;
    fro:hasOriginalText "De bepalingen van dit punt zijn niet van toepassing op parkings (zie 5.2)."@nl ;
    fro:linksTo fbo-be:Parking .

ex:Member_4_4_1_2_1_1 a fro:Member ;
    fro:hasOriginalText "-    een binnentrappenhuis conform het punt 4.2;"@nl ;
    fro:linksTo fbo-be:EnclosedInternalStairCase,
        fbo-be:hasInternalStair .

ex:Member_4_4_1_2_1_10 a fro:Member ;
    fro:hasOriginalText """De   evacuatie   van   lokalen   of   een   geheel   van   lokalen   met   nachtbezetting   gebeurt   via
evacuatiewegen waarvan de verticale wanden EI 30 en de deuren EI1 30 hebben."""@nl ;
    fro:linksTo fbo-be:EvacuationPath,
        fbo-be:NightOccupation,
        fbo-be:WallTypeInternal .

ex:Member_4_4_1_2_1_11 a fro:Member ;
    fro:hasOriginalText """Deze eis is niet van toepassing voor de evacuatie van deze lokalen indien deze behoren bij de
uitbating van een gebouw met een commerciële functie."""@nl ;
    fro:linksTo fbo-be:NightOccupation .

ex:Member_4_4_1_2_1_2 a fro:Member ;
    fro:hasOriginalText "-    een buitentrappenhuis conform het punt 4.3;"@nl ;
    fro:linksTo fbo-be:hasInternalStair .

ex:Member_4_4_1_2_1_3 a fro:Member ;
    fro:hasOriginalText "-    een rechtstreekse toegang tot de open lucht op een evacuatieniveau;"@nl ;
    fro:linksTo fbo-be:EvacuationLevel .

ex:Member_4_4_1_2_1_4 a fro:Member ;
    fro:hasOriginalText "-    een evacuatieweg op een evacuatieniveau waarvan de verticale binnenwanden EI 60 hebben en de deuren van de lokalen die op deze wegen uitgeven zelfsluitend of bij brand zelfsluitend zijn en EI1 30 hebben."@nl ;
    fro:linksTo fbo-be:EvacuationPath,
        fbo-be:WallTypeInternal .

ex:Member_4_4_1_2_1_5 a fro:Member ;
    fro:hasOriginalText "De in open lucht af te leggen weg speelt geen rol bij het berekenen van deze afstanden."@nl .

ex:Member_4_4_1_2_1_6 a fro:Member ;
    fro:hasOriginalText "De deuren op deze wegen mogen geen vergrendeling bezitten die de evacuatie kan belemmeren."@nl ;
    fro:linksTo fbo-be:ExitCompartment .

ex:Member_4_4_1_2_1_7 a fro:Member ;
    fro:hasOriginalText "De   eventuele   verticale   binnenwanden   van   de   evacuatiewegen   hebben   EI   30   en   de toegangsdeuren tot deze wegen EI1 30."@nl ;
    fro:linksTo fbo-be:WallTypeInternal .

ex:Member_4_4_1_2_1_8 a fro:Member ;
    fro:hasOriginalText "Deze vereiste, alsook de vereiste van punten 3.4.1 en 6.7.2.1, zijn niet van toepassing op de compartimenten met uitsluitend dagbezetting waarvan de oppervlakte geen 1250 m² bereikt."@nl ;
    fro:linksTo fbo-be:DayOccupation,
        fbo-be:FireCompartment .

ex:Member_4_4_1_2_1_9 a fro:Member ;
    fro:hasMember ex:Member_4_4_1_2_1_9_1,
        ex:Member_4_4_1_2_1_9_2,
        ex:Member_4_4_1_2_1_9_3 ;
    fro:hasOriginalText """Deze vereiste, alsook de vereiste van punten 3.4.1 en 6.7.2.1, zijn ook niet van toepassing op de
compartimenten met uitsluitend dagbezetting waarvan de oppervlakte kleiner is dan 2500 m² op
voorwaarde:"""@nl .

ex:Member_4_4_1_2_1_9_1 a fro:Member ;
    fro:hasOriginalText "-    dat deze compartimenten zijn uitgerust met een automatische blusinstallatie van het type sprinkler die is aangepast aan de aanwezige risico's;"@nl ;
    fro:linksTo fbo-be:AutomaticFireExtinguishSystem .

ex:Member_4_4_1_2_1_9_2 a fro:Member ;
    fro:hasOriginalText """-    dat het gebouw is uitgerust met een automatisch branddetectie van het type totale bewaking
     die  automatisch  een  aanduiding  van  de  brandmelding  en  de  plaats  ervan  aangeeft  en
     waarvan de detectoren aangepast zijn aan de aanwezige risico's;"""@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal .

ex:Member_4_4_1_2_1_9_3 a fro:Member ;
    fro:hasOriginalText """-    en dat de producten die gebruikt worden voor de bekleding van verticale wanden, plafonds en
     vloeren van die compartimenten voldoen aan de vereisten inzake reactie bij brand op de
     evacuatiewegen."""@nl ;
    fro:linksTo fbo-be:Ceiling,
        fbo-be:EvacuationPath,
        fbo-be:WallTypeInternal .

ex:Section_4_4_1_1 a fro:Section ;
    fro:hasArticle ex:Article_4_4_1_1_1 ;
    fro:hasID "4.4.1.1" ;
    fro:hasOriginalText "Geen enkel punt van een compartiment mag zich verder bevinden dan:"@nl .

