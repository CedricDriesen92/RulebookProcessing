@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_5_3_2 a fro:Section ;
    fro:hasArticle ex:Article_5_3_2_1,
        ex:Article_5_3_2_2 ;
    fro:hasID "5.3.2" ;
    fro:hasOriginalText "Constructie en evacuatie."@nl .

ex:Article_5_3_2_1 a fro:Article ;
    fro:hasID "A5.3.2.1" ;
    fro:hasMember ex:Member_5_3_2_1_1,
        ex:Member_5_3_2_1_2,
        ex:Member_5_3_2_1_3 ;
    fro:hasOriginalText "Constructie."@nl ;
    fro:hasVersion fro:v0_1 .

ex:Article_5_3_2_2 a fro:Article ;
    fro:hasID "A5.3.2.2" ;
    fro:hasMember ex:Member_5_3_2_2_1,
        ex:Member_5_3_2_2_2,
        ex:Member_5_3_2_2_3,
        ex:Member_5_3_2_2_4 ;
    fro:hasOriginalText "Evacuatie."@nl ;
    fro:hasVersion fro:v0_1 .

ex:Member_5_3_2_1_1 a fro:Member ;
    fro:hasOriginalText "De wanden die deze lokalen of geheel van lokalen vormen, voldoen niet alleen aan de reglementaire voorschriften die op deze ruimten van toepassing zijn, maar hebben bovendien dezelfde brandweerstand als de wanden van een compartiment."@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:FireCompartment .

ex:Member_5_3_2_1_2 a fro:Member ;
    fro:hasOriginalText "Elke doorgang in de verticale wanden is afgesloten door een zelfsluitende of bij brand zelfsluitende deur EI1 30."@nl ;
    fro:linksTo fbo:DoorExit,
        fbo:SelfClosing .

ex:Member_5_3_2_1_3 a fro:Member ;
    fro:hasForwardReference ex:Section_5_1_2,
        ex:Section_5_1_3,
        ex:Section_5_1_4 ;
    fro:hasOriginalText """Stookafdelingen
Transformatorlokalen
Lokalen voor vuilnisopslag
De specifieke voorschriften betreffende de stookafdelingen, de transformatorlokalen en de lokalen voor vuilnisopslag blijven van toepassing (cf. respectievelijk de punten 5.1.2, 5.1.3 en 5.1.4)."""@nl .

ex:Member_5_3_2_2_1 a fro:Member ;
    fro:hasMember ex:Member_5_3_2_2_1_1,
        ex:Member_5_3_2_2_1_2,
        ex:Member_5_3_2_2_1_3,
        ex:Member_5_3_2_2_1_4,
        ex:Member_5_3_2_2_1_5 ;
    fro:hasOriginalText "Op elke bouwlaag is de evacuatie als volgt geregeld:"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:EvacuationPath .

ex:Member_5_3_2_2_1_1 a fro:Member ;
    fro:hasOriginalText "- ten minste twee trappenhuizen of buitentrappen voldoen aan de voorschriften vervat in 4.2 of 4.3 en zijn vanuit ieder punt van de bouwlaag toegankelijk; de af te leggen weg naar de dichtstbijzijnde trap mag niet meer dan 45 m bedragen; de minimale nuttige breedte van deze trappen bedraagt 0,80 m;"@nl ;
    fro:linksTo fbo:UsefulWidth,
        fbo-be:InternalStair .

ex:Member_5_3_2_2_1_2 a fro:Member ;
    fro:hasOriginalText "- zoals gesteld in 2.2.2, derde lid, mag op de beschouwde bouwlaag de vereiste toegang tot één van de twee trappenhuizen vervangen worden door een rechtstreekse uitgang naar de open lucht;"@nl ;
    fro:linksTo fbo:Exit,
        fbo-be:InternalStair .

ex:Member_5_3_2_2_1_3 a fro:Member ;
    fro:hasOriginalText "- op de bouwlaag die het dichtst bij het uitritniveau ligt, mag de hellende rijweg één der trappenhuizen of buitentrappen vervangen indien de helling gemeten in haar hartlijn niet meer dan 10 % bedraagt;"@nl ;
    fro:linksTo fbo-be:InternalStair,
        fbo-be:Parking .

ex:Member_5_3_2_2_1_4 a fro:Member ;
    fro:hasOriginalText "- de beperking van de helling tot 10% geldt niet voor de compartimenten waarvan de oppervlakte gelijk of kleiner is dan 500 m², indien evacuatie via de helling mogelijk blijft;"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_5_3_2_2_1_5 a fro:Member ;
    fro:hasOriginalText "- buiten de signalisatie bepaald in 4.5 worden de evacuatiewegen, op elke bouwlaag, ook nog aangeduid op de vloer of juist erboven."@nl ;
    fro:linksTo fbo-be:EvacuationPath .

ex:Member_5_3_2_2_2 a fro:Member ;
    fro:hasMember ex:Member_5_3_2_2_2_1,
        ex:Member_5_3_2_2_2_2,
        ex:Member_5_3_2_2_2_3,
        ex:Member_5_3_2_2_2_4 ;
    fro:hasOriginalText "Eén enkele uitgang per bouwlaag (binnentrappenhuis, buitentrap, rechtstreekse uitgang naar de open lucht of hellende rijweg op de bouwlaag die het dichtst bij het uitritniveau ligt) is evenwel voldoende op voorwaarde:"@nl ;
    fro:linksTo fbo:Exit,
        fbo-be:BuildingLayer .

ex:Member_5_3_2_2_2_1 a fro:Member ;
    fro:hasOriginalText "- dat de parking zich in de hoogte uitstrekt over maximum twee bouwlagen;"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:Parking .

ex:Member_5_3_2_2_2_2 a fro:Member ;
    fro:hasOriginalText "- dat geen enkele van deze beide bouwlagen zich op meer dan twee bouwlagen boven of onder het uitritniveau voor voertuigen bevindt;"@nl .

ex:Member_5_3_2_2_2_3 a fro:Member ;
    fro:hasOriginalText "- dat geen enkel punt van de parking zich op een afstand verder dan 15 m van de toegang tot de evacuatieweg naar de uitgang bevindt;"@nl ;
    fro:linksTo fbo-be:EvacuationPath,
        fbo-be:Parking .

ex:Member_5_3_2_2_2_4 a fro:Member ;
    fro:hasOriginalText "- en dat geen enkel punt van de parking zich op een afstand verder dan 30 m van de toegang tot de uitgang bevindt."@nl .

ex:Member_5_3_2_2_3 a fro:Member ;
    fro:hasOriginalText "In de gesloten parkings met een totale oppervlakte groter dan 2500 m², moeten de maatregelen genomen worden die noodzakelijk zijn om de verspreiding van rook te voorkomen."@nl ;
    fro:linksTo fbo:SmokeAndHeatExtraction,
        fbo-be:Parking .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

