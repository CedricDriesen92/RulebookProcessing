ex:Section_6_1_4_6 a fro:Section ;
    fro:hasArticle ex:Article_6_1_4_6_1 ;
    fro:hasID "6.1.4.6" ;
    fro:hasOriginalText "Werking bij brand."@nl .

ex:Article_6_1_4_6_1 a fro:Article ;
    fro:hasID "A6.1.4.6.1" ;
    fro:hasMember ex:Member_6_1_4_6_1_1,
        ex:Member_6_1_4_6_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_1_4_6_1_1 a fro:Member ;
    fro:hasOriginalText "Wanneer de liften bij brand op het aangeduide bordes staan, moet de mogelijkheid bestaan dat de brandweer gemakkelijk kan controleren dat de liftkooien daar staan en dat niemand in de lift opgesloten is."@nl .

ex:Member_6_1_4_6_1_2 a fro:Member ;
    fro:hasOriginalText "Liften die, bij hun komst op het aangeduide bordes, met open deuren stilstaan en buiten normale werking worden gesteld, voldoen aan deze vereiste."@nl ;
    fro:linksTo fbo:DoorExit .

