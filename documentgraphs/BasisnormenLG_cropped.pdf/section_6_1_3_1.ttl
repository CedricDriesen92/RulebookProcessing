@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_1_3_1 a fro:Section ;
    fro:hasArticle ex:Article_6_1_3_1_1 ;
    fro:hasID "6.1.3.1" ;
    fro:hasOriginalText "Verluchting."@nl .

ex:Article_6_1_3_1_1 a fro:Article ;
    fro:hasID "A6.1.3.1.1" ;
    fro:hasMember ex:Member_6_1_3_1_1_1,
        ex:Member_6_1_3_1_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_1_3_1_1_1 a fro:Member ;
    fro:hasOriginalText "De schacht, de machinekamer of het geheel schacht en machinekamer worden op een natuurlijke manier verlucht via buitenluchtmonden in het bovenste gedeelte."@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction,
        fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft .

ex:Member_6_1_3_1_1_2 a fro:Member ;
    fro:hasMember ex:Member_6_1_3_1_1_2_1,
        ex:Member_6_1_3_1_1_2_2 ;
    fro:hasOriginalText "De schacht of het geheel schacht en machinekamer mogen echter verlucht worden via binnenluchtmonden op voorwaarde dat de opvatting van de lift of goederenlift voldoet aan:"@nl ;
    fro:linksTo fbo-be:SmokeAndHeatExtraction,
        fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft .

ex:Member_6_1_3_1_1_2_1 a fro:Member ;
    fro:hasOriginalText "- ofwel het geval beschreven in a) van punt 6.1.2.3;"@nl .

ex:Member_6_1_3_1_1_2_2 a fro:Member ;
    fro:hasOriginalText "- ofwel het geval beschreven in b) van punt 6.1.2.3 in zoverre dat de bouwla(a)g(en) waar de voorschriften van de punten 6.1.2.1 en 6.1.2.2 niet zijn vereist, zich boven de overige bouwlagen bevind(t)(en)."@nl ;
    fro:linksTo fbo-be:BuildingLayer .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

