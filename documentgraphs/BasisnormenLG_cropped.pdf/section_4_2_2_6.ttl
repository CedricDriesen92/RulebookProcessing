    fro:hasArticle ex:Article_4_2_2_6_1,
        ex:Article_4_2_2_6_2,
        ex:Article_4_2_2_6_3 ;
    fro:hasID "4.2.2.6" .

ex:Article_4_2_2_6_1 a fro:Article ;
    fro:hasID "A4.2.2.6.1" ;
    fro:hasMember ex:Member_4_2_2_6_1_1,
        ex:Member_4_2_2_6_1_2,
        ex:Member_4_2_2_6_1_3 ;
    fro:hasVersion fro:v0_1 .

ex:Article_4_2_2_6_2 a fro:Article ;
    fro:hasID "A4.2.2.6.2" ;
    fro:hasMember ex:Member_4_2_2_6_2_1 ;
    fro:hasVersion fro:v0_1 .

ex:Article_4_2_2_6_3 a fro:Article ;
    fro:hasID "A4.2.2.6.3" ;
    fro:hasMember ex:Member_4_2_2_6_3_1 ;
    fro:hasVersion fro:v0_1 .

ex:Member_4_2_2_6_1_1 a fro:Member ;
    fro:hasOriginalText "Bovenaan elk binnentrappenhuis zit een verluchtingsopening met een doorsnede van minimum 1 m² en die uitmondt in de open lucht."@nl ;
    fro:linksTo fbo-be:EnclosedInternalStairCase,
        fbo-be:SmokeAndHeatExtraction .

ex:Member_4_2_2_6_1_2 a fro:Member ;
    fro:hasOriginalText "Deze opening is normaal gesloten; voor het openen gebruikt men een handbediening die goed zichtbaar geplaatst is op het evacuatieniveau."@nl ;
    fro:linksTo fbo-be:EvacuationLevel .

ex:Member_4_2_2_6_1_3 a fro:Member ;
    fro:hasOriginalText "Deze eis geldt niet voor trappenhuizen tussen evacuatieniveau en ondergrondse bouwlagen."@nl ;
    fro:linksTo fbo-be:BuildingLayer .

ex:Member_4_2_2_6_2_1 a fro:Member ;
    fro:hasOriginalText "Indien trappenhuizen maximaal twee bovengrondse verdiepingen, met een oppervlakte kleiner dan of gelijk aan 300 m², met het evacuatieniveau verbinden, mag de oppervlakte van de verluchtingsopening beperkt worden tot 0,5 m²."@nl ;
    fro:linksTo fbo-be:EvacuationLevel .

ex:Member_4_2_2_6_3_1 a fro:Member ;
    fro:hasOriginalText "Indien het trappenhuis door de aanwezigheid van een duplex bovenaan het gebouw niet alle bouwlagen bedient, wordt de verluchtingsopening met het trappenhuis verbonden aan de hand van een koker waarvan de doorsnede minstens gelijk is aan de oppervlakte vereist voor de verluchtingsopening."@nl ;
    fro:linksTo fbo-be:Duplex .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
