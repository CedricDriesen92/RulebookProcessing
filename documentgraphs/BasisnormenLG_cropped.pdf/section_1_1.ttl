@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_1 fro:hasSection ex:Section_1_1 .

ex:Article_1_1_1 a fro:Article ;
    fro:hasID "A1.1.1" ;
    fro:hasMember ex:Member_1_1_1_1,
        ex:Member_1_1_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_1_1_1_1 a fro:Member ;
    fro:hasOriginalText "Voor de gebouwen met één bouwlaag moeten de voertuigen van de brandweer ten minste tot op 60 m van een gevel van het gebouw kunnen naderen."@nl ;
    fro:linksTo fbo-be:Building,
        fbo-be:BuildingLayer,
        fbo-be:WallTypeExternal .

ex:Member_1_1_1_2 a fro:Member ;
    fro:hasOriginalText "Voor de gebouwen met meer dan één bouwlaag moeten de voertuigen van de brandweer ten minste in één punt een gevel kunnen bereiken die op herkenbare plaatsen toegang geeft tot"@nl ;
    fro:linksTo fbo-be:Building,
        fbo-be:BuildingLayer,
        fbo-be:WallTypeExternal .

ex:Section_1_1 a fro:Section ;
    fro:hasArticle ex:Article_1_1_1 ;
    fro:hasID "1.1" ;
    fro:hasOriginalText "Bereikbaarheid en opstelmogelijkheden brandweer"@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

