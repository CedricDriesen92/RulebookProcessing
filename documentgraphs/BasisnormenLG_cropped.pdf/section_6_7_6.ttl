@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_7_6 a fro:Section ;
    fro:hasArticle ex:Article_6_7_6_1 ;
    fro:hasID "6.7.6" ;
    fro:hasOriginalText "Bediening bij brand van de aëraulische installaties"@nl .

ex:Article_6_7_6_1 a fro:Article ;
    fro:hasID "A6.7.6.1" ;
    fro:hasMember ex:Member_6_7_6_1_1,
        ex:Member_6_7_6_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_7_6_1_1 a fro:Member ;
    fro:hasOriginalText "In de zones van het gebouw, die uitgerust zijn met een branddetectie-installatie, worden de luchtbehandelingsgroepen die enkel het geteisterde compartiment bedienen, stilgelegd bij detectie van brand."@nl ;
    fro:linksTo fbo-be:AutomaticDetectionTotal,
        fbo-be:FireCompartment .

ex:Member_6_7_6_1_2 a fro:Member ;
    fro:hasOriginalText "De plaatsing van een centraal brandbedieningsbord om bepaalde elementen uit de aëraulische installaties te bedienen, kan in bijzondere gevallen door de bevoegde brandweerdienst opgelegd worden. In dit geval wordt dit bord geplaatst op een punt dat gemakkelijk bereikbaar is voor de brandweer en dat gelegen is op het gebruikelijke toegangsniveau."@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

