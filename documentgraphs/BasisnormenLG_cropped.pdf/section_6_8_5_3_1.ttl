@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_8_5_3_1 a fro:Section ;
    fro:hasArticle ex:Article_6_8_5_3_1_1 ;
    fro:hasID "6.8.5.3.1" .

ex:Article_6_8_5_3_1_1 a fro:Article ;
    fro:hasID "A6.8.5.3.1.1" ;
    fro:hasMember ex:Member_6_8_5_3_1_1_1,
        ex:Member_6_8_5_3_1_1_2,
        ex:Member_6_8_5_3_1_1_3,
        ex:Member_6_8_5_3_1_1_4 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_8_5_3_1_1_1 a fro:Member ;
    fro:hasOriginalText "Het aantal en de plaats van deze toestellen worden bepaald door de aard en de omvang van het brandgevaar."@nl ;
    fro:linksTo fbo:FireHazardSpecial .

ex:Member_6_8_5_3_1_1_2 a fro:Member ;
    fro:hasOriginalText "Indien de oppervlakte van een gebouw kleiner is dan 500 m² is geen muurhaspel verplicht (behoudens bij speciale risico’s). In alle andere gevallen wordt het aantal muurhaspels als volgt bepaald:"@nl ;
    fro:linksTo fbo:FireHazardSpecial,
        fbo:HoseReel,
        fbo-be:AreaFireCompartment .

ex:Member_6_8_5_3_1_1_3 a fro:Member ;
    fro:hasMember ex:Member_6_8_5_3_1_1_3_1,
        ex:Member_6_8_5_3_1_1_3_2 .

ex:Member_6_8_5_3_1_1_3_1 a fro:Member ;
    fro:hasOriginalText "1. de waterstraal bereikt elk punt van een compartiment;"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_6_8_5_3_1_1_3_2 a fro:Member ;
    fro:hasOriginalText "2. compartimenten groter dan 500 m² beschikken over ten minste 1 muurhaspel."@nl ;
    fro:linksTo fbo:HoseReel,
        fbo-be:FireCompartment .

ex:Member_6_8_5_3_1_1_4 a fro:Member ;
    fro:hasOriginalText "Het perskoppelstuk van de eventuele muurhydranten is aangepast aan de koppelingen gebruikt door de brandweer."@nl ;
    fro:linksTo fbo:HoseReel .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

