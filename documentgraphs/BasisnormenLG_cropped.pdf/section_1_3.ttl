@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_1 fro:hasSection ex:Section_1_3 .

ex:Article_1_3_1 a fro:Article ;
    fro:hasID "A1.3.1" ;
    fro:hasMember ex:Member_1_3_1_1,
        ex:Member_1_3_1_2,
        ex:Member_1_3_1_3 ;
    fro:hasOriginalText "Om te vermijden dat een brand tussen twee gebouwen kan overslaan:"@nl ;
    fro:hasVersion fro:v0_1 .

ex:Member_1_3_1_1 a fro:Member ;
    fro:hasOriginalText "a) ofwel, als gevels tegenover elkaar staan of een inspringende tweevlakshoek vormen, dan bedraagt de afstand (in m) tussen de geveldelen die niet minstens EI 60 of REI 60 hebben, ten minste:"@nl ;
    fro:hasTable fro:Table_2_1 ;
    fro:linksTo fbo:FireResistance,
        fbo-be:Building,
        fbo-be:WallTypeExternal .

ex:Member_1_3_1_2 a fro:Member ;
    fro:hasFigure fro:Figure_2_1 ;
    fro:hasOriginalText "waarbij α de ingesloten hoek is en h de hoogte van het gebouw in m (zie plaat 2.1)."@nl ;
    fro:linksTo fbo-be:HeightBuilding .

ex:Member_1_3_1_3 a fro:Member ;
    fro:hasOriginalText "Voor de gebouwen waarvoor de aanvraag voor de bouw werd ingediend voor 1 juli 2022, is"@nl .

ex:Section_1_3 a fro:Section ;
    fro:hasArticle ex:Article_1_3_1 ;
    fro:hasID "1.3" ;
    fro:hasOriginalText "Horizontale afstand tussen gebouwen"@nl .

fro:Figure_2_1 a fro:Figure ;
    fro:hasID "F2.1" ;
    fro:hasOriginalText "Plaat 2.1"@nl .

fro:Table_2_1 a fro:Table ;
    fro:hasID "T2.1" ;
    fro:hasOriginalText """|Hoek (α)|Afstand (m)|
|---|---|
|0° ≤ α ≤ 90°|h + 10cos α|
|90° < α ≤ 180°|0|"""@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

