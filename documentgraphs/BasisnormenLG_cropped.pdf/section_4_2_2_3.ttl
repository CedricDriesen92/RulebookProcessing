ex:Section_4_2_2_3 fro:hasArticle ex:Article_4_2_2_3_1 .

ex:Article_4_2_2_3_1 a fro:Article ;
    fro:hasID "A4.2.2.3.1" ;
    fro:hasMember ex:Member_4_2_2_3_1_1,
        ex:Member_4_2_2_3_1_2 ;
    fro:hasVersion fro:v0_1 .

ex:Member_4_2_2_3_1_1 a fro:Member ;
    fro:hasMember ex:Member_4_2_2_3_1_1_1,
        ex:Member_4_2_2_3_1_1_2 ;
    fro:hasOriginalText "Een rechtstreekse verbinding van elke bouwlaag van een duplex met het trappenhuis is niet vereist, op voorwaarde dat:"@nl ;
    fro:linksTo fbo-be:Duplex .

ex:Member_4_2_2_3_1_1_1 a fro:Member ;
    fro:hasOriginalText "- de totale oppervlakte van het duplexcompartiment of het duplexappartement kleiner is dan of gelijk is aan 300 m²;"@nl ;
    fro:linksTo fbo-be:AreaDuplex,
        fbo-be:AreaFireCompartment .

ex:Member_4_2_2_3_1_1_2 a fro:Member ;
    fro:hasOriginalText "- de oppervlakte van de bouwlaag van de duplex die niet rechtstreeks evacueert via het trappenhuis, kleiner is dan of gelijk is aan 150 m²."@nl ;
    fro:linksTo fbo-be:BuildingLayer .

ex:Member_4_2_2_3_1_2 a fro:Member ;
    fro:hasMember ex:Member_4_2_2_3_1_2_1,
        ex:Member_4_2_2_3_1_2_2 ;
    fro:hasOriginalText "De rechtstreekse verbinding van elke bouwlaag van een triplex met het trappenhuis is niet vereist, op voorwaarde dat:"@nl ;
    fro:linksTo fbo-be:Triplex .

ex:Member_4_2_2_3_1_2_1 a fro:Member ;
    fro:hasOriginalText "- de oppervlakte van elke bouwlaag van de triplex die niet rechtstreeks evacueert via het trappenhuis, kleiner is dan of gelijk is aan 100 m²;"@nl ;
    fro:linksTo fbo-be:AreaTriplex .

ex:Member_4_2_2_3_1_2_2 a fro:Member ;
    fro:hasOriginalText "- de verbinding met de triplex minstens gebeurt:"@nl .

