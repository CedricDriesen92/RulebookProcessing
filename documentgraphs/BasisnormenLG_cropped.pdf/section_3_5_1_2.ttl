@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_3_5_1_2 a fro:Section ;
    fro:hasArticle ex:Article_3_5_1_2_1 ;
    fro:hasID "3.5.1.2" ;
    fro:hasOriginalText "Tegenover elkaar staande gevels en gevels die een tweevlakshoek vormen"@nl .

ex:Article_3_5_1_2_1 a fro:Article ;
    fro:hasFigure fro:Figure_2_2 ;
    fro:hasID "A3.5.1.2.1" ;
    fro:hasMember ex:Member_3_5_1_2_1_1,
        ex:Member_3_5_1_2_1_2 ;
    fro:hasOriginalText "Om te vermijden dat een brand tussen twee compartimenten kan overslaan:"@nl ;
    fro:hasVersion fro:v0_1 ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_3_5_1_2_1_1 a fro:Member ;
    fro:hasOriginalText """a) ofwel, als gevels tegenover elkaar staan of een inspringende tweevlakshoek vormen, dan bedraagt de afstand (in m) tussen de geveldelen die niet minstens E 30 of E 30 (o→i) hebben, ten minste:
- h + 10cos α voor 0° ≤ α ≤ 90°
- 2,5
- 0 voor 90° < α ≤ 180°
waarbij α de ingesloten hoek is en h de hoogte van het gebouw in m (zie plaat 2.2)."""@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:HeightBuilding,
        fbo-be:WallTypeExternal .

ex:Member_3_5_1_2_1_2 a fro:Member ;
    fro:hasOriginalText "b) ofwel mag de straling van een brand tussen gevels behorende tot verschillende compartimenten niet meer dan 15 kW/m² bedragen."@nl ;
    fro:linksTo fbo-be:FireCompartment,
        fbo-be:WallTypeExternal .

fro:Figure_2_2 a fro:Figure ;
    fro:hasID "F2.2" ;
    fro:hasOriginalText "Plaat 2.2 - Gevels tussen compartimenten"@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

