@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_2_2 fro:hasSection ex:Section_2_2_1 .

ex:Article_2_2_1_1 a fro:Article ;
    fro:hasID "A2.2.1.1" ;
    fro:hasMember ex:Member_2_2_1_1_1,
        ex:Member_2_2_1_1_2,
        ex:Member_2_2_1_1_3 ;
    fro:hasVersion fro:v0_1 .

ex:Member_2_2_1_1_1 a fro:Member ;
    fro:hasMember ex:Member_2_2_1_1_1_1,
        ex:Member_2_2_1_1_1_2,
        ex:Member_2_2_1_1_1_3 ;
    fro:hasOriginalText "Elk compartiment heeft minimum:"@nl ;
    fro:linksTo fbo-be:FireCompartment .

ex:Member_2_2_1_1_1_1 a fro:Member ;
    fro:hasOriginalText "één uitgang indien de maximale bezetting minder dan 100 personen bedraagt;"@nl ;
    fro:linksTo fbo:Exit,
        fbo:NumberOccupants .

ex:Member_2_2_1_1_1_2 a fro:Member ;
    fro:hasOriginalText "twee uitgangen indien de bezetting 100 of meer dan 100 en minder  dan 500 personen bedraagt;"@nl ;
    fro:linksTo fbo:Exit,
        fbo:NumberOccupants .

ex:Member_2_2_1_1_1_3 a fro:Member ;
    fro:hasOriginalText "2 + n uitgangen waarbij n het geheel getal is onmiddellijk groter dan het quotiënt van de deling door 1000 van de maximale bezetting van het compartiment, indien de bezetting 500 of meer dan 500 personen bedraagt."@nl ;
    fro:linksTo fbo:Exit,
        fbo:NumberOccupants .

ex:Member_2_2_1_1_2 a fro:Member ;
    fro:hasOriginalText "Het  minimum  aantal  uitgangen  kan  door  de  brandweer  verhoogd  worden  in  functie  van  de bezetting en de configuratie van de lokalen."@nl ;
    fro:linksTo fbo:Exit,
        fbo:NumberOccupants,
        fbo:Roomfunction .

ex:Member_2_2_1_1_3 a fro:Member ;
    fro:hasOriginalText "Het aantal uitgangen van bouwlagen en lokalen wordt bepaald zoals voor de compartimenten."@nl ;
    fro:linksTo fbo:Exit,
        fbo:Roomfunction,
        fbo-be:BuildingLayer,
        fbo-be:FireCompartment .

ex:Section_2_2_1 a fro:Section ;
    fro:hasArticle ex:Article_2_2_1_1 ;
    fro:hasID "2.2.1" ;
    fro:hasOriginalText "Aantal uitgangen."@nl .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

