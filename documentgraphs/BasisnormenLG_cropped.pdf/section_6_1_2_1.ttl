@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_1_2_1 a fro:Section ;
    fro:hasArticle ex:Article_6_1_2_1_1 ;
    fro:hasID "6.1.2.1" .

ex:Article_6_1_2_1_1 a fro:Article ;
    fro:hasID "A6.1.2.1.1" ;
    fro:hasMember ex:Member_6_1_2_1_1_1,
        ex:Member_6_1_2_1_1_2,
        ex:Member_6_1_2_1_1_3,
        ex:Member_6_1_2_1_1_4,
        ex:Member_6_1_2_1_1_7 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_1_2_1_1_1 a fro:Member ;
    fro:hasOriginalText "Het geheel bestaande uit één of meer schachten en de eventuele machinekamer, alsook toegangsbordessen die een sas moeten vormen voor de ondergrondse bouwlagen, is omsloten door wanden met EI 60."@nl ;
    fro:linksTo fbo:FireResistance,
        fbo-be:BuildingLayer,
        fbo-be:TechnicalRoom,
        fbo-be:VerticalShaft,
        fbo-be:WallTypeInternal .

ex:Member_6_1_2_1_1_2 a fro:Member ;
    fro:hasOriginalText "Hun buitenwanden mogen beglaasd zijn indien deze beantwoorden aan de eisen gesteld in punt 3.5."@nl ;
    fro:linksTo fbo-be:WallTypeExternal .

ex:Member_6_1_2_1_1_3 a fro:Member ;
    fro:hasOriginalText "De toegangsdeuren tussen het compartiment en het sas hebben EI1 30 en zijn zelfsluitend of zelfsluitend bij brand."@nl ;
    fro:linksTo fbo:DoorExit,
        fbo:FireResistance,
        fbo:SelfClosing,
        fbo-be:FireCompartment .

ex:Member_6_1_2_1_1_4 a fro:Member ;
    fro:hasMember ex:Member_6_1_2_1_1_4_1,
        ex:Member_6_1_2_1_1_4_2 ;
    fro:hasOriginalText "Als de oppervlakte van het sas kleiner is dan de oppervlakte van de kooi van de lift of goederenlift, is de toegangsdeur tussen het compartiment en het sas, een bij brand zelfsluitend draaideur EI1 30 bediend door een branddetectie-installatie die minstens het volgende omvat:"@nl ;
    fro:linksTo fbo:DoorExit,
        fbo:FireSafetyInstallationSmokeAlarmsystem,
        fbo:SelfClosing,
        fbo-be:FireCompartment .

ex:Member_6_1_2_1_1_4_1 a fro:Member ;
    fro:hasOriginalText "- een rookdetectie in de schacht;"@nl ;
    fro:linksTo fbo:FireSafetyInstallationSmokeAlarmsystem,
        fbo-be:VerticalShaft .

ex:Member_6_1_2_1_1_4_2 a fro:Member ;
    fro:hasOriginalText "- en een rookdetectie in het compartiment in de omgeving van de toegangsdeur tot het sas."@nl ;
    fro:linksTo fbo:FireSafetyInstallationSmokeAlarmsystem,
        fbo-be:FireCompartment .

ex:Member_6_1_2_1_1_7 a fro:Member ;
    fro:hasOriginalText "Het toegangsbordes mag deel uitmaken van de evacuatieweg."@nl ;
    fro:linksTo fbo-be:EvacuationPath .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

