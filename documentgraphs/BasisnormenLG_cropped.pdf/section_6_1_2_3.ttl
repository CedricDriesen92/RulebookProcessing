@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_1_2 fro:hasSection ex:Section_6_1_2_3 .

ex:Article_6_1_2_3_1 a fro:Article ;
    fro:hasBackwardReference ex:Section_6_1_2_1,
        ex:Section_6_1_2_2 ;
    fro:hasID "A6.1.2.3.1" ;
    fro:hasMember ex:Member_6_1_2_3_1_1,
        ex:Member_6_1_2_3_1_2,
        ex:Member_6_1_2_3_1_3 ;
    fro:hasOriginalText "De voorschriften van de punten 6.1.2.1 en 6.1.2.2 zijn niet vereist in de volgende gevallen:"@nl ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_1_2_3_1_1 a fro:Member ;
    fro:hasOriginalText "1. op alle bouwlagen bediend door de lift of goederenlift, indien deze lift of goederenlift de bouwlagen van slechts één compartiment bestaande uit meerdere bouwlagen bedient;"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:FireCompartment .

ex:Member_6_1_2_3_1_2 a fro:Member ;
    fro:hasBackwardReference ex:Section_6_1_2_1,
        ex:Section_6_1_2_2 ;
    fro:hasOriginalText "2. op de bouwla(a)g(en) van slechts één van de compartimenten bediend door de lift of goederenlift, op voorwaarde dat dit compartiment geen parkeercompartiment of een appartement is, en dat de opvatting van deze lift of goederenlift op de overige bouwlagen wel voldoet aan de voorschriften van de punten 6.1.2.1 en 6.1.2.2 of aan punt c) hieronder;"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:FireCompartment,
        fbo-be:Parking .

ex:Member_6_1_2_3_1_3 a fro:Member ;
    fro:hasOriginalText "3. op de bouwla(a)g(en) waar de lift of goederenlift rechtstreeks in de buitenlucht uitgeeft, op voorwaarde dat de opvatting van deze lift of goederenlift op de overige bouwlagen wel voldoet."@nl ;
    fro:linksTo fbo-be:BuildingLayer .

ex:Section_6_1_2_3 a fro:Section ;
    fro:hasArticle ex:Article_6_1_2_3_1 ;
    fro:hasID "6.1.2.3" .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

