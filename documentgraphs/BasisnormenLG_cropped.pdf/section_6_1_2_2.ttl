@base <https://ontology.firebim.be/ontology/fro> .
@prefix ex: <https://example.org/rulebook#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Section_6_1_2_2 a fro:Section ;
    fro:hasArticle ex:Article_6_1_2_2_1 ;
    fro:hasID "6.1.2.2" ;
    fro:hasOriginalText "Schachtdeuren."@nl .

ex:Article_6_1_2_2_1 a fro:Article ;
    fro:hasID "A6.1.2.2.1" ;
    fro:hasMember ex:Member_6_1_2_2_1_1,
        ex:Member_6_1_2_2_1_2,
        ex:Member_6_1_2_2_1_3 ;
    fro:hasVersion fro:v0_1 .

ex:Member_6_1_2_2_1_1 a fro:Member ;
    fro:hasOriginalText "Het geheel van de schachtdeuren van de lift of goederenlift heeft E 30. De brandwerendheid volgens de norm NBN EN 81-58, waarbij de bordeswand aan de kant van het bordes aan het vuur blootgesteld wordt. De bordeswand zal beproefd worden met de eventuele bedienings- en controleorganen die daarvan deel uitmaken."@nl ;
    fro:linksTo fbo:FireResistance .

ex:Member_6_1_2_2_1_2 a fro:Member ;
    fro:hasOriginalText "De volgens andere methodes geteste schachtdeuren worden aanvaard overeenkomstig het koninklijk besluit van 12 april 2016 betreffende het op de markt brengen van liften en veiligheidscomponenten voor liften, op voorwaarde dat ze ten minste dezelfde graad van brandweerstand hebben."@nl ;
    fro:linksTo fbo:FireResistance .

ex:Member_6_1_2_2_1_3 a fro:Member ;
    fro:hasMember ex:Member_6_1_2_2_1_3_1,
        ex:Member_6_1_2_2_1_3_2 ;
    fro:hasOriginalText "Deze vereisten zijn niet van toepassing wanneer de lift(en) worden opgesteld in een trappenhuis dat de bouwlagen boven een evacuatieniveau bedient, op voorwaarde:"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:EnclosedInternalStairCase,
        fbo-be:EvacuationLevel .

ex:Member_6_1_2_2_1_3_1 a fro:Member ;
    fro:hasOriginalText "- dat op alle bouwlagen bediend door dit trappenhuis met lift(en), in elke compartiment, de verbinding naar dit trappenhuis met lift(en) via evacuatiewegen gaat;"@nl ;
    fro:linksTo fbo-be:BuildingLayer,
        fbo-be:EnclosedInternalStairCase,
        fbo-be:EvacuationPath,
        fbo-be:FireCompartment .

ex:Member_6_1_2_2_1_3_2 a fro:Member ;
    fro:hasOriginalText "- en dat op alle bouwlagen bediend door dit trappenhuis met lift(en), de verbinding tussen deze evacuatieweg en dit trappenhuis met lift(en) verzekerd wordt door een zelfsluitende of bij brand zelfsluitende deur met EI1 30 die toegang geeft tot een overloop in dit trappenhuis met lift(en)."@nl ;
    fro:linksTo fbo:SelfClosing,
        fbo-be:BuildingLayer,
        fbo-be:EnclosedInternalStairCase,
        fbo-be:EvacuationPath .

fro:v0_1 a fro:Version ;
    fro:hasDate "2026-04-20T13:00:27.442218"^^xsd:dateTime ;
    fro:hasDescription "Version 0.1 of the document" ;
    fro:hasVersionNumber "0.1" .

