@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fro: <http://www.firebim.org/ontologies/fro#> .
@prefix fbo: <https://ontology.firebim.be/ontology/fbo#> .
@prefix fbo-be: <https://ontology.firebim.be/ontology/fbo-BE#> .
@prefix ex: <http://example.org/ontology#> .

fro:Shape_Article_2_1_1 a sh:NodeShape ;
    sh:targetClass fbo:FireCompartment ;
    sh:description "Regels inzake de maximale oppervlakte en lengte van brandcompartimenten, inclusief uitzonderingen voor parkings, actieve blus/RWA installaties en ministeriële afwijkingen." ;
    sh:or (
        # Condition 1: Exemption for parking areas
        [
            sh:property [
                sh:path fbo:Roomfunction ;
                sh:hasValue "Parking" ;
                sh:message "met uitzondering van de parkings (zie 5.2)." ;
            ]
        ]
        
        # Condition 2: Area can be larger if equipped with both an automatic extinguishing system AND a smoke and heat exhaust system
        [
            sh:and (
                [
                    sh:property [
                        sh:path fbo:hasSubitem ;
                        sh:qualifiedValueShape [ sh:class fbo:AutomaticFireExtinguishSystem ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "indien het compartiment is uitgerust met een automatische blusinstallatie" ;
                    ]
                ]
                [
                    sh:property [
                        sh:path fbo:hasSubitem ;
                        sh:qualifiedValueShape [ sh:class fbo:AutomaticFireVentilationsystem ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "en een rook- en warmteafvoerinstallatie." ;
                    ]
                ]
            )
        ]
        
        # Condition 3: Ministerial exception conditions met without needing active systems
        [
            sh:property [
                sh:path fbo:hasFireExpertValidation ;
                sh:hasValue true ;
                sh:message "De Minister van Binnenlandse Zaken bepaalt de voorwaarden waaronder uitzonderingen mogelijk zijn op de grootte van het compartiment [...] zonder dat een automatische blusinstallatie en/of een rook- en warmteafvoerinstallatie moet voorzien worden." ;
            ]
        ]
        
        # Condition 4: Baseline area and length limits based on building type
        [
            sh:or (
                # Sub-condition 4a: Single-story building consisting of 1 compartment
                [
                    sh:and (
                        [
                            sh:property [
                                sh:path [ sh:inversePath fbo:hasSubitem ] ;
                                sh:node [
                                    a sh:NodeShape ;
                                    sh:property [
                                        sh:path fbo:BuildingLayers ;
                                        sh:maxInclusive 1 ;
                                        sh:message "gelijkvloers gebouw" ;
                                    ] ;
                                    sh:property [
                                        sh:path fbo:hasSubitem ;
                                        sh:maxCount 1 ;
                                        sh:message "bestaande uit één compartiment" ;
                                    ]
                                ] ;
                                sh:message "Het compartiment moet deel uitmaken van een gelijkvloers gebouw dat uit slechts één compartiment bestaat." ;
                            ]
                        ]
                        [
                            sh:property [
                                sh:path fbo:AreaFireCompartment ;
                                sh:maxInclusive 3500.0 ;
                                sh:datatype xsd:decimal ;
                                sh:message "De maximale oppervlakte van een gelijkvloers gebouw bestaande uit één compartiment mag 3500 m² bedragen." ;
                            ]
                        ]
                        [
                            sh:property [
                                sh:path ex:compartmentLength ; # NOTE: no ontology term found
                                sh:maxInclusive 90.0 ;
                                sh:datatype xsd:decimal ;
                                sh:message "De lengte van dit compartiment bedraagt niet meer dan 90 m." ;
                            ]
                        ]
                    )
                ]
                
                # Sub-condition 4b: Default rule for compartments (area < 2500 m²)
                [
                    sh:property [
                        sh:path fbo:AreaFireCompartment ;
                        sh:maxExclusive 2500.0 ;
                        sh:datatype xsd:decimal ;
                        sh:message "Het gebouw is verdeeld in compartimenten waarvan de oppervlakte kleiner is dan 2500 m²" ;
                    ]
                ]
            )
        ]
    ) .