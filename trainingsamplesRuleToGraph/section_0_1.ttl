@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix ex: <https://example.org/rulebook#> .
@base <https://ontology.firebim.be/ontology/fro> .

ex:Section_0_1 a fro:Section ;
    fro:hasID "0.1" ;
    fro:hasOriginalText "Doel."@nl ;
    fro:hasArticle ex:Article_0_1_1 .

ex:Article_0_1_1 a fro:Article ;
    fro:hasID "A0.1.1" ;
    fro:hasOriginalText """Deze basisreglementering bepaalt de minimale eisen waaraan de opvatting, de bouw en de
inrichting van lage gebouwen (LG) moeten voldoen om:"""@nl ;
    fro:hasMember ex:Member_0_1_1_1, ex:Member_0_1_1_2, ex:Member_0_1_1_3 .

ex:Member_0_1_1_1 a fro:Member ;
    fro:hasOriginalText "het ontstaan, de ontwikkeling en de voortplanting van brand te voorkomen;"@nl .

ex:Member_0_1_1_2 a fro:Member ;
    fro:hasOriginalText "de veiligheid van de aanwezigen te waarborgen;"@nl .

ex:Member_0_1_1_3 a fro:Member ;
    fro:hasOriginalText "preventief het ingrijpen van de brandweer te vergemakkelijken."@nl .