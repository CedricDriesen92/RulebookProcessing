@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fro: <https://ontology.firebim.be/ontology/fro#> .
@prefix ex: <https://example.org/rulebook#> .
@base <https://ontology.firebim.be/ontology/fro> .

ex:Section_0_2_2 a fro:Section ;
    fro:hasID "0.2.2" ;
    fro:hasArticle ex:Article_0_2_2_1 .

ex:Article_0_2_2_1 a fro:Article ;
    fro:hasID "A0.2.2.1" ;
    fro:hasOriginalText """Uitgesloten van het toepassingsgebied van deze bijlage zijn echter:"""@nl ;
    fro:hasMember ex:Member_0_2_2_1_1, ex:Member_0_2_2_1_2, ex:Member_0_2_2_1_3 .

ex:Member_0_2_2_1_1 a fro:Member ;
    fro:hasOriginalText "1.   de industriegebouwen;"@nl .

ex:Member_0_2_2_1_2 a fro:Member ;
    fro:hasOriginalText """2.   de gebouwen bestaande uit maximaal twee bouwlagen en met een totale oppervlakte kleiner
                 dan of gelijk aan 100 m²;"""@nl .

ex:Member_0_2_2_1_3 a fro:Member ;
    fro:hasOriginalText "3.   de eengezinswoningen."@nl .

ex:Section_0_2 fro:hasSection ex:Section_0_2_2 .